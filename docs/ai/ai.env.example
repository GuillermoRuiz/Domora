# Documentation only; use existing deployment secret management.
AI_ENABLED=false
AI_WORKER_ENABLED=false
AI_AUTO_RECONCILE=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_VISION_MODEL=
PDFTOTEXT_PATH=
# Optional: limit the job kinds this worker processes.
AI_WORKER_KINDS=
# Optional endpoint/project (EU residency needs the EU host of the project; verify with OpenAI).
OPENAI_BASE_URL=
OPENAI_PROJECT_ID=
OPENAI_ORGANIZATION_ID=
# none (default) | eu. With eu and no EU endpoint+project the AI features are unavailable (fail closed).
AI_REQUIRE_REGION=none
# Retention (hours; 0 = purge immediately). Business decision pending for anything beyond these two.
AI_BATCH_FILE_RETENTION_HOURS=0
AI_REQUEST_PAYLOAD_RETENTION_HOURS=0
# Development / test: 24 h. The model output (ai_requests.result) is emptied once it is materialised in its entity.
# PRODUCTION: leave UNSET until the retention period is documented (legal/product decision). Unset = never purged.
AI_REQUEST_RESULT_RETENTION_HOURS=24
# Worker heartbeat (which job kinds have a live worker).
AI_WORKER_HEARTBEAT_SECONDS=30
AI_WORKER_HEARTBEAT_STALE_SECONDS=150
# Incident workflow safety nets (manual module: the sweep opens human tasks).
ISSUE_STALLED_GRACE_MINUTES=240
ISSUE_SWEEP_ENABLED=true
# Reuse existing DATABASE_URL, STORAGE_DIR, SMTP_*.
