// ═══════════════════════════════════════════════════════════════════════
// ── 14. Agenda de tareas de la gestora ──────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════
//
// Tareas PLANIFICADAS (con fecha y responsable) de la gestora. No confundir
// con `TasksService` (notifications/), que deriva al vuelo una lista de
// trabajo pendiente (solicitudes sin resolver, inspecciones vencidas…) y no
// persiste nada: esta es la agenda propia del administrador.
//
// El tenant es `Administrator` (`administratorId`); `estateId` es opcional
// (una tarea puede no ser de ninguna comunidad). "Vencida" NO se almacena:
// se calcula (`endAt < now` y estado no terminal). La recurrencia es una
// sola fila (frecuencia + intervalo + hasta) que se expande al consultar un
// rango; solo las ocurrencias resueltas individualmente guardan una fila en
// `agenda_task_occurrences`.

enum AgendaTaskType {
  SEGUIMIENTO
  CORREO
  COMUNICACION
  LLAMADA
  JUNTA
  PRESUPUESTO
  INCIDENCIA
  DOCUMENTACION
  COBRO_PAGO
  VISITA
  MANTENIMIENTO
  PROVEEDOR
  CONTABILIDAD
  CONTRATO
  SEGURO
  LEGAL
  ADMINISTRATIVA
  OTRA
}

enum AgendaTaskPriority {
  URGENTE
  ALTA
  MEDIA
  BAJA
}

enum AgendaTaskStatus {
  PENDIENTE
  EN_CURSO
  EN_ESPERA
  COMPLETADA
  CANCELADA
}

enum AgendaRecurrenceFreq {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

/// Entidades de Domora a las que se puede vincular una tarea. Sin FK
/// declarativa (relación polimórfica): la existencia y el acceso a la finca
/// se validan en `AgendaTasksService`.
enum AgendaLinkType {
  issue
  meeting
  supplier
  document
}

model AgendaTask {
  id                     String                @id @default(uuid()) @db.Uuid
  administratorId        String                @map("administrator_id") @db.Uuid
  estateId               String?               @map("estate_id") @db.Uuid
  title                  String                @db.VarChar(200)
  description            String?
  assignedToUserId       String?               @map("assigned_to_user_id") @db.Uuid
  createdByUserId        String?               @map("created_by_user_id") @db.Uuid
  type                   AgendaTaskType        @default(OTRA)
  priority               AgendaTaskPriority    @default(MEDIA)
  status                 AgendaTaskStatus      @default(PENDIENTE)
  /// Estado que tenía antes de completarse: al desmarcarla vuelve a él en lugar de a PENDIENTE.
  statusBeforeCompletion AgendaTaskStatus?     @map("status_before_completion")
  /// Tareas de día completo: `startAt`/`endAt` son medianoches UTC del día
  /// (fin exclusivo); el resto, instantes reales.
  startAt                DateTime              @map("start_at") @db.Timestamptz
  endAt                  DateTime              @map("end_at") @db.Timestamptz
  allDay                 Boolean               @default(false) @map("all_day")
  /// Sin duración: solo cuenta la fecha de inicio. El calendario la pinta como una nota del día (sticky), no como un bloque.
  /// `startAt`/`endAt` siguen siendo válidos (un bloque nominal), así que consultas y plazos no cambian.
  noDuration             Boolean               @default(false) @map("no_duration")
  /// Fecha límite, independiente de CUÁNDO se hace (`startAt`/`endAt`, que son el bloque que ocupa en el calendario). Mover o
  /// reprogramar la tarea no la cambia. `null` = el límite es el fin del bloque (tareas manuales sin plazo propio y todas las
  /// anteriores a esta columna). No aplica a series.
  dueAt                  DateTime?             @map("due_at") @db.Timestamptz
  /// Zona IANA con la que se interpreta la hora local al expandir la
  /// recurrencia (conserva "las 10:00" a través del cambio de hora).
  timezone               String                @default("Europe/Madrid") @db.VarChar(60)
  /// Minutos de antelación del recordatorio (0 = en el momento); null = sin.
  reminderMinutesBefore  Int?                  @map("reminder_minutes_before")
  recurrenceFreq         AgendaRecurrenceFreq? @map("recurrence_freq")
  recurrenceInterval     Int                   @default(1) @map("recurrence_interval")
  recurrenceUntil        DateTime?             @map("recurrence_until") @db.Timestamptz
  /// Origen de la tarea: 'manual' o el identificador de una automatización
  /// futura ('issue_followup', 'meeting_convocatoria'…). Junto con
  /// `sourceRef` (p. ej. el id de la incidencia) evita duplicados.
  source                 String                @default("manual") @db.VarChar(40)
  sourceRef              String?               @map("source_ref") @db.VarChar(120)
  /// Incidencia de la que nace la tarea (solo las de decisión humana que abre Domora).
  issueId                String?               @map("issue_id") @db.Uuid
  /// Tipo de acción humana (catálogo en `issue-workflow/task-kinds`); null en las tareas manuales. Con `kind`,
  /// `payload` y `resultRef` se validan contra el esquema de ese tipo: no hay JSON libre.
  kind                   String?               @db.VarChar(60)
  payload                Json?
  /// Cómo se resolvió (approved, edited, rejected, dismissed, superseded…) y qué se ejecutó al hacerlo.
  outcome                String?               @db.VarChar(30)
  resultRef              Json?                 @map("result_ref")
  /// Quién abrió la tarea. Una tarea de decisión la abre Domora (`ai`) o una regla (`system`), no una persona.
  createdByKind          TaskCreatorKind       @default(person) @map("created_by_kind")
  completedAt            DateTime?             @map("completed_at") @db.Timestamptz
  cancelledAt            DateTime?             @map("cancelled_at") @db.Timestamptz
  /// Archivada: ya no sale en la agenda ni en los barridos, pero se conserva (decisión, resultado, comentarios, adjuntos) porque el
  /// historial de su incidencia la referencia. Hoy solo la archiva el borrado de la incidencia; es lo que permite una política de
  /// retención futura (borrado definitivo) sin romper el historial entretanto.
  archivedAt             DateTime?             @map("archived_at") @db.Timestamptz
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  administrator Administrator @relation(fields: [administratorId], references: [id], onDelete: Cascade)
  estate        Estate?       @relation(fields: [estateId], references: [id], onDelete: SetNull)
  assignedTo    User?         @relation("AgendaTaskAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdBy     User?         @relation("AgendaTaskCreatedBy", fields: [createdByUserId], references: [id])
  issue         Issue?        @relation(fields: [issueId], references: [id], onDelete: SetNull)

  labels      AgendaTaskLabelLink[]
  checklist   AgendaTaskChecklistItem[]
  comments    AgendaTaskComment[]
  attachments AgendaTaskAttachment[]
  links       AgendaTaskLink[]
  occurrences AgendaTaskOccurrence[]
  reminders   AgendaTaskReminder[]

  @@unique([administratorId, source, sourceRef])
  @@index([administratorId, startAt])
  @@index([administratorId, estateId, startAt])
  @@index([administratorId, assignedToUserId, startAt])
  @@index([administratorId, status, endAt])
  @@index([issueId, status])
  @@map("agenda_tasks")
}

/// Catálogo de etiquetas POR gestora.
model AgendaTaskLabel {
  id              String   @id @default(uuid()) @db.Uuid
  administratorId String   @map("administrator_id") @db.Uuid
  name            String   @db.VarChar(60)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  administrator Administrator         @relation(fields: [administratorId], references: [id], onDelete: Cascade)
  tasks         AgendaTaskLabelLink[]

  @@unique([administratorId, name])
  @@map("agenda_task_labels")
}

model AgendaTaskLabelLink {
  taskId  String @map("task_id") @db.Uuid
  labelId String @map("label_id") @db.Uuid

  task  AgendaTask      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label AgendaTaskLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
  @@map("agenda_task_label_links")
}

model AgendaTaskChecklistItem {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  text      String   @db.VarChar(300)
  done      Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  task AgendaTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, position])
  @@map("agenda_task_checklist_items")
}

model AgendaTaskComment {
  id           String   @id @default(uuid()) @db.Uuid
  taskId       String   @map("task_id") @db.Uuid
  authorUserId String?  @map("author_user_id") @db.Uuid
  text         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  task   AgendaTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User?      @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@map("agenda_task_comments")
}

/// Adjuntos sobre el `StorageService` compartido (mismo `s3Key` opaco).
model AgendaTaskAttachment {
  id              String   @id @default(uuid()) @db.Uuid
  taskId          String   @map("task_id") @db.Uuid
  fileName        String   @map("file_name") @db.VarChar(255)
  mimeType        String   @map("mime_type") @db.VarChar(100)
  sizeBytes       Int      @map("size_bytes")
  s3Key           String   @map("s3_key") @db.VarChar(500)
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  task      AgendaTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy User?      @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@map("agenda_task_attachments")
}

model AgendaTaskLink {
  id         String         @id @default(uuid()) @db.Uuid
  taskId     String         @map("task_id") @db.Uuid
  entityType AgendaLinkType @map("entity_type")
  entityId   String         @map("entity_id") @db.Uuid
  /// Título de la entidad al vincularla (p. ej. «INC-482 · Avería ascensor»): solo para poder mostrar el vínculo si la entidad
  /// desaparece después. Texto de presentación, nunca datos sensibles. `null` en los vínculos anteriores a esta columna.
  label      String?        @db.VarChar(200)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz

  task AgendaTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("agenda_task_links")
}

/// Resolución de UNA ocurrencia de una tarea recurrente (completada o
/// cancelada). La serie sigue siendo una sola fila en `agenda_tasks`.
model AgendaTaskOccurrence {
  taskId          String           @map("task_id") @db.Uuid
  occurrenceStart DateTime         @map("occurrence_start") @db.Timestamptz
  /// Fin que tenía la ocurrencia cuando se resolvió. Con `occurrenceStart` es el hecho histórico: editar la serie después
  /// (otro día, otra hora, otra zona…) no lo mueve. `null` en las resoluciones anteriores a esta columna: se completa con la
  /// duración que tenía la serie justo antes de editarla.
  occurrenceEnd   DateTime?        @map("occurrence_end") @db.Timestamptz
  status          AgendaTaskStatus
  resolvedAt      DateTime         @default(now()) @map("resolved_at") @db.Timestamptz

  task AgendaTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, occurrenceStart])
  @@map("agenda_task_occurrences")
}

/// Recordatorio ya emitido para UNA ocurrencia de una tarea. La clave primaria
/// (tarea, inicio de ocurrencia) es lo que hace idempotente el cron: el INSERT
/// que gana la carrera es el único que envía el aviso, entre réplicas,
/// reinicios y ediciones. Al reprogramar la tarea cambia el inicio, así que el
/// nuevo momento recibe su propio aviso.
model AgendaTaskReminder {
  taskId          String   @map("task_id") @db.Uuid
  occurrenceStart DateTime @map("occurrence_start") @db.Timestamptz
  sentAt          DateTime @default(now()) @map("sent_at") @db.Timestamptz

  task AgendaTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, occurrenceStart])
  @@index([occurrenceStart])
  @@map("agenda_task_reminders")
}

// Half-open business dates [startsAt, endsAt). Null end = no scheduled end.
// Holder/actor references are logical: immutable snapshots survive removal.
// Governance service verifies every referenced entity within the same estate.
enum EstateOfficeRole {
  PRESIDENT
  VICE_PRESIDENT
  SECRETARY
}

enum ContractCostFrequency {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  ONE_OFF
  OTHER
}

model EstateOfficeTerm {
  id                   String           @id @default(uuid()) @db.Uuid
  estateId             String           @map("estate_id") @db.Uuid
  role                 EstateOfficeRole @default(PRESIDENT)
  propertyId           String?          @map("property_id") @db.Uuid
  userId               String?          @map("user_id") @db.Uuid
  externalOwnerId      String?          @map("external_owner_id") @db.Uuid
  holderNameSnapshot   String           @map("holder_name_snapshot") @db.VarChar(200)
  startsAt             DateTime         @map("starts_at") @db.Date
  endsAt               DateTime?        @map("ends_at") @db.Date
  appointedByMeetingId String?          @map("appointed_by_meeting_id") @db.Uuid
  createdByUserId      String           @map("created_by_user_id") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Restrict)

  @@index([estateId, role, startsAt])
  @@map("estate_office_terms")
}

/// Short-lived canonical composite reports. Contents are separate from audit.
/// Logical actor/tenant IDs preserve the snapshot until its retention expires.
model ReportSnapshot {
  id              String   @id @default(uuid()) @db.Uuid
  administratorId String   @map("administrator_id") @db.Uuid
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  reportKey       String   @map("report_key") @db.VarChar(100)
  estateIds       String[] @map("estate_ids") @db.Uuid
  inputHash       String   @map("input_hash") @db.VarChar(64)
  result          Json
  generatedAt     DateTime @map("generated_at") @db.Timestamptz
  expiresAt       DateTime @map("expires_at") @db.Timestamptz

  @@index([administratorId, expiresAt])
  @@map("report_snapshots")
}

/// Hito del recorrido de una incidencia que la gestión ha tocado. Los hitos de la plantilla de la vía se calculan al leer; aquí
/// solo hay (a) hitos propios (`templateKey` nulo) y (b) ajustes sobre uno de la plantilla (renombrarlo, ocultarlo o darlo por hecho).
model IssueJourneyMilestone {
  id                String    @id @default(uuid()) @db.Uuid
  issueId           String    @map("issue_id") @db.Uuid
  templateKey       String?   @map("template_key") @db.VarChar(40)
  label             String?   @db.VarChar(120)
  /// Orden relativo (los de la plantilla valen 10, 20, 30…; uno propio se coloca entre dos).
  position          Float     @default(0)
  hidden            Boolean   @default(false)
  /// Marcado a mano; en un hito de la plantilla manda sobre lo que deduce el sistema.
  doneAt            DateTime? @map("done_at") @db.Timestamptz
  /// Estado de la incidencia que completa automáticamente este hito propio.
  linkedStatus      IssueStatus? @map("linked_status")
  createdByUserId   String?   @map("created_by_user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([issueId, templateKey])
  @@index([issueId])
  @@map("issue_journey_milestones")
}

/// Contador atómico de la referencia `#INC-AAAA-NNN`: una fila por año. Se incrementa con
/// `INSERT ... ON CONFLICT DO UPDATE ... RETURNING` dentro de la transacción del alta, así que dos altas simultáneas nunca
/// reciben el mismo número y borrar una incidencia no libera el suyo. Nunca se calcula con `COUNT(*) + 1`.
model IssueReferenceCounter {
  year      Int @id
  lastValue Int @map("last_value")

  @@map("issue_reference_counters")
}

/// Explicit support mode for Domora staff (role A) on one despacho
/// (odd/tasks/role-a-panel.md S5). Role A is read-only on tenant routes by
/// default; a write needs an active session of the caller on the target
/// despacho. No foreign keys on purpose: the audit trail must outlive the
/// staff user and the despacho.
model SupportSession {
  id              String    @id @default(uuid()) @db.Uuid
  staffUserId     String    @map("staff_user_id") @db.Uuid
  administratorId String    @map("administrator_id") @db.Uuid
  reason          String    @db.VarChar(500)
  ticketRef       String?   @map("ticket_ref") @db.VarChar(100)
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz
  endedAt         DateTime? @map("ended_at") @db.Timestamptz

  @@index([staffUserId, endedAt])
  @@map("support_sessions")
}

enum StaffAuditAction {
  read
  write
  support_start
  support_end
  denied
}

/// Accountability log of Domora staff (role A) access to client data
/// (S5: who, when, which despacho and which action). Stores the route
/// TEMPLATE only, never the concrete URL, ids or query string.
model StaffAuditLog {
  id               String           @id @default(uuid()) @db.Uuid
  staffUserId      String           @map("staff_user_id") @db.Uuid
  administratorId  String?          @map("administrator_id") @db.Uuid
  estateId         String?          @map("estate_id") @db.Uuid
  supportSessionId String?          @map("support_session_id") @db.Uuid
  action           StaffAuditAction
  method           String           @db.VarChar(10)
  route            String           @db.VarChar(300)
  occurredAt       DateTime         @default(now()) @map("occurred_at") @db.Timestamptz

  @@index([occurredAt])
  @@index([administratorId, occurredAt])
  @@index([staffUserId, occurredAt])
  @@map("staff_audit_logs")
}
