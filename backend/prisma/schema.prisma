// ═══════════════════════════════════════════════════════════════════════
// ── 1. Plataforma / Rol A ──────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════

model Administrator {
  id                        String          @id @default(uuid()) @db.Uuid
  name                      String          @db.VarChar(200)
  cif                       String          @unique @db.VarChar(20)
  vatNumber                 String?         @map("vat_number") @db.VarChar(20)
  primaryUserId             String?         @map("primary_user_id") @db.Uuid
  plan                      PlanTier
  tier                      String          @db.VarChar(20)
  endDate                   DateTime?       @map("end_date") @db.Date
  usersMax                  Int             @map("users_max")
  status                    AdminStatus
  phone                     String?         @db.VarChar(30)
  contactName               String?         @map("contact_name") @db.VarChar(150)
  contactEmail              String?         @map("contact_email") @db.VarChar(200)
  mrr                       Decimal         @default(0) @db.Decimal(10, 2)
  discountPct               Decimal         @default(0) @map("discount_pct") @db.Decimal(5, 2)
  discountReason            String?         @map("discount_reason") @db.VarChar(200)
  discountUntil             DateTime?       @map("discount_until") @db.Date
  billingInterval           BillingInterval @default(month) @map("billing_interval")
  notes                     String?
  blockReason               String?         @map("block_reason")
  /// Cuándo se sembraron las etiquetas iniciales de la agenda de tareas. Distingue
  /// "catálogo nunca inicializado" de "inicializado y luego vaciado por la gestora":
  /// lo segundo NO debe volver a sembrarse.
  agendaLabelsInitializedAt DateTime?       @map("agenda_labels_initialized_at") @db.Timestamptz
  createdAt                 DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt                 DateTime?       @map("deleted_at") @db.Timestamptz

  primaryUser User? @relation("AdministratorPrimaryUser", fields: [primaryUserId], references: [id], onDelete: SetNull)

  users               User[]                     @relation("AdministratorUsers")
  estates             Estate[]
  billing             AdminBilling?
  sepaMandates        AdminSepaMandate[]
  invoices            AdminInvoice[]
  activity            AdminActivityItem[]
  suppliers           Supplier[]
  staffMembers        StaffMember[]
  chartAccounts       ChartAccount[]
  costCentres         CostCentre[]
  teamInvites         TeamInvite[]
  subscription        AdministratorSubscription?
  importBatches       ImportBatch[]
  agendaTasks         AgendaTask[]
  agendaLabels        AgendaTaskLabel[]
  mrrSnapshots        ClientMrrSnapshot[]
  convertedFromLead   Lead?                      @relation("LeadConvertedAdministrator")
  nextAction          ClientNextAction?
  commercialFollowUps CommercialFollowUp[]

  @@index([status])
  @@index([endDate])
  @@map("administrators")
}

/// MRR de cada gestora al cierre de cada mes (el mes en curso se reescribe a
/// diario hasta que cierra). Es el histórico que no se puede reconstruir
/// después: de la diferencia entre dos meses salen los movimientos del MRR
/// (nuevo, expansión, contracción, churn, reactivación). Solo filas con MRR > 0.
model ClientMrrSnapshot {
  /// Primer día del mes.
  month           DateTime @db.Date
  administratorId String   @map("administrator_id") @db.Uuid
  mrr             Decimal  @db.Decimal(10, 2)
  capturedAt      DateTime @default(now()) @updatedAt @map("captured_at") @db.Timestamptz

  administrator Administrator @relation(fields: [administratorId], references: [id], onDelete: Cascade)

  @@id([month, administratorId])
  @@index([administratorId])
  @@map("client_mrr_snapshots")
}

/// Invitación autoservicio de un usuario rol B ya activo hacia un colega de
/// SU MISMA gestora (a diferencia de la invitación inicial de rol A, que da
/// de alta la empresa en sí). El token nunca se persiste en claro — mismo
/// patrón que RefreshToken (hash SHA-256, comparar por hash).
model TeamInvite {
  id              String    @id @default(uuid()) @db.Uuid
  administratorId String    @map("administrator_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash") @db.VarChar(64)
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz
  usedAt          DateTime? @map("used_at") @db.Timestamptz
  usedByUserId    String?   @map("used_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  administrator Administrator @relation(fields: [administratorId], references: [id], onDelete: Cascade)
  createdByUser User          @relation("TeamInviteCreatedBy", fields: [createdByUserId], references: [id])
  usedByUser    User?         @relation("TeamInviteUsedBy", fields: [usedByUserId], references: [id])

  @@index([administratorId])
  @@map("team_invites")
}

/// 1:1 con Administrator. Separado porque cambia con ciclo de vida propio
/// (facturación) distinto del resto de datos del admin.
model AdminBilling {
  administratorId String         @id @map("administrator_id") @db.Uuid
  businessName    String         @map("business_name") @db.VarChar(200)
  cif             String         @db.VarChar(20)
  address         String         @db.VarChar(255)
  email           String         @db.VarChar(200)
  paymentMethod   AdminPayMethod @map("payment_method")
  iban            String?        @db.VarChar(34)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  administrator Administrator @relation(fields: [administratorId], references: [id], onDelete: Cascade)

  @@map("admin_billing")
}

/// Orden de domiciliación SEPA CORE que un despacho firma (acepta en la app)
/// para que Domora le cobre sus facturas por adeudo directo. Una sola activa
/// por despacho (índice único parcial en la migración); cambiar de IBAN o de
/// método revoca la anterior, que se conserva como prueba. Sin IP ni agente de
/// usuario: solo fecha, usuario y el texto exacto aceptado.
model AdminSepaMandate {
  id                 String                 @id @default(uuid()) @db.Uuid
  administratorId    String                 @map("administrator_id") @db.Uuid
  /// Referencia única del mandato (UMR, máx. 35): DOM-<8 del despacho>-<AAAAMMDD>-<6 hex>.
  reference          String                 @unique @db.VarChar(35)
  /// Identificador de acreedor SEPA de Domora vigente al firmar.
  creditorId         String                 @map("creditor_id") @db.VarChar(35)
  debtorName         String                 @map("debtor_name") @db.VarChar(200)
  /// IBAN cifrado en reposo (AES-256-GCM, prefijo 'enc:v1:', ver sepa/crypto.service.ts).
  debtorIban         String                 @map("debtor_iban") @db.VarChar(255)
  /// «ES91 ···· 1332»: lo único que sale por la API.
  debtorIbanMasked   String                 @map("debtor_iban_masked") @db.VarChar(20)
  signedAt           DateTime               @map("signed_at") @db.Timestamptz
  acceptedByUserId   String?                @map("accepted_by_user_id") @db.Uuid
  /// Texto exacto de la orden que el despacho aceptó.
  mandateText        String                 @map("mandate_text") @db.Text
  textVersion        String                 @map("text_version") @db.VarChar(20)
  /// Orden firmada escaneada, opcional (sin subida todavía).
  signedDocumentPath String?                @map("signed_document_path") @db.VarChar(500)
  status             AdminSepaMandateStatus @default(active)
  revokedAt          DateTime?              @map("revoked_at") @db.Timestamptz
  revokedReason      String?                @map("revoked_reason") @db.VarChar(255)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz

  administrator Administrator @relation(fields: [administratorId], references: [id], onDelete: Cascade)
  acceptedBy    User?         @relation("AdminSepaMandateAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([administratorId, signedAt(sort: Desc)])
  @@map("admin_sepa_mandates")
}

/// 1:1 con Administrator, mismo patrón que AdminBilling: ciclo de vida
/// propio (lo escribe el webhook de Stripe, no el panel de soporte). El
/// customerId se resuelve SIEMPRE desde aquí en servidor — nunca se acepta
/// uno enviado por el cliente (ver EstateAccessService para el mismo
/// criterio aplicado a estateId).
model AdministratorSubscription {
  administratorId      String              @id @map("administrator_id") @db.Uuid
  stripeCustomerId     String              @map("stripe_customer_id") @db.VarChar(255)
  stripeSubscriptionId String?             @unique @map("stripe_subscription_id") @db.VarChar(255)
  stripePriceId        String?             @map("stripe_price_id") @db.VarChar(255)
  status               SubscriptionStatus?
  currentPeriodEnd     DateTime?           @map("current_period_end") @db.Timestamptz
  cancelAtPeriodEnd    Boolean             @default(false) @map("cancel_at_period_end")
  /// Fecha del primer `past_due` desde que la gestora estaba `Activa` —
  /// arranca el período de gracia de 7 días (SubscriptionGraceCronService)
  /// antes de pasar a `Vencida`. Se limpia al recuperar el pago o al
  /// restringir por un estado terminal de Stripe (unpaid/canceled/
  /// incomplete_expired, que ya agotaron la propia cascada de reintentos
  /// de Stripe — no se les da gracia encima).
  pastDueSince         DateTime?           @map("past_due_since") @db.Timestamptz
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  administrator Administrator @relation(fields: [administratorId], references: [id], onDelete: Cascade)

  @@map("administrator_subscriptions")
}

/// Contador de numeración por serie y ejercicio.
///
/// Sustituye al `count()` que se usaba antes para calcular el siguiente
/// número: contar filas no sirve como secuencia —dos emisiones simultáneas
/// obtienen el mismo valor, y borrar una factura deja un hueco— y la
/// facturación exige numeración correlativa sin huecos ni duplicados.
///
/// Se incrementa DENTRO de la transacción de emisión a propósito: así, si la
/// factura falla, el número se libera y lo reutiliza la siguiente. Una
/// SEQUENCE de Postgres no valdría, porque no revierte al hacer rollback y
/// generaría precisamente los huecos que hay que evitar.
model InvoiceSeries {
  series     String @db.VarChar(10)
  year       Int
  lastNumber Int    @default(0) @map("last_number")

  @@id([series, year])
  @@map("invoice_series")
}

/// Cabeza de cada cadena de registros de facturación.
///
/// Hay una cadena INDEPENDIENTE por NIF de obligado tributario: la norma
/// encadena por SIF + obligado, no por serie. Hoy solo emite Domora, pero se
/// modela así desde el principio porque `verifactu_records` es inmutable y de
/// solo-inserción: separar cadenas a posteriori exigiría reescribir registros
/// que legalmente no se pueden tocar.
///
/// Sirve además para serializar: reservar el hueco bloquea esta fila, con lo
/// que dos emisiones simultáneas del mismo emisor no pueden leer la misma
/// huella anterior.
model VerifactuChain {
  issuerTaxId String  @id @map("issuer_tax_id") @db.VarChar(20)
  lastSeq     Int     @default(0) @map("last_seq")
  /// Huella del último registro. Null mientras la cadena está vacía.
  lastHash    String? @map("last_hash") @db.VarChar(64)

  @@map("verifactu_chain")
}

/// Registro de facturación (RD 1007/2023).
///
/// Tabla de SOLO INSERCIÓN. Un trigger impide borrarla y solo deja modificar
/// los campos de seguimiento del envío: los campos fiscales y de
/// encadenamiento son inmutables por ley, y la garantía no puede depender de
/// que nadie escriba mal el código más adelante.
model VerifactuRecord {
  id          String              @id @default(uuid()) @db.Uuid
  issuerTaxId String              @map("issuer_tax_id") @db.VarChar(20)
  /// Posición dentro de la cadena de ESE emisor.
  chainSeq    Int                 @map("chain_seq")
  type        VerifactuRecordType
  invoiceId   String?             @map("invoice_id") @db.Uuid

  /// Campos normativos exactamente como entraron en el cálculo de la huella.
  /// Se conservan para poder recalcularla y probar la integridad sin
  /// depender de que la factura siga existiendo o inalterada.
  payload Json

  /// SHA-256 en hexadecimal y mayúsculas (64 caracteres).
  hash         String   @db.VarChar(64)
  /// Huella del registro anterior de la cadena. Null solo en el primero.
  previousHash String?  @map("previous_hash") @db.VarChar(64)
  /// Momento de generación con huso horario — entra en el cálculo de la huella.
  generatedAt  DateTime @map("generated_at") @db.Timestamptz

  submissionState VerifactuSubmissionState @default(pendiente) @map("submission_state")
  aeatCsv         String?                  @map("aeat_csv") @db.VarChar(100)
  aeatResponse    Json?                    @map("aeat_response")
  submittedAt     DateTime?                @map("submitted_at") @db.Timestamptz
  attempts        Int                      @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  invoice AdminInvoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([issuerTaxId, chainSeq])
  @@unique([issuerTaxId, hash])
  @@index([submissionState])
  @@index([invoiceId])
  @@map("verifactu_records")
}

model AdminInvoice {
  id              String   @id @default(uuid()) @db.Uuid
  administratorId String   @map("administrator_id") @db.Uuid
  /// Número completo de display, "DOM-2026-0001". Se compone de los dos
  /// campos siguientes, que se guardan aparte para poder ordenar y auditar
  /// la correlatividad sin parsear cadenas.
  invoiceNo       String   @unique @map("invoice_no") @db.VarChar(30)
  series          String   @default("DOM") @db.VarChar(10)
  fiscalYear      Int      @default(0) @map("fiscal_year")
  sequence        Int      @default(0)
  issueDate       DateTime @map("issue_date") @db.Date
  /// Fecha de la operación, distinta de la de expedición cuando se factura
  /// un periodo ya consumido.
  operationDate   DateTime @map("operation_date") @db.Date
  concept         String   @default("") @db.VarChar(300)

  /// Desglose fiscal. Antes solo se guardaba el total, que no permite
  /// justificar la cuota repercutida.
  taxBase   Decimal @map("tax_base") @db.Decimal(10, 2)
  taxRate   Decimal @map("tax_rate") @db.Decimal(5, 2)
  taxAmount Decimal @map("tax_amount") @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)

  /// Snapshot de los datos fiscales del destinatario en el momento de
  /// emitir. Se congelan en lugar de leerse de AdminBilling porque una
  /// factura es inmutable: si la gestora cambia luego de CIF o domicilio, la
  /// factura ya emitida debe seguir mostrando lo que se emitió. Mismo
  /// criterio que el snapshot de AccountingReceipt.
  recipientName    String @map("recipient_name") @db.VarChar(200)
  recipientTaxId   String @map("recipient_tax_id") @db.VarChar(20)
  recipientAddress String @map("recipient_address") @db.VarChar(255)

  status    AdminInvoiceStatus
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz

  /// Presente solo en facturas generadas automáticamente al finalizar el
  /// ciclo de Stripe (BillingService) — null en las emitidas manualmente
  /// (issueInvoice). Permite reconciliar invoice.payment_succeeded/
  /// payment_failed contra la fila ya creada, sin volver a numerar ni
  /// encadenar Verifactu dos veces para el mismo evento de Stripe.
  stripeInvoiceId String? @unique @map("stripe_invoice_id") @db.VarChar(255)

  administrator    Administrator     @relation(fields: [administratorId], references: [id], onDelete: Cascade)
  verifactuRecords VerifactuRecord[]

  /// Impide dos facturas con el mismo número dentro de una serie y ejercicio
  /// aunque `invoiceNo` llegase a componerse mal.
  @@unique([series, fiscalYear, sequence])
  @@index([administratorId])
  @@map("admin_invoices")
}

model AdminActivityItem {
  id              String            @id @default(uuid()) @db.Uuid
  administratorId String            @map("administrator_id") @db.Uuid
  type            AdminActivityType
  title           String            @db.VarChar(255)
  authorUserId    String?           @map("author_user_id") @db.Uuid
  occurredAt      DateTime          @default(now()) @map("occurred_at") @db.Timestamptz
  /// Identificador del hecho externo que originó la entrada (p. ej. la factura
  /// de Stripe cobrada): los webhooks se reintentan y no deben duplicarla.
  externalRef     String?           @unique @map("external_ref") @db.VarChar(255)

  administrator Administrator @relation(fields: [administratorId], references: [id], onDelete: Cascade)
  authorUser    User?         @relation("AdminActivityAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([administratorId, occurredAt(sort: Desc)])
  @@index([type, occurredAt(sort: Desc)])
  @@map("admin_activity_log")
}

// ═══════════════════════════════════════════════════════════════════════
// ── 2. Identidad y acceso ──────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════

model User {
  id              String        @id @default(uuid()) @db.Uuid
  email           String        @unique @db.VarChar(200)
  passwordHash    String        @map("password_hash") @db.VarChar(255)
  fullName        String        @map("full_name") @db.VarChar(200)
  role            UserRole
  administratorId String?       @map("administrator_id") @db.Uuid
  taxIdCountry    TaxIdCountry? @map("tax_id_country")
  taxId           String?       @map("tax_id") @db.VarChar(20)
  phone           String?       @db.VarChar(30)
  termsAcceptedAt DateTime?     @map("terms_accepted_at") @db.Timestamptz
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz

  /// 2FA opcional por TOTP (Fase 2.3) — nunca obligatorio a nivel global,
  /// solo exigible por la gestora para votar en juntas concretas de alto
  /// riesgo (ver Meeting.require2faForVoting).
  totpSecret  String? @map("totp_secret") @db.VarChar(64)
  totpEnabled Boolean @default(false) @map("totp_enabled")

  administrator        Administrator?        @relation("AdministratorUsers", fields: [administratorId], references: [id])
  twoFactorBackupCodes TwoFactorBackupCode[]

  refreshTokens                      RefreshToken[]
  passwordResetTokens                PasswordResetToken[]
  administeredAdmins                 Administrator[]              @relation("AdministratorPrimaryUser")
  teamInvitesCreated                 TeamInvite[]                 @relation("TeamInviteCreatedBy")
  teamInvitesUsed                    TeamInvite[]                 @relation("TeamInviteUsedBy")
  adminActivityAuthored              AdminActivityItem[]          @relation("AdminActivityAuthor")
  adminSepaMandatesAccepted          AdminSepaMandate[]           @relation("AdminSepaMandateAcceptedBy")
  primaryProperties                  Property[]                   @relation("PropertyPrimaryUser")
  propertyMemberships                PropertyMembership[]
  membershipsApproved                PropertyMembership[]         @relation("MembershipApprovedBy")
  membershipInvitesCreated           PropertyMembershipInvite[]   @relation("PropertyMembershipInviteCreatedBy")
  membershipInvitesUsed              PropertyMembershipInvite[]   @relation("PropertyMembershipInviteUsedBy")
  membershipInvitesRevoked           PropertyMembershipInvite[]   @relation("PropertyMembershipInviteRevokedBy")
  externalOwnersCreated              ExternalOwner[]              @relation("ExternalOwnerCreatedBy")
  externalOwnerPromoted              ExternalOwner[]              @relation("ExternalOwnerPromoted")
  representationsAsRep               UserRepresentation[]         @relation("RepresentationAsRepresentative")
  representationsAsSubject           UserRepresentation[]         @relation("RepresentationAsRepresented")
  representationsCreated             UserRepresentation[]         @relation("RepresentationCreatedBy")
  representationsRevoked             UserRepresentation[]         @relation("RepresentationRevokedBy")
  mandatesTitular                    Mandate[]                    @relation("MandateTitular")
  mandateAmendments                  MandateAmendment[]           @relation("MandateAmendmentChangedBy")
  adhesionRequests                   AdhesionRequest[]            @relation("AdhesionRequestUser")
  adhesionRequestsResolved           AdhesionRequest[]            @relation("AdhesionRequestResolvedBy")
  estateOnboardingRequests           EstateOnboardingRequest[]    @relation("EstateOnboardingRequestedBy")
  estateOnboardingRequestsResolved   EstateOnboardingRequest[]    @relation("EstateOnboardingResolvedBy")
  issueTimelineEntries               IssueTimelineEntry[]         @relation("IssueTimelineAuthor")
  issueReports                       IssueReport[]                @relation("IssueReportReporter")
  issuesAffecting                    IssueAffectedUser[]
  issueProviderAssignments           IssueProviderAssignment[]    @relation("IssueProviderAssignedBy")
  issueNotificationsSent             IssueNotification[]          @relation("IssueNotificationSentBy")
  resourceReads                      ResourceRead[]
  notifications                      Notification[]
  notificationPreferences            UserNotificationPreference[]
  pushSubscriptions                  PushSubscription[]
  debtorActions                      DebtorAction[]               @relation("DebtorActionAuthor")
  paymentAgreementsCreated           PaymentAgreement[]           @relation("PaymentAgreementCreatedBy")
  activityLogAuthored                ActivityLogEntry[]           @relation("ActivityLogActor")
  communicationsAuthored             Communication[]              @relation("CommunicationAuthor")
  communicationsLastEdited           Communication[]              @relation("CommunicationLastEditedBy")
  communicationReplies               CommunicationReply[]         @relation("CommunicationReplyAuthor")
  importBatchesCreated               ImportBatch[]
  journalEntriesCreated              JournalEntry[]               @relation("JournalEntryCreatedBy")
  receiptsCancelled                  AccountingReceipt[]          @relation("ReceiptCancelledBy")
  latePaymentInterestPoliciesCreated LatePaymentInterestPolicy[]  @relation("LatePaymentInterestPolicyCreatedBy")
  fiscalYearsClosed                  FiscalYear[]                 @relation("FiscalYearClosedBy")
  bookings                           Booking[]
  directMessageParticipations        DirectMessageParticipant[]
  directMessagesSent                 DirectMessage[]
  messagingSettings                  UserMessagingSettings?
  meetingsCreated                    Meeting[]                    @relation("MeetingCreatedBy")
  meetingsTelematicBackingConfirmed  Meeting[]                    @relation("MeetingTelematicBackingConfirmedBy")
  meetingAttendances                 MeetingAttendance[]
  meetingAttendancesMarked           MeetingAttendance[]          @relation("MeetingAttendanceMarkedBy")
  meetingChatMessagesSent            MeetingChatMessage[]
  meetingPresences                   MeetingPresence[]
  voteDelegationsAsDelegator         MeetingVoteDelegation[]      @relation("VoteDelegationDelegator")
  voteDelegationsAsRepresentative    MeetingVoteDelegation[]      @relation("VoteDelegationRepresentative")
