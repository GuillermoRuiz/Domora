  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "ai_reconciliation_suggestions_estate_fk")

  @@index([estateId, status])
