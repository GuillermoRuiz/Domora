  voteDelegationsRevoked             MeetingVoteDelegation[]      @relation("VoteDelegationRevokedBy")
  voteSessionsOpened                 VoteSession[]                @relation("VoteSessionOpenedBy")
  voteSessionsClosed                 VoteSession[]                @relation("VoteSessionClosedBy")
  voteResponses                      VoteResponse[]
  voteResponsesRegistered            VoteResponse[]               @relation("VoteResponseRegisteredBy")
  meetingsActaSignedAsPresidente     Meeting[]                    @relation("MeetingActaSignedByPresidente")
  meetingsActaSignedAsSecretario     Meeting[]                    @relation("MeetingActaSignedBySecretario")
  meetingActaVersionsSaved           MeetingActaVersion[]         @relation("MeetingActaVersionSavedBy")
  regulatoryInspectionsCreated       RegulatoryInspection[]       @relation("RegulatoryInspectionCreatedBy")
  inspectionResultsCreated           InspectionResult[]           @relation("InspectionResultCreatedBy")
  correctiveActionsAssigned          CorrectiveAction[]           @relation("CorrectiveActionAssignee")
  openingDifferencesAccepted         OpeningBalanceSet[]          @relation("OpeningDifferenceAcceptedBy")
  openingBalanceSetsPosted           OpeningBalanceSet[]          @relation("OpeningPostedBy")
  noPriorBalancesConfirmed           AccountingSettings[]         @relation("NoPriorBalancesConfirmedBy")
  agendaTasksAssigned                AgendaTask[]                 @relation("AgendaTaskAssignee")
  agendaTasksCreated                 AgendaTask[]                 @relation("AgendaTaskCreatedBy")
  agendaTaskComments                 AgendaTaskComment[]
  agendaTaskAttachments              AgendaTaskAttachment[]
  dailyActivity                      UserDailyActivity[]
  commercialFollowUps                CommercialFollowUp[]         @relation("CommercialFollowUpAuthor")

