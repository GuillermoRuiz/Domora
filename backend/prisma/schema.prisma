/// Uso de la plataforma agregado por usuario y día (UTC): una fila por usuario
/// activo y día, nunca una por petición. Es el histórico de adopción (usuarios
/// activos, frecuencia, módulos) que no se puede reconstruir después. Solo roles
/// B y C; el equipo Domora (rol A) no cuenta. `administratorId` es el despacho
/// del usuario B en ese momento; para C queda null (se resuelve por fincas).
model UserDailyActivity {
  day             DateTime @db.Date
  userId          String   @map("user_id") @db.Uuid
  role            UserRole
  administratorId String?  @map("administrator_id") @db.Uuid
  /// Claves de módulo distintas usadas ese día (p. ej. `estates`, `receipts`).
  modules         String[]
  requests        Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([day, userId])
  @@index([administratorId, day])
  @@index([day])
  @@map("user_daily_activity")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// @unique no es solo una restricción de integridad (el hash identifica
  /// unívocamente al token): crea el índice que necesita `refresh()`, que
  /// busca por esta columna en cada renovación de sesión — la ruta más
  /// caliente de la API. Sin él, Postgres hacía un seq scan sobre una tabla
  /// que crece con cada login.
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

/// Códigos de respaldo del 2FA (Fase 2.3) — tabla, no columna-array: hace
/// falta marcar cada código como "usado" individualmente sin manipular un
/// array bajo concurrencia. Mismo criterio de tabla dedicada que
/// RefreshToken/PasswordResetToken.
model TwoFactorBackupCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.VarChar(255)
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_backup_codes")
}

/// Recuperación de contraseña — mismo patrón que RefreshToken/TeamInvite
/// (token opaco aleatorio, solo se persiste su hash SHA-256). Ventana corta
/// (1h, ver AuthService) porque es una ventana de seguridad, no de
/// conveniencia como las invitaciones.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ═══════════════════════════════════════════════════════════════════════
// ── 3. Fincas y propiedades ────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════

model Estate {
  id                       String     @id @default(uuid()) @db.Uuid
  administratorId          String     @map("administrator_id") @db.Uuid
  name                     String     @db.VarChar(200)
  type                     EstateType
  address                  String     @db.VarChar(255)
  streetNumber             String?    @map("street_number") @db.VarChar(20)
  location                 String     @db.VarChar(150)
  // Texto libre que se muestra en la ficha de la finca (tarjeta de presentación del Resumen).
  description              String?    @db.VarChar(600)
  // Datos generales (pestaña de solo lectura; se editan en «Editar finca»).
  yearBuilt                Int?       @map("year_built")
  mainUse                  String?    @map("main_use") @db.VarChar(50)
  internalRef              String?    @map("internal_ref") @db.VarChar(50)
  taxRegime                String?    @map("tax_regime") @db.VarChar(150)
  applicableLaw            String?    @default("Ley de Propiedad Horizontal") @map("applicable_law") @db.VarChar(150)
  notes                    String?    @db.VarChar(2000)
  /// Superficie de la parcela según el Catastro (no editable a mano).
  parcelAreaM2             Decimal?   @map("parcel_area_m2") @db.Decimal(10, 2)
  /// Ubicación (WGS84) para el mapa de «Datos generales». La obtiene el backend:
  /// Catastro por la referencia de la parcela; si no, Nominatim por la dirección.
  latitude                 Decimal?   @db.Decimal(9, 6)
  longitude                Decimal?   @db.Decimal(9, 6)
  /// `catastro` | `nominatim` | `seed`; null = sin ubicar.
  geoSource                String?    @map("geo_source") @db.VarChar(20)
  /// Último intento de ubicarla (con o sin éxito): evita reintentar en cada lectura.
  geoResolvedAt            DateTime?  @map("geo_resolved_at") @db.Timestamptz
  // Localización necesaria para consultar el Catastro (Consulta_DNPLOC exige
  // provincia + municipio). `cadastralReference` es la de la PARCELA (14
  // caracteres); las de cada unidad (20) viven en `Property.cadastralReference`.
  // Todos opcionales: las fincas existentes no los tienen y se rellenan al
  // importar desde el Catastro o al editar la finca.
  province                 String?    @db.VarChar(100)
  postalCode               String?    @map("postal_code") @db.VarChar(10)
  cadastralReference       String?    @map("cadastral_reference") @db.VarChar(14)
  // Cache of the official Catastro facade link, never an independently supplied image.
  catastroFacadeUrl        String?    @map("catastro_facade_url") @db.VarChar(1000)
  catastroFacadeResolvedAt DateTime?  @map("catastro_facade_resolved_at") @db.Timestamptz
  /// Foto de la finca subida por la gestora (opcional; manda sobre la fachada del Catastro).
  /// `photoKey` es la clave opaca del almacenamiento y NUNCA sale en las respuestas;
  /// la interfaz solo ve `photoUpdatedAt` (hay foto si no es null) y la pide por GET .../photo.
  photoKey                 String?    @map("photo_key") @db.VarChar(500)
  photoContentType         String?    @map("photo_content_type") @db.VarChar(100)
  photoUpdatedAt           DateTime?  @map("photo_updated_at") @db.Timestamptz
  // Color identificativo de la tarjeta en el dashboard de fincas ('#RRGGBB').
  // Editable por el admin (Editar finca); si es NULL, el frontend deriva uno
  // determinista a partir del id para que las tarjetas nunca se vean iguales.
  color                    String?    @db.VarChar(7)
  reserveTarget            Decimal    @default(0) @map("reserve_target") @db.Decimal(12, 2)
  iban                     String?    @db.VarChar(34)
  // ── Datos fiscales / SEPA de la comunidad (Apéndice F) ────────────────
  // La comunidad de propietarios es el acreedor SEPA, no la gestora.
  cif                      String?    @db.VarChar(20)
  creditorId               String?    @map("creditor_id") @db.VarChar(16)
  // VarChar(255): almacena el IBAN cifrado en reposo (AES-256-GCM,
  // prefijo 'enc:v1:', ver backend/src/sepa/crypto.service.ts)
  creditorIban             String?    @map("creditor_iban") @db.VarChar(255)
  creditorBic              String?    @map("creditor_bic") @db.VarChar(11)
  creditorPostalAddress    String?    @map("creditor_postal_address") @db.VarChar(255)
  createdAt                DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt                DateTime?  @map("deleted_at") @db.Timestamptz

  administrator Administrator @relation(fields: [administratorId], references: [id])

  properties                  Property[]
  propertyEvents              PropertyEvent[]
  mandates                    Mandate[]                   @relation("MandateCreditorEstate")
  adhesionRequests            AdhesionRequest[]
  userRepresentations         UserRepresentation[]        @relation("RepresentationGrantedEstate")
  communications              Communication[]
  documents                   Document[]
  documentFolders             DocumentFolder[]
  suppliers                   Supplier[]
  issues                      Issue[]
  staffMembers                StaffMember[]
  chartAccounts               ChartAccount[]
  bankExtractEntries          BankExtractEntry[]
  budgetItems                 BudgetItem[]
  costCentres                 CostCentre[]
  costCentreBudgets           CostCentreBudget[]
  fiscalYears                 FiscalYear[]
  accountingPeriods           AccountingPeriod[]
  remesas                     RemesaHistoryItem[]
  debtors                     Debtor[]
  amenities                   Amenity[]
  activityLogEntries          ActivityLogEntry[]
  meetings                    Meeting[]
  importBatches               ImportBatch[]
  assets                      Asset[]
  inspectionTypes             InspectionType[]
  regulatoryInspections       RegulatoryInspection[]
  accountingSettings          AccountingSettings?
  bankAccounts                BankAccount[]
  journalEntries              JournalEntry[]
  receipts                    AccountingReceipt[]
  collections                 Collection[]
  receiptReturns              ReceiptReturn[]
  suspenseItems               SuspenseItem[]
  returnFiles                 ReturnFile[]
  supplierInvoices            SupplierInvoice[]
  supplierPayments            SupplierPayment[]
  payrollRecords              PayrollRecord[]
  taxSettlements              TaxSettlement[]
  reserveFundApplications     ReserveFundApplication[]
  bankStatements              BankStatement[]
  reconciliationGroups        ReconciliationGroup[]
  openingBalanceSets          OpeningBalanceSet[]
  latePaymentInterestPolicies LatePaymentInterestPolicy[]
  officeTerms                 EstateOfficeTerm[]
  agendaTasks                 AgendaTask[]

  aiJobs                      AiJob[]
  aiAudit                     AiAudit[]
  aiRequests                  AiRequest[]
  aiInvoiceDocuments          AiInvoiceDocument[]
  aiReconciliationSuggestions AiReconciliationSuggestion[]
  aiWeeklySnapshots           AiWeeklySnapshot[]

  @@index([administratorId])
  @@map("estates")
}

/// Evento de finca (junta ordinaria/extraordinaria, obras...). Se muestra
/// como "próximo evento" en el dashboard de cada propiedad de la finca, pero
/// pertenece a la finca — no a una unidad individual (docs/data-model.md §3.5).
model PropertyEvent {
  id        String   @id @default(uuid()) @db.Uuid
  estateId  String   @map("estate_id") @db.Uuid
  title     String   @db.VarChar(200)
  date      DateTime @db.Date
  location  String   @db.VarChar(200)
  room      String?  @db.VarChar(150)
  time      String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)

  @@index([estateId, date])
  @@map("property_events")
}

/// Entidad canónica única de unidad inmobiliaria (Apéndice C — sustituye a
/// los antiguos `Property` admin-DTO y `OwnerProperty` paralelos). Contiene
/// identificación catastral (DGC) para poder emitir notificaciones postales
/// con formato estándar y ordenar tablas por escalera/planta/puerta.
///
/// `balance`, `pendingDocs`, `openIssues` del TS son DERIVADOS — no se
/// almacenan aquí, se calculan en consulta sobre receipts/documents/issues.
model Property {
  id              String            @id @default(uuid()) @db.Uuid
  estateId        String?           @map("estate_id") @db.Uuid
  administratorId String?           @map("administrator_id") @db.Uuid
  type            OwnerPropertyType
  status          PropertyStatus

  // ── Identificación catastral / postal (DGC) ─────────────────────────
  viaType            ViaType? @map("via_type")
  viaName            String?  @map("via_name") @db.VarChar(150)
  streetNumber       String?  @map("street_number") @db.VarChar(20)
  streetNumberSuffix String?  @map("street_number_suffix") @db.VarChar(20)
  block              String?  @db.VarChar(20)
  staircase          String?  @db.VarChar(10)
  floor              String?  @db.VarChar(10)
  door               String?  @db.VarChar(10)
  postalCode         String?  @map("postal_code") @db.VarChar(10)
  municipality       String?  @db.VarChar(150)
  province           String?  @db.VarChar(100)
  country            String?  @default("ES") @db.VarChar(2)
  cadastralReference String?  @map("cadastral_reference") @db.VarChar(20)

  ref String? @db.VarChar(20)

  quotaMonthly Decimal @default(0) @map("quota_monthly") @db.Decimal(10, 2)
  iban         String? @db.VarChar(34)

  /// Coeficiente de participación (%, LPH art. 5) — reparto legal de gastos
  /// y peso de voto en juntas. Nullable: no se puede rellenar retroactivamente
  /// en propiedades existentes; `quotaMonthly` sigue siendo el importe fijo
  /// que usa `generateReceipts()` hoy, sin relación con este campo todavía.
  /// La suma ≈100% por finca se valida solo en aplicación (no en BD), ver
  /// `chk_property_participation_quota` en la migración de este campo.
  participationQuota Decimal? @map("participation_quota") @db.Decimal(5, 2)

  /// Superficie construida (m²) según el Catastro (`debi.sfc`). Solo la
  /// rellena la importación desde el Catastro.
  builtAreaM2      Decimal?  @map("built_area_m2") @db.Decimal(8, 2)
  /// Cuándo se leyeron del Catastro los datos de esta propiedad (la licencia
  /// de uso exige citar la fecha de acceso).
  catastroSyncedAt DateTime? @map("catastro_synced_at") @db.Timestamptz

  primaryUserId String? @map("primary_user_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  estate      Estate? @relation(fields: [estateId], references: [id])
  primaryUser User?   @relation("PropertyPrimaryUser", fields: [primaryUserId], references: [id], onDelete: SetNull)

  memberships              PropertyMembership[]
  membershipInvites        PropertyMembershipInvite[]
  externalOwners           ExternalOwner[]
  journalLines             JournalLine[]
  collections              Collection[]
  representations          UserRepresentation[]       @relation("RepresentationGrantedProperty")
  mandates                 Mandate[]
  adhesionRequests         AdhesionRequest[]
  estateOnboardingRequests EstateOnboardingRequest[]
  receipts                 AccountingReceipt[]
  remesaLines              RemesaLine[]
  debtors                  Debtor[]
  bookings                 Booking[]
  activityLogEntries       ActivityLogEntry[]
  targetedDocuments        Document[]
  targetedCommunications   Communication[]
  meetingAttendances       MeetingAttendance[]
  meetingVoteDelegations   MeetingVoteDelegation[]
  voteResponses            VoteResponse[]
  openingDebts             OpeningPropertyDebt[]
  openingAdvances          OpeningPropertyAdvance[]

  @@unique([estateId, ref])
  @@index([estateId])
  @@index([administratorId])
  @@index([estateId, cadastralReference])
  @@map("properties")
}

/// Relación N:M usuario ↔ propiedad. Una propiedad puede tener varios
/// usuarios (matrimonio, propietario+inquilino, herederos); un usuario puede
/// estar en varias propiedades.
model PropertyMembership {
  id               String             @id @default(uuid()) @db.Uuid
  propertyId       String             @map("property_id") @db.Uuid
  userId           String             @map("user_id") @db.Uuid
  roleType         MembershipRoleType @map("role_type")
  status           MembershipStatus
  isPrimaryContact Boolean            @default(false) @map("is_primary_contact")
  /// «Contacto clave» de la finca: lo marca la gestora en el listado de propiedades.
  isKeyContact     Boolean            @default(false) @map("is_key_contact")
  nickname         String?            @db.VarChar(150)
  linkedAt         DateTime           @map("linked_at") @db.Timestamptz
  revokedAt        DateTime?          @map("revoked_at") @db.Timestamptz
  approvedByUserId String?            @map("approved_by_user_id") @db.Uuid
  notes            String?

  property       Property                    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user           User                        @relation(fields: [userId], references: [id])
  approvedByUser User?                       @relation("MembershipApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  settings       PropertyMembershipSettings?

  @@unique([propertyId, userId, roleType])
  @@index([userId])
  @@index([propertyId, status])
  @@map("property_memberships")
}

/// Invitación de un miembro (Inquilino/Representante/Ocupante, nunca
/// Propietario — un cambio de titularidad es otra operación) a una propiedad
/// YA vinculada a una finca. Mismo patrón que `TeamInvite`: token opaco de un
/// solo uso, hash en DB. A diferencia de `TeamInvite` (que siempre crea un
/// usuario nuevo), acá quien canjea el token puede ya tener cuenta — por eso
/// no hay datos de registro en el DTO de canje, solo requiere sesión
/// iniciada. `inviteeEmail` es solo el destino del envío, nunca se usa para
/// resolver una cuenta existente (a diferencia de `representativeEmail` en
/// `MeetingVoteDelegation`) porque el invitado a menudo no tiene cuenta aún.
model PropertyMembershipInvite {
  id              String             @id @default(uuid()) @db.Uuid
  propertyId      String             @map("property_id") @db.Uuid
  roleType        MembershipRoleType @map("role_type")
  inviteeEmail    String             @map("invitee_email") @db.VarChar(255)
  tokenHash       String             @unique @map("token_hash") @db.VarChar(64)
  createdByUserId String             @map("created_by_user_id") @db.Uuid
  expiresAt       DateTime           @map("expires_at") @db.Timestamptz
  usedAt          DateTime?          @map("used_at") @db.Timestamptz
  usedByUserId    String?            @map("used_by_user_id") @db.Uuid
  revokedAt       DateTime?          @map("revoked_at") @db.Timestamptz
  revokedByUserId String?            @map("revoked_by_user_id") @db.Uuid
  lastSentAt      DateTime?          @map("last_sent_at") @db.Timestamptz
  reminderSentAt  DateTime?          @map("reminder_sent_at") @db.Timestamptz
  /// Solo en invitaciones de Propietario: el titular importado (sin cuenta)
  /// que pasa a ser usuario al canjearla. Un CHECK en la migración ata ambas
  /// cosas (Propietario ⇔ externalOwnerId) — la vía del titular principal no
  /// puede emitir invitaciones de Propietario, solo la gestora sobre un
  /// titular que ella misma registró.
  externalOwnerId String?            @map("external_owner_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz

  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdByUser User           @relation("PropertyMembershipInviteCreatedBy", fields: [createdByUserId], references: [id])
  usedByUser    User?          @relation("PropertyMembershipInviteUsedBy", fields: [usedByUserId], references: [id])
  revokedByUser User?          @relation("PropertyMembershipInviteRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  externalOwner ExternalOwner? @relation(fields: [externalOwnerId], references: [id], onDelete: Restrict)

  @@index([propertyId])
  @@index([externalOwnerId])
  @@map("property_membership_invites")
}

/// Política de quién puede iniciar una conversación directa con el usuario
/// dentro de esta propiedad concreta.
enum DirectMessagePolicy {
  nobody
  neighbors
  anyone_linked
}

/// Preferencia de canal para un TIPO de notificación — deliberadamente
/// distinto de `NotificationChannel` (que registra el canal de un envío ya
/// realizado en `IssueNotification`). Este enum es la preferencia, no el
/// histórico.
enum NotificationSetting {
  none
  push_only
  email_only
  email_push
}

/// Cómo se muestra este usuario a otros usuarios de la finca (mensajería,
/// listados) dentro del contexto de esta propiedad concreta.
enum DisplayNamePolicy {
  full_name
  alias
  address
}

/// Privacidad y notificaciones POR MEMBRESÍA (no por usuario global): un
/// mismo usuario puede tener varias propiedades en fincas distintas y
/// querer comportarse distinto en cada una — mismo criterio que `nickname`/
/// `isPrimaryContact`, que ya viven aquí y no en `User`. Fila creada de
/// forma perezosa (lazy) en el primer PATCH; su ausencia equivale a los
/// valores por defecto de cada columna — nunca se hace backfill masivo.
model PropertyMembershipSettings {
  id           String @id @default(uuid()) @db.Uuid
  membershipId String @unique @map("membership_id") @db.Uuid

  visibleInDirectory   Boolean @default(true) @map("visible_in_directory")
  showPhoneInDirectory Boolean @default(false) @map("show_phone_in_directory")
  showEmailInDirectory Boolean @default(false) @map("show_email_in_directory")
  visibleInBookings    Boolean @default(true) @map("visible_in_bookings")

  allowDirectMessages DirectMessagePolicy @default(neighbors) @map("allow_direct_messages")

  displayNamePolicy DisplayNamePolicy @default(full_name) @map("display_name_policy")
  displayAlias      String?           @map("display_alias") @db.VarChar(100)

  notifyIssues         NotificationSetting @default(email_push) @map("notify_issues")
  notifyReceipts       NotificationSetting @default(email_push) @map("notify_receipts")
  notifyCommunications NotificationSetting @default(email_push) @map("notify_communications")
  notifyBookings       NotificationSetting @default(push_only) @map("notify_bookings")
  notifyDirectMessages NotificationSetting @default(email_push) @map("notify_direct_messages")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  membership PropertyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@map("property_membership_settings")
}

/// Titular conocido por el admin que NO es usuario de la plataforma (persona
/// jurídica, heredero pendiente, banco propietario...). No da acceso; sirve
/// para emitir recibos/notificaciones. `promotedToUserId` se rellena si esa
/// persona se da de alta finalmente.
model ExternalOwner {
  id               String              @id @default(uuid()) @db.Uuid
  propertyId       String              @map("property_id") @db.Uuid
  fullName         String              @map("full_name") @db.VarChar(200)
  taxIdCountry     TaxIdCountry?       @map("tax_id_country")
  taxId            String?             @map("tax_id") @db.VarChar(20)
  email            String?             @db.VarChar(200)
  phone            String?             @db.VarChar(30)
  postalAddress    String?             @map("postal_address") @db.VarChar(255)
  roleType         MembershipRoleType? @map("role_type")
  notes            String?
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz
  createdByUserId  String              @map("created_by_user_id") @db.Uuid
  promotedToUserId String?             @map("promoted_to_user_id") @db.Uuid
  promotedAt       DateTime?           @map("promoted_at") @db.Timestamptz
  /// «Contacto clave» de la finca: lo marca la gestora en el listado de propiedades.
  isKeyContact     Boolean             @default(false) @map("is_key_contact")

  property       Property                   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdByUser  User                       @relation("ExternalOwnerCreatedBy", fields: [createdByUserId], references: [id])
  promotedToUser User?                      @relation("ExternalOwnerPromoted", fields: [promotedToUserId], references: [id], onDelete: SetNull)
  invites        PropertyMembershipInvite[]

  @@index([propertyId])
  @@map("external_owners")
}

/// Representación legal: un usuario actúa en nombre de otro (tutela,
/// apoderamiento, herencia yacente...). El alcance puede acotarse a una
/// finca/propiedad concreta o ser global (ambos null).
model UserRepresentation {
  id                   String             @id @default(uuid()) @db.Uuid
  representativeUserId String             @map("representative_user_id") @db.Uuid
  representedUserId    String             @map("represented_user_id") @db.Uuid
  type                 RepresentationType
  scope                String?
  documentRef          String?            @map("document_ref") @db.VarChar(255)
  validFrom            DateTime           @map("valid_from") @db.Date
  validUntil           DateTime?          @map("valid_until") @db.Date
  grantedEstateId      String?            @map("granted_estate_id") @db.Uuid
  grantedPropertyId    String?            @map("granted_property_id") @db.Uuid
  active               Boolean            @default(true)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz
  createdByUserId      String?            @map("created_by_user_id") @db.Uuid
  revokedAt            DateTime?          @map("revoked_at") @db.Timestamptz
  revokedByUserId      String?            @map("revoked_by_user_id") @db.Uuid
  revocationReason     String?            @map("revocation_reason")

  representativeUser User      @relation("RepresentationAsRepresentative", fields: [representativeUserId], references: [id])
  representedUser    User      @relation("RepresentationAsRepresented", fields: [representedUserId], references: [id])
  grantedEstate      Estate?   @relation("RepresentationGrantedEstate", fields: [grantedEstateId], references: [id], onDelete: SetNull)
  grantedProperty    Property? @relation("RepresentationGrantedProperty", fields: [grantedPropertyId], references: [id], onDelete: SetNull)
  createdByUser      User?     @relation("RepresentationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  revokedByUser      User?     @relation("RepresentationRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@index([representativeUserId])
  @@index([representedUserId])
  @@map("user_representations")
}

/// Metadata del proceso de adhesión de un usuario a una propiedad/finca. El
/// vínculo REAL vive en PropertyMembership (pending → linked/revoked); esta
/// tabla guarda quién solicitó, quién resolvió, cuándo y con qué decisión.
model AdhesionRequest {
  id               String             @id @default(uuid()) @db.Uuid
  estateId         String             @map("estate_id") @db.Uuid
  propertyId       String?            @map("property_id") @db.Uuid
  userId           String             @map("user_id") @db.Uuid
  roleType         MembershipRoleType @map("role_type")
  submittedAt      DateTime           @map("submitted_at") @db.Timestamptz
  status           AdhesionStatus
  resolvedAt       DateTime?          @map("resolved_at") @db.Timestamptz
  resolvedByUserId String?            @map("resolved_by_user_id") @db.Uuid
  decision         AdhesionDecision?
  notes            String?

  estate         Estate    @relation(fields: [estateId], references: [id])
  property       Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  user           User      @relation("AdhesionRequestUser", fields: [userId], references: [id])
  resolvedByUser User?     @relation("AdhesionRequestResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([estateId, status])
  @@map("adhesion_requests")
}

enum EstateOnboardingStatus {
  pending
  contacted
  dismissed
}

/// Solicitud de alta de una comunidad NUEVA (sin gestora ni Estate todavía)
/// enviada por un rol C desde el wizard de "Añadir propiedad". A diferencia
/// de `AdhesionRequest` (pedir unirse a una finca YA existente), acá no hay
/// `estateId` — es una cola de revisión manual para el equipo de soporte,
/// no un alta automática (decisión de producto: evitar que cualquier rol C
/// pueda crear fincas sin supervisión).
model EstateOnboardingRequest {
  id                String                 @id @default(uuid()) @db.Uuid
  requestedByUserId String                 @map("requested_by_user_id") @db.Uuid
  propertyId        String?                @map("property_id") @db.Uuid
  communityName     String                 @map("community_name") @db.VarChar(200)
  communityAddress  String?                @map("community_address") @db.VarChar(255)
  adminName         String?                @map("admin_name") @db.VarChar(200)
  adminEmail        String?                @map("admin_email") @db.VarChar(255)
  status            EstateOnboardingStatus @default(pending)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz
  resolvedAt        DateTime?              @map("resolved_at") @db.Timestamptz
  resolvedByUserId  String?                @map("resolved_by_user_id") @db.Uuid

  requestedByUser User      @relation("EstateOnboardingRequestedBy", fields: [requestedByUserId], references: [id])
  property        Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  resolvedByUser  User?     @relation("EstateOnboardingResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  /// The lead created from this request (origin «Solicitud de alta de comunidad»).
  lead            Lead?

  @@index([status])
  @@map("estate_onboarding_requests")
}

// ═══════════════════════════════════════════════════════════════════════
// ── 4a. Gestión comercial de Domora (rol A, Clientes) ──────────────────
// ═══════════════════════════════════════════════════════════════════════

/// Where a potential client came from.
enum LeadOrigin {
  web
  referido
  comercial
  /// Created from an `EstateOnboardingRequest` (an owner asked for a community whose despacho is not in Domora).
  solicitud_alta
}

/// Commercial stage of a potential client. `convertido` is only set by the conversion.
enum LeadStatus {
  nuevo
  contactado
  en_prueba
  convertido
  descartado
}

/// Potential client of Domora (a despacho without an account yet). It becomes
/// the `Administrator` when its trial starts or when it contracts without
/// trial (odd/tasks/role-a-panel.md S13): the conversion creates the despacho
/// through `AdminsService.create` and links it here, so Clientes and
/// Administradores de fincas share one record.
model Lead {
  id                       String     @id @default(uuid()) @db.Uuid
  /// Name of the despacho.
  name                     String     @db.VarChar(200)
  contactName              String?    @map("contact_name") @db.VarChar(150)
  contactEmail             String?    @map("contact_email") @db.VarChar(200)
  contactPhone             String?    @map("contact_phone") @db.VarChar(30)
  city                     String?    @db.VarChar(120)
  origin                   LeadOrigin
  planOfInterest           PlanTier?  @map("plan_of_interest")
  status                   LeadStatus @default(nuevo)
  nextAction               String?    @map("next_action") @db.VarChar(300)
  nextActionAt             DateTime?  @map("next_action_at") @db.Date
  notes                    String?
  onboardingRequestId      String?    @unique @map("onboarding_request_id") @db.Uuid
  convertedAdministratorId String?    @unique @map("converted_administrator_id") @db.Uuid
  convertedAt              DateTime?  @map("converted_at") @db.Timestamptz
  createdAt                DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  onboardingRequest      EstateOnboardingRequest? @relation(fields: [onboardingRequestId], references: [id], onDelete: SetNull)
  convertedAdministrator Administrator?           @relation("LeadConvertedAdministrator", fields: [convertedAdministratorId], references: [id], onDelete: SetNull)
  followUps              CommercialFollowUp[]

  @@index([status])
  @@map("leads")
}

/// «Seguimiento comercial»: one entry per contact with a lead or a despacho
/// client (exactly one of `leadId` / `administratorId`, enforced by a CHECK).
model CommercialFollowUp {
  id              String   @id @default(uuid()) @db.Uuid
  leadId          String?  @map("lead_id") @db.Uuid
  administratorId String?  @map("administrator_id") @db.Uuid
  authorUserId    String?  @map("author_user_id") @db.Uuid
  occurredAt      DateTime @default(now()) @map("occurred_at") @db.Timestamptz
  text            String   @db.VarChar(2000)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  lead          Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  administrator Administrator? @relation(fields: [administratorId], references: [id], onDelete: Cascade)
  authorUser    User?          @relation("CommercialFollowUpAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([leadId, occurredAt(sort: Desc)])
  @@index([administratorId, occurredAt(sort: Desc)])
  @@map("commercial_follow_ups")
}

/// «Próxima acción» of a despacho client. 1:1 with Administrator and kept
/// apart (same pattern as AdminBilling): commercial follow-up has its own
/// lifecycle and never touches the despacho record.
model ClientNextAction {
  administratorId String    @id @map("administrator_id") @db.Uuid
  nextAction      String?   @map("next_action") @db.VarChar(300)
  nextActionAt    DateTime? @map("next_action_at") @db.Date
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  administrator Administrator @relation(fields: [administratorId], references: [id], onDelete: Cascade)

  @@map("client_next_actions")
}

// ═══════════════════════════════════════════════════════════════════════
// ── 4b. Mensajería directa (usuarios de una misma finca) ───────────────
// ═══════════════════════════════════════════════════════════════════════

/// Conversación 1:1 (sin grupos) entre dos usuarios que comparten al menos
/// una finca — la elegibilidad se valida al crear el primer mensaje
/// (DirectMessagesService), no acá.
model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  participants DirectMessageParticipant[]
  messages     DirectMessage[]

  @@map("conversations")
}

/// Fila por usuario dentro de una conversación — `lastReadAt` es lo que
/// permite calcular "no leídos" en O(1) por conversación en vez de tener
/// que llevar un registro por mensaje (a diferencia de `ResourceRead`,
/// pensado para recursos estáticos tipo Communication/Document).
model DirectMessageParticipant {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  lastReadAt     DateTime? @map("last_read_at") @db.Timestamptz
  /// «Eliminar conversación» para este usuario: sale de su lista pero el historial se conserva
  /// y reaparece, completo, en cuanto llega o se envía un mensaje nuevo. null = visible.
  hiddenAt       DateTime? @map("hidden_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("direct_message_participants")
}

model DirectMessage {
  attachments    DirectMessageAttachment[]
  id             String                    @id @default(uuid()) @db.Uuid
  conversationId String                    @map("conversation_id") @db.Uuid
  senderId       String                    @map("sender_id") @db.Uuid
  text           String
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  /// Última edición del texto por su autor; null = nunca editado.
  editedAt       DateTime?                 @map("edited_at") @db.Timestamptz
  /// Borrado lógico: el mensaje sigue en el hilo como «borrado», sin texto ni adjuntos.
  deletedAt      DateTime?                 @map("deleted_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@map("direct_messages")
}

model DirectMessageAttachment {
  id        String        @id @default(uuid()) @db.Uuid
  messageId String        @map("message_id") @db.Uuid
  name      String        @db.VarChar(255)
  mimeType  String        @map("mime_type") @db.VarChar(150)
  sizeBytes Int           @map("size_bytes")
  s3Key     String        @map("s3_key")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz
  message   DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("direct_message_attachments")
}

/// Equivalente de `PropertyMembershipSettings` para usuarios SIN
/// PropertyMembership (rol A/B) — su identidad no está atada a una unidad
/// concreta, así que este ajuste es global por usuario en vez de por
/// membresía. Misma creación perezosa: ausencia de fila = defaults.
model UserMessagingSettings {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  allowDirectMessages DirectMessagePolicy @default(anyone_linked) @map("allow_direct_messages")
  displayNamePolicy   DisplayNamePolicy   @default(full_name) @map("display_name_policy")
  displayAlias        String?             @map("display_alias") @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_messaging_settings")
}

// ═══════════════════════════════════════════════════════════════════════
// ── 5. Incidencias ──────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════

model Issue {
  id                      String        @id @default(uuid()) @db.Uuid
  ref                     String        @unique @db.VarChar(30)
  /// La comunidad (finca) a la que pertenece. Una incidencia es siempre de la comunidad: no cuelga de una vivienda.
  estateId                String        @map("estate_id") @db.Uuid
  /// Tipo de incidencia (Avería, Fuga…).
  type                    IssueType     @default(Otro)
  /// Zona o instalación afectada, tal y como la indicó quien avisó ("Portal 1", "Piscina", texto libre). Nunca una vivienda.
  location                String?       @db.VarChar(120)
  title                   String        @db.VarChar(200)
  description             String
  status                  IssueStatus
  priority                Priority
  source                  IssueSource
  date                    DateTime      @db.Date
  ownerName               String?       @map("owner_name") @db.VarChar(200)
  budgetAmount            Decimal?      @map("budget_amount") @db.Decimal(10, 2)
  budgetDescription       String?       @map("budget_description")
  budgetApproved          Boolean?      @map("budget_approved")
  /// Vía de gestión decidida por una persona (catálogo en `issue-workflow/resolution-routes.ts`); `null` = sin decidir.
  /// Es el valor vigente; el historial de cambios está en los eventos `route_decided`.
  resolutionRoute         String?       @map("resolution_route") @db.VarChar(30)
  resolvedAt              DateTime?     @map("resolved_at") @db.Timestamptz
  closedAt                DateTime?     @map("closed_at") @db.Timestamptz
  /// Estado al que vuelve la incidencia cuando quien avisó responde a una solicitud de información.
  statusBeforeInfoRequest IssueStatus?  @map("status_before_info_request")
  /// Valoración (1-5) de la resolución y comentario opcional.
  rating                  Int?          @db.SmallInt
  ratingComment           String?       @map("rating_comment")
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt               DateTime?     @map("deleted_at") @db.Timestamptz

  /// Instalación (elemento común) a la que se refiere, si el gestor la indica. Opcional:
  /// una incidencia puede ser de un elemento que no está dado de alta como instalación.
  assetId String? @map("asset_id") @db.Uuid

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Restrict)
  asset  Asset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  photos              IssuePhoto[]
  affected            IssueAffectedUser[]
  timeline            IssueTimelineEntry[]
  providerAssignments IssueProviderAssignment[]
  supplierVisits      SupplierVisit[]
  notifications       IssueNotification[]

  reports         IssueReport[]
  /// Avisos que se recibieron en ESTA incidencia y pasaron a otra al fusionarse (ver IssueReport.originIssueId).
  movedReports    IssueReport[]    @relation("IssueReportOrigin")
  waits           IssueWait[]
  agendaTasks     AgendaTask[]
  insuranceClaims InsuranceClaim[]
  journeyMilestones IssueJourneyMilestone[]

  @@index([estateId, status])
  @@index([assetId])
  @@map("issues")
}

/// An issue attachment: a photo or a document (PDF). The name is historical.
model IssuePhoto {
  id         String   @id @default(uuid()) @db.Uuid
  issueId    String   @map("issue_id") @db.Uuid
  s3Key      String   @map("s3_key") @db.VarChar(500)
  url        String?  @db.VarChar(500)
  fileName   String?  @map("file_name") @db.VarChar(255)
  mimeType   String?  @map("mime_type") @db.VarChar(100)
  size       Int?
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@map("issue_photos")
}

/// «Me afecta también»: un vecino marca una incidencia ya abierta en lugar de abrir un duplicado. No es un aviso (`IssueReport`).
model IssueAffectedUser {
  issueId   String   @map("issue_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([issueId, userId])
  @@map("issue_affected_users")
}

model IssueTimelineEntry {
  id               String             @id @default(uuid()) @db.Uuid
  issueId          String             @map("issue_id") @db.Uuid
  date             DateTime           @db.Timestamptz
  authorUserId     String?            @map("author_user_id") @db.Uuid
  role             TimelineAuthorRole
  text             String
  fromStatus       IssueStatus?       @map("from_status")
  toStatus         IssueStatus?       @map("to_status")
  /// Sin relación Prisma formal (ver nota de cabecera, decisión #5) — es
  /// solo trazabilidad de "en nombre de quién actuó", bajo valor de consulta
  /// agregada. FK lógica a users.id, sin constraint declarativo.
  onBehalfOfUserId String?            @map("on_behalf_of_user_id") @db.Uuid

  /// Qué ocurrió (catálogo en `issue-workflow/issue-event-kinds.ts`). Abierto a propósito:
  /// añadir un tipo de evento no requiere migración. `note` = comentario libre.
  kind      String    @default("note") @db.VarChar(40)
  /// Qué actuó: persona, sistema (regla/cron) o un tercero (proveedor, propietario).
  actorKind ActorKind @default(system) @map("actor_kind")
  /// Puntero al artefacto concreto (AgendaTask, IssueWait, SupplierVisit…); nunca copia su contenido.
  refType   String?   @map("ref_type") @db.VarChar(40)
  refId     String?   @map("ref_id") @db.Uuid
  /// Detalle técnico (modelo, versión de prompt, decisión de política…). Solo para gestión.
  meta      Json?
  /// Interno de la gestión (notas de la gestora, tareas, esperas): nunca se devuelve a quien avisó ni a los vecinos.
  internal  Boolean   @default(false)

  issue      Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorUser User? @relation("IssueTimelineAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([issueId, date])
  @@map("issue_timeline_entries")
}

/// Cada AVISO de un problema: canal de entrada, referencia al mensaje/llamada/
/// formulario original y su contenido tal como llegó. Una incidencia tiene al
/// menos uno; varios propietarios avisando del mismo problema serán varios
/// reportes (al fusionar duplicados se reasignan, no se pierden).
/// `channel` es un catálogo abierto (form | call | email…; ver `issue-report.constants.ts`).
model IssueReport {
  id              String    @id @default(uuid()) @db.Uuid
  issueId         String    @map("issue_id") @db.Uuid
  channel         String    @db.VarChar(20)
  /// Identificador externo: Message-ID del email, id de llamada… Con `channel`, evita registrar dos veces el mismo aviso.
  sourceRef       String?   @map("source_ref") @db.VarChar(200)
  /// Contenido original, sin interpretar.
  content         String
  /// Quien avisa, si es un usuario de Domora; si no (una llamada de alguien sin cuenta), nombre y contacto libres.
  reporterUserId  String?   @map("reporter_user_id") @db.Uuid
  reporterName    String?   @map("reporter_name") @db.VarChar(200)
  reporterContact String?   @map("reporter_contact") @db.VarChar(200)
  receivedAt      DateTime  @map("received_at") @db.Timestamptz
  /// Quién dio de alta el reporte (el propietario por formulario, el gestor que registra una llamada…). Sin FK: bajo valor de consulta, como `onBehalfOfUserId`.
  createdByKind   ActorKind @default(person) @map("created_by_kind")
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /// Solo en un aviso que cambió de incidencia al fusionarse un duplicado de zona común: la incidencia en la que se recibió
  /// originalmente (sigue existiendo, cerrada). Nulo = el aviso nunca se movió.
  originIssueId   String?   @map("origin_issue_id") @db.Uuid

  issue       Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  originIssue Issue? @relation("IssueReportOrigin", fields: [originIssueId], references: [id], onDelete: SetNull)
  reporter    User?  @relation("IssueReportReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)

  @@unique([channel, sourceRef])
  @@index([issueId, receivedAt])
  @@index([originIssueId])
  @@map("issue_reports")
}

/// Lo que espera el expediente FUERA de Domora (un proveedor, un propietario…).
/// Es el tercer eje de la "situación": una persona con trabajo = `AgendaTask`;
/// Un tercero con la pelota = `IssueWait`.
/// Una visita ya programada NO genera espera: sigue siendo `SupplierVisit`.
/// `dueAt` es opcional: sin plazo explícito no hay temporizador, pero la espera cuenta igual.
/// Hay como mucho UNA espera abierta por (incidencia, tipo, referencia): índice único parcial en la migración.
model IssueWait {
  id           String         @id @default(uuid()) @db.Uuid
  issueId      String         @map("issue_id") @db.Uuid
  party        WaitParty
  supplierId   String?        @map("supplier_id") @db.Uuid
  /// Nombre congelado de la parte (como los snapshots de `IssueProviderAssignment`).
  partyLabel   String?        @map("party_label") @db.VarChar(200)
  /// provider_reply… (catálogo en `issue-workflow/issue-wait-kinds.ts`).
  kind         String         @db.VarChar(40)
  refType      String?        @map("ref_type") @db.VarChar(40)
  refId        String?        @map("ref_id") @db.Uuid
  startedAt    DateTime       @map("started_at") @db.Timestamptz
  dueAt        DateTime?      @map("due_at") @db.Timestamptz
  endedAt      DateTime?      @map("ended_at") @db.Timestamptz
  endReason    WaitEndReason? @map("end_reason")
  /// Cuándo se procesó el vencimiento actual (`dueAt`): el barrido de incidencias no lo repite. Se limpia al re-armar.
  dueHandledAt DateTime?      @map("due_handled_at") @db.Timestamptz
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz

  issue    Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([issueId, endedAt])
  @@index([dueAt, endedAt, dueHandledAt])
  @@map("issue_waits")
}

/// Histórico de asignaciones de proveedor. La vigente es la más reciente con
/// `unassignedAt = null`. Snapshot congelado para no alterar el histórico si
/// el proveedor cambia de nombre en `suppliers`.
model IssueProviderAssignment {
  id                      String    @id @default(uuid()) @db.Uuid
  issueId                 String    @map("issue_id") @db.Uuid
  supplierId              String?   @map("supplier_id") @db.Uuid
  providerNameSnapshot    String    @map("provider_name_snapshot") @db.VarChar(200)
  categorySnapshot        String?   @map("category_snapshot") @db.VarChar(150)
  phoneSnapshot           String?   @map("phone_snapshot") @db.VarChar(30)
  estimatedResolutionDate DateTime? @map("estimated_resolution_date") @db.Date
  assignedAt              DateTime  @map("assigned_at") @db.Timestamptz
  /// Quién asignó. `null` cuando lo hizo Domora sola (envío automático autorizado por la política): nunca se atribuye
  /// a la última persona que tocó la política.
  assignedByUserId        String?   @map("assigned_by_user_id") @db.Uuid
  /// `person` (assignedByUserId obligatorio de hecho) | `ai` | `system`.
  assignedByKind          String    @default("person") @map("assigned_by_kind") @db.VarChar(10)
  /// Siniestro de seguro por el que la aseguradora envió a este profesional. `null` = lo asignó la comunidad.
  /// Es lo único que distingue «lo mandó el seguro» de «lo eligió la comunidad»: no hay un campo `origin` aparte.
  claimId                 String?   @map("claim_id") @db.Uuid
  unassignedAt            DateTime? @map("unassigned_at") @db.Timestamptz

  issue          Issue           @relation(fields: [issueId], references: [id], onDelete: Cascade)
  supplier       Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  assignedByUser User?           @relation("IssueProviderAssignedBy", fields: [assignedByUserId], references: [id])
  claim          InsuranceClaim? @relation(fields: [claimId], references: [id], onDelete: SetNull)
  visits         SupplierVisit[]

  @@index([issueId, unassignedAt])
  @@index([claimId])
  @@map("issue_providers")
}

/// Siniestro de seguro de una incidencia. Describe SOLO el expediente del seguro: la próxima actuación, las esperas, las
/// visitas, el profesional enviado y las comunicaciones viven en `AgendaTask`, `IssueWait`, `SupplierVisit`,
/// `IssueProviderAssignment.claimId` y el historial. La aseguradora de la comunidad es un `Supplier` («Seguros»); la
/// póliza, un `SupplierContract`; un seguro privado del propietario no está en el directorio (`insurerSupplierId` nulo).
/// `status` (catálogo en `issue-workflow/insurance-claims.ts`): open | under_assessment | accepted | rejected |
/// withdrawn | closed. Solo `withdrawn` y `closed` son terminales (`closedAt`); un rechazo puede reconsiderarse.
/// Una incidencia puede tener varios siniestros, también de la misma aseguradora. La unicidad de la referencia es por
/// (incidencia, aseguradora, referencia) — índice parcial en la migración.
model InsuranceClaim {
  id                String    @id @default(uuid()) @db.Uuid
  issueId           String    @map("issue_id") @db.Uuid
  insurerSupplierId String?   @map("insurer_supplier_id") @db.Uuid
  /// Nombre congelado de la aseguradora.
  insurerName       String    @map("insurer_name") @db.VarChar(200)
  contractId        String?   @map("contract_id") @db.Uuid
  /// Nº de póliza congelado (el contrato puede cambiar o no existir).
  policyNumber      String?   @map("policy_number") @db.VarChar(50)
  /// Nº de siniestro que da la aseguradora; aún no lo hay al abrirlo.
  reference         String?   @db.VarChar(100)
  status            String    @default("open") @db.VarChar(20)
  openedAt          DateTime  @map("opened_at") @db.Timestamptz
  openedByKind      ActorKind @default(person) @map("opened_by_kind")
  /// Sin relación Prisma formal: solo trazabilidad de quién lo abrió (nulo si no fue una persona).
  openedByUserId    String?   @map("opened_by_user_id") @db.Uuid
  /// Tramitador de ESTE siniestro (no el contacto general de la aseguradora).
  contactName       String?   @map("contact_name") @db.VarChar(200)
  contactPhone      String?   @map("contact_phone") @db.VarChar(30)
  closedAt          DateTime? @map("closed_at") @db.Timestamptz

  issue     Issue                     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  insurer   Supplier?                 @relation(fields: [insurerSupplierId], references: [id], onDelete: SetNull)
  contract  SupplierContract?         @relation(fields: [contractId], references: [id], onDelete: SetNull)
  providers IssueProviderAssignment[]

  @@index([issueId, closedAt])
  @@map("insurance_claims")
}

/// Histórico de envíos de notificación (antes solo se guardaba UN envío).
model IssueNotification {
  id              String              @id @default(uuid()) @db.Uuid
  issueId         String              @map("issue_id") @db.Uuid
  sentAt          DateTime            @map("sent_at") @db.Timestamptz
  recipientsCount Int                 @map("recipients_count")
  channel         NotificationChannel
  sentByUserId    String              @map("sent_by_user_id") @db.Uuid
  subject         String?             @db.VarChar(255)
  body            String?

  issue      Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  sentByUser User  @relation("IssueNotificationSentBy", fields: [sentByUserId], references: [id])

  @@index([issueId, sentAt])
  @@map("issue_notifications")
}

// ═══════════════════════════════════════════════════════════════════════
// ── 6. Comunicados, documentos, lectura por usuario ────────────────────
// ═══════════════════════════════════════════════════════════════════════

model Communication {
  id        String   @id @default(uuid()) @db.Uuid
  estateId  String?  @map("estate_id") @db.Uuid
  title     String   @db.VarChar(255)
  body      String
  date      DateTime @db.Timestamptz
  /// Snapshot del nombre a mostrar — siempre derivado server-side del
  /// usuario autenticado (nunca del cliente), se conserva legible aunque
  /// `authorUser` se borre.
  from      String   @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  authorUserId String? @map("author_user_id") @db.Uuid

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  /// Único estado de archivado persistido — SOLO lo toca la acción manual
  /// de la gestora (`PATCH .../archive`). El vencimiento por `activeUntil`
  /// NO se persiste nunca: se calcula en cada consulta comparando contra la
  /// hora de la request (ver `ResourcesService.computeArchived`).
  archivedByAdmin Boolean   @default(false) @map("archived_by_admin")
  activeUntil     DateTime? @map("active_until") @db.Timestamptz

  /// Traza de edición por un administrador (A/B) sobre un comunicado que no
  /// es suyo — null si nunca lo editó nadie más que el propio autor.
  lastEditedByUserId String?   @map("last_edited_by_user_id") @db.Uuid
  lastEditedAt       DateTime? @map("last_edited_at") @db.Timestamptz

  category CommunicationCategory @default(General)

  /// null = toda la finca; si se fija, solo lo ven rol A/B y los
  /// propietarios con membership vinculado a ESA propiedad — mismo patrón
  /// que Document.targetPropertyId. Solo A/B puede fijarlo (ver
  /// ResourcesService.assertPrivilegedFields).
  targetPropertyId String? @map("target_property_id") @db.Uuid

  /// Fijado manual de la gestora — null = no fijado. Es la fecha, no un
  /// booleano, para que sirva también como clave de orden (un post
  /// refijado más tarde vuelve a subir) — mismo idioma que activeUntil.
  pinnedAt DateTime? @map("pinned_at") @db.Timestamptz

  /// LPH art. 9.1.h — "notificación fehaciente por tablón", último recurso
  /// tras agotar el domicilio designado y el propio piso. Con esta marca,
  /// `date` (inmutable tras la creación, nunca aparece en
  /// UpdateCommunicationDto) es el inicio del cómputo de "tres días
  /// naturales" con pleno efecto legal — se calcula en cada consulta,
  /// nunca se persiste (mismo criterio que `archived`/`activeUntil`, ver
  /// ResourcesService.attachCommunicationDisplayFields).
  isLegalNotice Boolean @default(false) @map("is_legal_notice")

  /// Quién actúa como secretario/a a efectos de la diligencia — reutiliza
  /// MeetingSignerRole (mismo concepto de "etiqueta de cargo comunitario"
  /// que ya usa Meeting; Domora no modela "presidente" como rol de cuenta
  /// real, es una etiqueta libre).
  legalNoticeSignerRole               MeetingSignerRole? @map("legal_notice_signer_role")
  legalNoticeSignerName               String?            @map("legal_notice_signer_name") @db.VarChar(200)
  /// Motivo de la diligencia — por qué se recurrió al tablón (domicilio
  /// desconocido, notificación previa fallida...), exigido por LPH 9.1.h.
  legalNoticeReason                   String?            @map("legal_notice_reason") @db.VarChar(500)
  /// "Visto bueno" del/de la presidente — autoatestado por quien publica,
  /// mismo nivel de confianza documental que Meeting.signerName.
  legalNoticeCountersignedByPresident Boolean            @default(false) @map("legal_notice_countersigned_by_president")

  estate           Estate?                   @relation(fields: [estateId], references: [id], onDelete: SetNull)
  authorUser       User?                     @relation("CommunicationAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  lastEditedByUser User?                     @relation("CommunicationLastEditedBy", fields: [lastEditedByUserId], references: [id], onDelete: SetNull)
  targetProperty   Property?                 @relation(fields: [targetPropertyId], references: [id], onDelete: Cascade)
  replies          CommunicationReply[]
  attachments      CommunicationAttachment[]

  @@index([estateId, date(sort: Desc)])
  @@index([targetPropertyId])
  @@map("communications")
}

enum CommunicationCategory {
  General
  Urgente
  Mercadillo
  ObjetosPerdidos
  Evento
}

/// Hilo de respuestas sobre un comunicado — mismo patrón que
/// IssueTimelineEntry: cualquier rol con acceso al
/// comunicado puede responder, el rol de autoría se infiere server-side
/// (authorRoleFor), sin @Roles en el endpoint. Reutiliza TimelineAuthorRole
/// tal cual.
model CommunicationReply {
  id              String             @id @default(uuid()) @db.Uuid
  communicationId String             @map("communication_id") @db.Uuid
  authorUserId    String?            @map("author_user_id") @db.Uuid
  role            TimelineAuthorRole
  text            String
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz
  /// Baja lógica — permite moderación A/B de una respuesta abusiva sin
  /// perder el registro (mismo criterio que Communication.deletedAt).
  deletedAt       DateTime?          @map("deleted_at") @db.Timestamptz

  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  authorUser    User?         @relation("CommunicationReplyAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([communicationId, createdAt])
  @@map("communication_replies")
}

/// Documentos adjuntos a un comunicado — mismo patrón que MeetingAttachment.
model CommunicationAttachment {
  id              String   @id @default(uuid()) @db.Uuid
  communicationId String   @map("communication_id") @db.Uuid
  title           String   @db.VarChar(255)
  s3Key           String   @map("s3_key") @db.VarChar(500)
  uploadedAt      DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@map("communication_attachments")
}

/// Quién ve un documento (D1 de odd/tasks/documentos-finca.md). Por defecto, el más restrictivo.
enum DocumentVisibility {
  /// Solo la gestora (rol A/B).
  MANAGER
  /// Junta de gobierno: presidente y vicepresidentes con cargo vigente.
  BOARD
  /// Todos los propietarios (y representantes) vinculados de la finca; nunca inquilinos.
  OWNERS
  /// Solo los propietarios de `targetPropertyId`.
  PROPERTY
}

enum DocumentSource {
  upload
  /// Lo genera la aplicación (p. ej. el acta firmada): no se borra ni se renombra desde la biblioteca.
  generated
}

/// Carpeta de la biblioteca de documentos de una finca. La visibilidad la heredan subcarpetas y documentos.
model DocumentFolder {
  id              String              @id @default(uuid()) @db.Uuid
  estateId        String              @map("estate_id") @db.Uuid
  parentId        String?             @map("parent_id") @db.Uuid
  name            String              @db.VarChar(120)
  /// null = hereda de la carpeta padre; en la raíz, null equivale a MANAGER. Nunca PROPERTY.
  visibility      DocumentVisibility?
  /// Carpetas de la plantilla (legal, actas…): no se borran ni se mueven, sí se renombran.
  systemKey       String?             @map("system_key") @db.VarChar(40)
  sortOrder       Int                 @default(0) @map("sort_order")
  createdByUserId String?             @map("created_by_user_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?           @map("deleted_at") @db.Timestamptz

  estate    Estate           @relation(fields: [estateId], references: [id], onDelete: Cascade)
  parent    DocumentFolder?  @relation("DocumentFolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  DocumentFolder[] @relation("DocumentFolderTree")
  documents Document[]

  @@unique([estateId, systemKey])
  @@index([estateId, parentId])
  @@map("document_folders")
}

model Document {
  id                      String              @id @default(uuid()) @db.Uuid
  estateId                String?             @map("estate_id") @db.Uuid
  title                   String              @db.VarChar(255)
  type                    String              @db.VarChar(100)
  date                    DateTime            @db.Date
  size                    String              @db.VarChar(20)
  s3Key                   String?             @map("s3_key") @db.VarChar(500)
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  /// Propiedad destinataria cuando la visibilidad es PROPERTY.
  targetPropertyId        String?             @map("target_property_id") @db.Uuid
  folderId                String?             @map("folder_id") @db.Uuid
  /// null = hereda de su carpeta («Visibilidad propia» cuando no es null).
  visibility              DocumentVisibility?
  /// Visibilidad resultante (propia o heredada), recalculada al cambiar carpetas o documentos.
  /// Es la ÚNICA que usan las consultas de lectura (ver DocumentAccessService).
  effectiveVisibility     DocumentVisibility  @default(MANAGER) @map("effective_visibility")
  mimeType                String?             @map("mime_type") @db.VarChar(100)
  sizeBytes               Int?                @map("size_bytes")
  uploadedByUserId        String?             @map("uploaded_by_user_id") @db.Uuid
  source                  DocumentSource      @default(upload)
  /// Origen de un documento generado (p. ej. `meeting:<id>`): único por finca.
  sourceRef               String?             @map("source_ref") @db.VarChar(100)
  description             String?             @db.VarChar(500)
  /// Era visible para todos los propietarios antes de la biblioteca y quedó «Solo gestora» al migrar.
  visibilityReviewPending Boolean             @default(false) @map("visibility_review_pending")
  /// Papelera: no se borra el fichero.
  deletedAt               DateTime?           @map("deleted_at") @db.Timestamptz

  estate         Estate?         @relation(fields: [estateId], references: [id], onDelete: SetNull)
  targetProperty Property?       @relation(fields: [targetPropertyId], references: [id], onDelete: Cascade)
  folder         DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([estateId, date(sort: Desc)])
  @@index([targetPropertyId])
  @@index([estateId, folderId])
  @@index([estateId, effectiveVisibility])
  @@map("documents")
}

/// Estado de lectura genérico por usuario × recurso. Una sola tabla resuelve
/// el feed de Alertas Y el antiguo `Communication.unread`/`Document.isNew`
/// (que eran booleanos globales, no por destinatario) — ver `ResourceRead`
/// en models.ts.
model ResourceRead {
  userId     String          @map("user_id") @db.Uuid
  sourceType AlertSourceType @map("source_type")
  sourceId   String          @map("source_id") @db.Uuid
  readAt     DateTime        @map("read_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@id([userId, sourceType, sourceId])
  @@map("resource_reads")
}

/// Qué tipo de suceso originó un aviso. Solo las categorías que hoy emite
/// alguien — añadir otra exige un `ALTER TYPE … ADD VALUE` en migración propia.
enum NotificationCategory {
  adhesion
  onboarding
  issue
  direct_message
  inspection
  meeting
  communication
  booking
  receipt
  billing
  task
  /// Documento de la biblioteca abierto a los propietarios.
  document
}

enum NotificationEmailStatus {
  skipped
  sent
  failed
}

/// Aviso persistido para UN destinatario (la bandeja de notificaciones).
/// Modela EVENTOS ("llegó una solicitud de adhesión"); lo que es un ESTADO
/// ("hay 3 solicitudes pendientes") no vive aquí sino en `TasksService`, que
/// lo deriva al vuelo. Las alertas derivadas de `ResourcesService` (recibos,
/// incidencias, comunicados…) tampoco se duplican en esta tabla.
model Notification {
  id          String                  @id @default(uuid()) @db.Uuid
  userId      String                  @map("user_id") @db.Uuid
  category    NotificationCategory
  title       String                  @db.VarChar(200)
  body        String?
  /// Ruta del frontend a la que lleva el aviso (p. ej. `/b/requests`).
  link        String                  @db.VarChar(300)
  estateId    String?                 @map("estate_id") @db.Uuid
  propertyId  String?                 @map("property_id") @db.Uuid
  /// Clave de colapso: mientras exista un aviso NO leído con la misma clave
  /// para el usuario, un nuevo aviso lo refresca en vez de crear otro (p. ej.
  /// varios mensajes de la misma conversación). Índice único parcial en la
  /// migración (`WHERE dedupe_key IS NOT NULL AND read_at IS NULL`).
  dedupeKey   String?                 @map("dedupe_key") @db.VarChar(120)
  readAt      DateTime?               @map("read_at") @db.Timestamptz
  emailStatus NotificationEmailStatus @default(skipped) @map("email_status")
  emailError  String?                 @map("email_error") @db.VarChar(255)
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Preferencia de email por categoría para usuarios SIN membresía (gestora,
/// soporte). Los propietarios (rol C) ya tienen las suyas por vivienda en
/// `PropertyMembershipSettings.notify*`. Sin fila = activado.
model UserNotificationPreference {
  userId       String               @map("user_id") @db.Uuid
  category     NotificationCategory
  emailEnabled Boolean              @default(true) @map("email_enabled")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category])
  @@map("user_notification_preferences")
}

/// Suscripción del navegador (Web Push API) de un dispositivo concreto — un
/// usuario puede tener varias (varios navegadores/dispositivos). Sin VAPID_*
/// configurado, PushService nunca crea filas nuevas, pero el endpoint de
/// alta no depende de eso: el frontend puede suscribirse igual, el envío
/// real simplemente no hace nada hasta que el backend tenga las claves.
model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String   @db.VarChar(200)
  auth      String   @db.VarChar(200)
  userAgent String?  @map("user_agent") @db.VarChar(300)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ═══════════════════════════════════════════════════════════════════════
// ── 7. Contabilidad ─────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════

/// Catálogo de cuentas — por finca (Apéndice H): cada finca tiene su propia
/// configuración contable, sin compartirla con otras fincas de la misma
/// gestora. `administratorId` se mantiene denormalizado (mismo patrón que
/// Property.administratorId) para queries rápidas a nivel gestora.
/// Cuenta del plan contable de una finca. La plantilla de comunidades
/// (ledger/chart/chart-template.ts) crea las cuentas de sistema; la gestora
/// puede añadir subcuentas. Garantías en BD (migración ledger_core): código
/// solo dígitos, el hijo empieza por el código del padre, 6xx gasto y 7xx
/// ingreso, y una cuenta con apuntes no se borra ni cambia de código.
model ChartAccount {
  id               String        @id @default(uuid()) @db.Uuid
  estateId         String        @map("estate_id") @db.Uuid
  administratorId  String        @map("administrator_id") @db.Uuid
  code             String        @db.VarChar(10)
  name             String        @db.VarChar(150)
  shortName        String?       @map("short_name") @db.VarChar(60)
  /// Legado: sin uso, sustituido por `parentId`.
  nature           AccountNature
  parentId         String?       @map("parent_id") @db.Uuid
  level            Int           @default(1)
  /// Una cuenta agrupadora (p. ej. 572 con un banco por subcuenta) no admite apuntes.
  postable         Boolean       @default(true)
  /// Creada por la plantilla: no se borra ni cambia de código.
  system           Boolean       @default(false)
  systemRole       AccountRole?  @map("system_role")
  requiresProperty Boolean       @default(false) @map("requires_property")
  requiresSupplier Boolean       @default(false) @map("requires_supplier")
  allowsCostCentre Boolean       @default(false) @map("allows_cost_centre")
  archivedAt       DateTime?     @map("archived_at") @db.Timestamptz

  estate        Estate         @relation(fields: [estateId], references: [id])
  administrator Administrator  @relation(fields: [administratorId], references: [id])
  parent        ChartAccount?  @relation("ChartAccountTree", fields: [parentId], references: [id], onDelete: Restrict)
  children      ChartAccount[] @relation("ChartAccountTree")

  budgetItems          BudgetItem[]
  journalLines         JournalLine[]
  bankAccount          BankAccount?
  receiptLines         ReceiptLine[]
  supplierInvoiceLines SupplierInvoiceLine[]

  @@unique([estateId, code])
  @@index([parentId])
  @@map("chart_accounts")
}

/// Configuración contable de la finca (1:1). Sin fila, o sin fecha de corte,
/// no se puede contabilizar nada: el trigger de asientos lo impide.
model AccountingSettings {
  estateId                         String                 @id @map("estate_id") @db.Uuid
  /// Fecha de inicio de la contabilidad en Domora. Ningún asiento puede ser
  /// anterior, y el de apertura va exactamente en esta fecha.
  cutoverDate                      DateTime               @map("cutover_date") @db.Date
  /// Valores por defecto del fondo de reserva que se copian a cada ejercicio
  /// nuevo; cada ejercicio puede cambiarlos después.
  defaultReserveMode               ReserveMode            @default(receipt_share) @map("default_reserve_mode")
  /// Parte de cada cuota ordinaria que va a la 117. Sin valor, no se separa nada.
  defaultReserveSharePct           Decimal?               @map("default_reserve_share_pct") @db.Decimal(5, 2)
  /// Regla de la dotación al cierre (modo `year_end_allocation`/`both`) que
  /// heredan los ejercicios nuevos.
  defaultReserveAllocationRule     ReserveAllocationRule? @map("default_reserve_allocation_rule")
  defaultReserveAllocationValue    Decimal?               @map("default_reserve_allocation_value") @db.Decimal(12, 2)
  /// Repercutir al propietario la comisión de una devolución con un recibo de
  /// gastos (ADR, D8). Desactivado: solo si lo permiten los estatutos o la junta.
  returnFeeRecharge                Boolean                @default(false) @map("return_fee_recharge")
  /// La gestora confirmó explícitamente que la finca no arrastra saldos de
  /// antes de cutoverDate — alternativa a contabilizar un OpeningBalanceSet,
  /// para que el paso "Saldos iniciales" de la puesta en marcha se dé por
  /// completado sin forzar un asiento de apertura vacío.
  noPriorBalancesConfirmedAt       DateTime?              @map("no_prior_balances_confirmed_at") @db.Timestamptz
  noPriorBalancesConfirmedByUserId String?                @map("no_prior_balances_confirmed_by_user_id") @db.Uuid
  createdAt                        DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                        DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  estate                         Estate @relation(fields: [estateId], references: [id])
  noPriorBalancesConfirmedByUser User?  @relation("NoPriorBalancesConfirmedBy", fields: [noPriorBalancesConfirmedByUserId], references: [id], onDelete: SetNull)

  @@map("accounting_settings")
}

/// Cuenta bancaria de la comunidad. Cada una tiene su subcuenta 572xxxx.
model BankAccount {
  id               String    @id @default(uuid()) @db.Uuid
  estateId         String    @map("estate_id") @db.Uuid
  chartAccountId   String    @unique @map("chart_account_id") @db.Uuid
  alias            String    @db.VarChar(100)
  /// IBAN cifrado en reposo (sepa/crypto.service.ts, prefijo 'enc:v1:').
  ibanEnc          String?   @map("iban_enc") @db.VarChar(255)
  ibanLast4        String?   @map("iban_last4") @db.VarChar(4)
  bic              String?   @db.VarChar(11)
  bankName         String?   @map("bank_name") @db.VarChar(100)
  isDefault        Boolean   @default(false) @map("is_default")
  isReserveAccount Boolean   @default(false) @map("is_reserve_account")
  openedOn         DateTime? @map("opened_on") @db.Date
  closedAt         DateTime? @map("closed_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  estate       Estate       @relation(fields: [estateId], references: [id])
  chartAccount ChartAccount @relation(fields: [chartAccountId], references: [id])

  remesas              RemesaHistoryItem[]
  collections          Collection[]
  suspenseItems        SuspenseItem[]
  supplierPayments     SupplierPayment[]
  taxSettlements       TaxSettlement[]
  extractEntries       BankExtractEntry[]
  statements           BankStatement[]
  reconciliationGroups ReconciliationGroup[]
  openingBalances      OpeningBankBalance[]

  @@index([estateId])
  @@map("bank_accounts")
}

/// Asiento del libro diario. Inmutable: se corrige con un contraasiento
/// (`reversesEntryId`). Garantías en BD (migración ledger_core): al menos
/// dos líneas, debe = haber al confirmar la transacción, fecha ≥ corte,
/// ejercicio abierto, sin UPDATE ni DELETE.
model JournalEntry {
  id              String           @id @default(uuid()) @db.Uuid
  estateId        String           @map("estate_id") @db.Uuid
  fiscalYear      Int              @map("fiscal_year")
  /// Correlativo sin huecos por finca y ejercicio, en orden de registro.
  number          Int
  date            DateTime         @db.Date
  entryType       JournalEntryType @default(standard) @map("entry_type")
  sourceType      JournalSource    @map("source_type")
  sourceId        String?          @map("source_id") @db.Uuid
  concept         String           @db.VarChar(255)
  reference       String?          @db.VarChar(100)
  reversesEntryId String?          @unique @map("reverses_entry_id") @db.Uuid
  importBatchId   String?          @map("import_batch_id") @db.Uuid
  createdByUserId String?          @map("created_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  /// Transacción que lo creó: las líneas solo se pueden añadir en ella.
  createdXid      BigInt           @default(dbgenerated("txid_current()")) @map("created_xid")

  estate        Estate        @relation(fields: [estateId], references: [id])
  fiscalYearRow FiscalYear    @relation(fields: [estateId, fiscalYear], references: [estateId, year])
  reverses      JournalEntry? @relation("JournalReversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy    JournalEntry? @relation("JournalReversal")
  createdByUser User?         @relation("JournalEntryCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  lines       JournalLine[]
  attachments JournalEntryAttachment[]

  issuedReceipt                   AccountingReceipt?      @relation("ReceiptIssueEntry")
  cancelledReceipt                AccountingReceipt?      @relation("ReceiptCancelEntry")
  remesaCollected                 RemesaHistoryItem?      @relation("RemesaCollectionEntry")
  collections                     Collection[]            @relation("CollectionEntry")
  collectionUndone                Collection?             @relation("CollectionUndoEntry")
  receiptReturn                   ReceiptReturn?          @relation("ReceiptReturnEntry")
  suspenseItem                    SuspenseItem?           @relation("SuspenseItemEntry")
  supplierInvoice                 SupplierInvoice?        @relation("SupplierInvoiceEntry")
  supplierInvoiceCancelled        SupplierInvoice?        @relation("SupplierInvoiceCancelEntry")
  supplierPayment                 SupplierPayment?        @relation("SupplierPaymentEntry")
  supplierPaymentUndone           SupplierPayment?        @relation("SupplierPaymentUndoEntry")
  payroll                         PayrollRecord?          @relation("PayrollEntry")
  payrollCancelled                PayrollRecord?          @relation("PayrollCancelEntry")
  payrollPaid                     PayrollRecord?          @relation("PayrollPaymentEntry")
  taxSettlement                   TaxSettlement?          @relation("TaxSettlementEntry")
  taxSettlementUndone             TaxSettlement?          @relation("TaxSettlementUndoEntry")
  reserveFundApplication          ReserveFundApplication? @relation("ReserveFundApplicationEntry")
  reserveFundApplicationCancelled ReserveFundApplication? @relation("ReserveFundApplicationCancelEntry")
  openingSet                      OpeningBalanceSet?      @relation("OpeningEntry")

  @@unique([estateId, fiscalYear, number])
  @@index([estateId, date])
  @@index([sourceType, sourceId])
  @@map("journal_entries")
}

/// Justificante adjunto a un asiento (factura escaneada, extracto…). Va en
/// tabla aparte porque el asiento es inmutable: adjuntar no lo modifica.
model JournalEntryAttachment {
  id              String   @id @default(uuid()) @db.Uuid
  entryId         String   @map("entry_id") @db.Uuid
  fileName        String   @map("file_name") @db.VarChar(255)
  mimeType        String   @map("mime_type") @db.VarChar(100)
  s3Key           String   @map("s3_key") @db.VarChar(500)
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  entry JournalEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@map("journal_entry_attachments")
}

/// Línea de asiento. `estateId`, `date`, `fiscalYear` y `entryType` se
/// copian del asiento (el trigger los fija). Las dimensiones hacen de
/// subcuentas: la 430 exige propiedad y la 400/410 proveedor; `receiptId` y
/// `supplierInvoiceId` convierten esas cuentas en partidas abiertas.
model JournalLine {
  id                String           @id @default(uuid()) @db.Uuid
  entryId           String           @map("entry_id") @db.Uuid
  lineNo            Int              @map("line_no")
  estateId          String           @map("estate_id") @db.Uuid
  date              DateTime         @db.Date
  fiscalYear        Int              @map("fiscal_year")
  entryType         JournalEntryType @map("entry_type")
  accountId         String           @map("account_id") @db.Uuid
  debit             Decimal          @default(0) @db.Decimal(14, 2)
  credit            Decimal          @default(0) @db.Decimal(14, 2)
  concept           String?          @db.VarChar(255)
  propertyId        String?          @map("property_id") @db.Uuid
  supplierId        String?          @map("supplier_id") @db.Uuid
  costCentreId      String?          @map("cost_centre_id") @db.Uuid
  receiptId         String?          @map("receipt_id") @db.Uuid
  supplierInvoiceId String?          @map("supplier_invoice_id") @db.Uuid

  entry           JournalEntry       @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account         ChartAccount       @relation(fields: [accountId], references: [id])
  property        Property?          @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  supplier        Supplier?          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  costCentre      CostCentre?        @relation(fields: [costCentreId], references: [id], onDelete: Restrict)
  receipt         AccountingReceipt? @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  supplierInvoice SupplierInvoice?   @relation(fields: [supplierInvoiceId], references: [id], onDelete: Restrict)

  reconciliation ReconciliationLine?

  @@unique([entryId, lineNo])
  @@index([estateId, accountId, date])
  @@index([receiptId])
  @@index([supplierInvoiceId])
  @@index([propertyId, accountId])
  @@index([supplierId])
  @@index([costCentreId, fiscalYear])
  @@map("journal_lines")
}

/// Contador de asientos por finca y ejercicio (numeración sin huecos).
model JournalSequence {
  estateId   String @map("estate_id") @db.Uuid
  year       Int
  lastNumber Int    @map("last_number")

  @@id([estateId, year])
  @@map("journal_sequences")
}

/// Proveedores — por finca (Apéndice H), mismo criterio que ChartAccount.
model Supplier {
  id              String        @id @default(uuid()) @db.Uuid
  // Sin @map a propósito: la columna física ya existía como "estateId"
  // (camelCase, sin mapear) desde antes de que este campo pasara a ser
  // obligatorio — cambiar el mapeo sin una migración de rename hubiera
  // dejado al cliente de Prisma buscando una columna "estate_id" inexistente.
  estateId        String        @db.Uuid
  administratorId String        @map("administrator_id") @db.Uuid
  name            String        @db.VarChar(200)
  taxIdCountry    TaxIdCountry? @map("tax_id_country")
  taxId           String?       @map("tax_id") @db.VarChar(20)
  vatNumber       String?       @map("vat_number") @db.VarChar(20)
  category        String        @db.VarChar(100)
  email           String?       @db.VarChar(200)
  phone           String?       @db.VarChar(30)
  iban            String?       @db.VarChar(34)
  /// Persona de contacto en el proveedor (opcional).
  contactName     String?       @map("contact_name") @db.VarChar(200)
  /// Baja lógica, nunca hard-delete — mismo criterio que StaffMember.status
  /// (String libre, no enum): hay facturas/incidencias ya vinculadas.
  status          String        @default("Activo") @db.VarChar(20)
  /// No se declara en el 347 por el art. 33.5 del RGAT (suministros de luz,
  /// agua y combustibles de uso común, y seguros de elementos comunes).
  excludedFrom347 Boolean       @default(false) @map("excluded_from_347")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz

  estate        Estate        @relation(fields: [estateId], references: [id])
  administrator Administrator @relation(fields: [administratorId], references: [id])

  issueProviderLinks IssueProviderAssignment[]
  issueWaits         IssueWait[]
  invoices           SupplierInvoice[]
  journalLines       JournalLine[]
  payments           SupplierPayment[]
  contracts          SupplierContract[]
  assets             Asset[]
  documents          SupplierDocument[]
  correctiveActions  CorrectiveAction[]
  openingInvoices    OpeningSupplierInvoice[]
  visits             SupplierVisit[]
  insuranceClaims    InsuranceClaim[]

  @@index([administratorId])
  @@index([estateId])
  @@map("suppliers")
}

enum SupplierVisitStatus {
  planificada
  realizada
  cancelada
}

/// Visita de un proveedor a la finca (revisión, reparación, presupuesto...).
/// La instalación y la incidencia son opcionales: una visita puede ser de un
/// elemento común sin dar de alta o no estar ligada a ninguna incidencia.
model SupplierVisit {
  id           String              @id @default(uuid()) @db.Uuid
  /// Proveedor del directorio. `null` solo en la visita de un profesional externo (p. ej. enviado por una
  /// aseguradora) que no es proveedor de la comunidad: entonces `assignmentId` es obligatorio (CHECK en la migración)
  /// y el nombre y el teléfono salen del snapshot de esa asignación, sin duplicarse aquí.
  supplierId   String?             @map("supplier_id") @db.Uuid
  assignmentId String?             @map("assignment_id") @db.Uuid
  /// Quién hace la visita cuando no es ni un proveedor del directorio ni el profesional asignado (la visita que cuenta el
  /// propietario, un tercero, una aseguradora sin profesional): solo su nombre, sin darlo de alta. Exclusivo de los dos anteriores.
  visitorLabel String?             @map("visitor_label") @db.VarChar(200)
  estateId     String              @map("estate_id") @db.Uuid
  scheduledAt  DateTime            @map("scheduled_at") @db.Timestamptz
  purpose      String              @db.VarChar(200)
  status       SupplierVisitStatus @default(planificada)
  notes        String?
  assetId      String?             @map("asset_id") @db.Uuid
  issueId      String?             @map("issue_id") @db.Uuid
  completedAt  DateTime?           @map("completed_at") @db.Timestamptz
  cancelledAt  DateTime?           @map("cancelled_at") @db.Timestamptz
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  supplier   Supplier?                @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  assignment IssueProviderAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  asset      Asset?                   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  issue      Issue?                   @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@index([assignmentId])
  @@index([supplierId, scheduledAt])
  @@index([estateId, scheduledAt])
  @@map("supplier_visits")
}

/// "Tácita" = tácita reconducción (renovación automática salvo aviso en
/// contrario) — el término legal español habitual en contratos de
/// mantenimiento de comunidades, no una traducción libre de "automatic".
enum SupplierContractRenewalType {
  manual
  tacita
}

/// Sin campo `status` persistido a propósito — mismo error que ya se
/// corrigió en la tarea 12 con Debtor.amount (materializado, sin ningún
/// proceso que lo sincronizara). "Activo"/"Por vencer"/"Vencido" se derivan
/// SIEMPRE al leer, comparando `endDate` con hoy — ver
/// SuppliersService.deriveContractStatus.
model SupplierContract {
  id              String                      @id @default(uuid()) @db.Uuid
  supplierId      String                      @map("supplier_id") @db.Uuid
  estateId        String                      @map("estate_id") @db.Uuid
  serviceType     String                      @map("service_type") @db.VarChar(100)
  /// Nº de contrato o de póliza (seguros) que da el proveedor.
  contractNumber  String?                     @map("contract_number") @db.VarChar(50)
  startDate       DateTime                    @map("start_date") @db.Date
  endDate         DateTime?                   @map("end_date") @db.Date
  renewalType     SupplierContractRenewalType @map("renewal_type")
  costAmount      Decimal?                    @map("cost_amount") @db.Decimal(12, 2)
  costFrequency   ContractCostFrequency?      @map("cost_frequency")
  currency        String                      @default("EUR") @db.VarChar(3)
  /// Cadencia de revisión SUGERIDA por categoría (ascensores/extintores
  /// tienen periodicidad legal propia) — texto libre, nunca validado contra
  /// una lista cerrada: cada comunidad puede tener condiciones distintas.
  reviewFrequency String?                     @map("review_frequency") @db.VarChar(50)
  cancelledAt     DateTime?                   @map("cancelled_at") @db.Timestamptz
  cancelledReason String?                     @map("cancelled_reason")
  notes           String?
  createdAt       DateTime                    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime                    @updatedAt @map("updated_at") @db.Timestamptz

  supplier        Supplier                  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  documents       SupplierDocument[]
  renewals        SupplierContractRenewal[]
  insuranceClaims InsuranceClaim[]

  @@index([supplierId])
  @@index([estateId])
  @@map("supplier_contracts")
}

/// Histórico de renovaciones de un contrato: se registra cada vez que el gestor lo renueva
/// (acción «Renovar»), con el vencimiento anterior y el nuevo y el importe vigente en ese momento.
/// `kind` reutiliza el tipo de renovación del contrato: hoy solo se escriben renovaciones `manual`;
/// la renovación tácita automática queda para una fase posterior.
model SupplierContractRenewal {
  id              String                      @id @default(uuid()) @db.Uuid
  contractId      String                      @map("contract_id") @db.Uuid
  estateId        String                      @map("estate_id") @db.Uuid
  renewedAt       DateTime                    @map("renewed_at") @db.Date
  previousEndDate DateTime?                   @map("previous_end_date") @db.Date
  newEndDate      DateTime                    @map("new_end_date") @db.Date
  costAmount      Decimal?                    @map("cost_amount") @db.Decimal(12, 2)
  costFrequency   ContractCostFrequency?      @map("cost_frequency")
  currency        String                      @default("EUR") @db.VarChar(3)
  kind            SupplierContractRenewalType @default(manual)
  notes           String?
  /// Sin relación Prisma formal: solo trazabilidad de quién renovó.
  renewedByUserId String?                     @map("renewed_by_user_id") @db.Uuid
  createdAt       DateTime                    @default(now()) @map("created_at") @db.Timestamptz

  contract SupplierContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([estateId, renewedAt(sort: Desc)])
  @@map("supplier_contract_renewals")
}

enum SupplierDocumentType {
  Contrato
  Seguro
  Certificado
  Presupuesto
  Otro
}

/// Documentos del proveedor en general (calco de StaffDocument) — a
/// diferencia del adjunto único de SupplierInvoice, un proveedor acumula
/// varios documentos con ciclo de vida propio (un seguro RC vence por su
/// cuenta, independientemente de las fechas del contrato).
model SupplierDocument {
  id           String               @id @default(uuid()) @db.Uuid
  supplierId   String               @map("supplier_id") @db.Uuid
  /// Opcional: un documento puede ser del proveedor en general (p. ej. un
  /// presupuesto comparativo antes de firmar) sin estar atado a un contrato
  /// concreto todavía.
  contractId   String?              @map("contract_id") @db.Uuid
  documentType SupplierDocumentType @map("document_type")
  title        String               @db.VarChar(255)
  fileName     String               @map("file_name") @db.VarChar(255)
  mimeType     String               @map("mime_type") @db.VarChar(100)
  s3Key        String               @map("s3_key") @db.VarChar(500)
  expiresAt    DateTime?            @map("expires_at") @db.Date
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz

  supplier Supplier          @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  contract SupplierContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@index([supplierId])
  @@index([contractId])
  @@map("supplier_documents")
}

/// Registro de "Registrar factura" en la pestaña Proveedores — con adjunto
/// opcional (factura escaneada, ver fileName/mimeType/s3Key más abajo).
/// Factura recibida de un proveedor (fase 7). Registrarla contabiliza el
/// gasto: Debe 6xx por línea (base más IVA no deducible, D10) / Haber 400 o
/// 410 por lo que hay que pagar y 4751 por la retención de IRPF. No se
/// edita: se anula (sin pagos) y se registra otra.
model SupplierInvoice {
  id                 String                @id @default(uuid()) @db.Uuid
  estateId           String                @map("estate_id") @db.Uuid
  supplierId         String                @map("supplier_id") @db.Uuid
  /// Número que pone el proveedor. Único por proveedor entre las no anuladas.
  number             String                @db.VarChar(60)
  concept            String                @db.VarChar(300)
  issueDate          DateTime              @map("issue_date") @db.Date
  /// Fecha contable: la de recepción, o la de la factura si no se indica.
  receivedDate       DateTime              @map("received_date") @db.Date
  dueDate            DateTime?             @map("due_date") @db.Date
  baseAmount         Decimal               @map("base_amount") @db.Decimal(12, 2)
  vatRatePct         Decimal               @map("vat_rate_pct") @db.Decimal(5, 2)
  vatAmount          Decimal               @map("vat_amount") @db.Decimal(12, 2)
  withholdingRatePct Decimal               @map("withholding_rate_pct") @db.Decimal(5, 2)
  withholdingAmount  Decimal               @map("withholding_amount") @db.Decimal(12, 2)
  withholdingKey     WithholdingKey?       @map("withholding_key")
  /// base + IVA: el gasto total.
  total              Decimal               @db.Decimal(12, 2)
  /// total − retención: lo que se paga al proveedor.
  payable            Decimal               @db.Decimal(12, 2)
  /// 400 o 410 (ADR, D9).
  payableRole        AccountRole           @map("payable_role")
  status             SupplierInvoiceStatus @default(Registrada)
  /// Lo que queda por pagar. Caché verificada contra la partida abierta.
  outstanding        Decimal               @db.Decimal(12, 2)
  entryId            String?               @unique @map("entry_id") @db.Uuid
  cancelEntryId      String?               @unique @map("cancel_entry_id") @db.Uuid
  /// Solo en facturas nacidas de un saldo inicial: el set de apertura que
  /// la creó. `entryId` se deja sin informar (comparte el asiento único del
  /// set); esto exime del desglose de líneas 6xx habitual — ver la
  /// migración ledger_opening_balances.
  openingSetId       String?               @map("opening_set_id") @db.Uuid
  openingInvoiceId   String?               @unique @map("opening_invoice_id") @db.Uuid
  cancelledAt        DateTime?             @map("cancelled_at") @db.Timestamptz
  cancelledByUserId  String?               @map("cancelled_by_user_id") @db.Uuid
  cancelReason       String?               @map("cancel_reason") @db.VarChar(255)
  createdByUserId    String?               @map("created_by_user_id") @db.Uuid
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz
  /// Adjunto opcional (factura escaneada) — siempre privado a rol A/B.
  fileName           String?               @map("file_name") @db.VarChar(255)
  mimeType           String?               @map("mime_type") @db.VarChar(100)
  s3Key              String?               @map("s3_key") @db.VarChar(500)

  estate         Estate                  @relation(fields: [estateId], references: [id])
  supplier       Supplier                @relation(fields: [supplierId], references: [id])
  entry          JournalEntry?           @relation("SupplierInvoiceEntry", fields: [entryId], references: [id], onDelete: Restrict)
  cancelEntry    JournalEntry?           @relation("SupplierInvoiceCancelEntry", fields: [cancelEntryId], references: [id], onDelete: Restrict)
  openingSet     OpeningBalanceSet?      @relation(fields: [openingSetId], references: [id], onDelete: SetNull)
  openingInvoice OpeningSupplierInvoice? @relation("OpeningSupplierInvoiceInvoice", fields: [openingInvoiceId], references: [id], onDelete: SetNull)

  lines                   SupplierInvoiceLine[]
  journalLines            JournalLine[]
  reserveFundApplications ReserveFundApplication[]

  @@index([supplierId])
  @@index([estateId, status])
  @@index([estateId, receivedDate])
  @@index([openingSetId])
  @@map("supplier_invoices")
}

/// Línea de gasto de una factura: a qué cuenta 6xx (y centro de coste) va.
/// `amount` es lo que se carga en la cuenta: la base de la línea más su parte
/// del IVA. Las líneas suman el total de la factura.
model SupplierInvoiceLine {
  id           String  @id @default(uuid()) @db.Uuid
  invoiceId    String  @map("invoice_id") @db.Uuid
  lineNo       Int     @map("line_no")
  accountId    String  @map("account_id") @db.Uuid
  costCentreId String? @map("cost_centre_id") @db.Uuid
  description  String? @db.VarChar(255)
  baseAmount   Decimal @map("base_amount") @db.Decimal(12, 2)
  amount       Decimal @db.Decimal(12, 2)

  invoice    SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  account    ChartAccount    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  costCentre CostCentre?     @relation(fields: [costCentreId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, lineNo])
  @@map("supplier_invoice_lines")
}

/// Pago a un proveedor. Lo que salda de cada factura son las líneas de su
/// asiento (Debe 400/410 con la factura). No se edita: se deshace.
model SupplierPayment {
  id              String    @id @default(uuid()) @db.Uuid
  estateId        String    @map("estate_id") @db.Uuid
  supplierId      String    @map("supplier_id") @db.Uuid
  date            DateTime  @db.Date
  amount          Decimal   @db.Decimal(12, 2)
  method          PayMethod
  /// null = caja (efectivo).
  bankAccountId   String?   @map("bank_account_id") @db.Uuid
  entryId         String    @unique @map("entry_id") @db.Uuid
  notes           String?   @db.VarChar(255)
  undoneAt        DateTime? @map("undone_at") @db.Timestamptz
  undoneByUserId  String?   @map("undone_by_user_id") @db.Uuid
  undoReason      String?   @map("undo_reason") @db.VarChar(255)
  undoEntryId     String?   @unique @map("undo_entry_id") @db.Uuid
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  estate      Estate        @relation(fields: [estateId], references: [id])
  supplier    Supplier      @relation(fields: [supplierId], references: [id])
  bankAccount BankAccount?  @relation(fields: [bankAccountId], references: [id])
  entry       JournalEntry  @relation("SupplierPaymentEntry", fields: [entryId], references: [id], onDelete: Restrict)
  undoEntry   JournalEntry? @relation("SupplierPaymentUndoEntry", fields: [undoEntryId], references: [id], onDelete: Restrict)

  @@index([estateId, date])
  @@index([supplierId])
  @@map("supplier_payments")
}

/// Personal contratado directamente por la finca (portero, seguridad,
/// socorrista...) — a diferencia de Supplier, tiene relación laboral, no
/// mercantil. Mismo tenant scoping por finca (Apéndice H).
model StaffMember {
  id              String    @id @default(uuid()) @db.Uuid
  estateId        String    @map("estate_id") @db.Uuid
  administratorId String    @map("administrator_id") @db.Uuid
  fullName        String    @map("full_name") @db.VarChar(200)
  position        String    @db.VarChar(100)
  nationalId      String?   @map("national_id") @db.VarChar(20)
  email           String?   @db.VarChar(200)
  phone           String?   @db.VarChar(30)
  contractType    String    @map("contract_type") @db.VarChar(50)
  startDate       DateTime  @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  schedule        String?   @db.VarChar(200)
  monthlyCost     Decimal?  @map("monthly_cost") @db.Decimal(10, 2)
  status          String    @default("Activo") @db.VarChar(20)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  estate        Estate          @relation(fields: [estateId], references: [id])
  administrator Administrator   @relation(fields: [administratorId], references: [id])
  documents     StaffDocument[]
  payrolls      PayrollRecord[]

  @@index([administratorId])
  @@index([estateId])
  @@map("staff_members")
}

/// Nómina registrada a mano (fase 7c, ADR D23): los importes los calcula la
/// gestoría laboral y aquí se contabilizan. Registrarla: Debe 640 bruto y
/// 642 Seguridad Social de la comunidad / Haber 476 (Seguridad Social total),
/// 4751 (IRPF) y 465 (neto a pagar). Pagarla: Debe 465 / Haber banco. La
/// retención cuenta para el 111 y el 190 (clave A) en la fecha de pago.
model PayrollRecord {
  id              String        @id @default(uuid()) @db.Uuid
  estateId        String        @map("estate_id") @db.Uuid
  staffMemberId   String        @map("staff_member_id") @db.Uuid
  /// Mes de la nómina, AAAA-MM.
  period          String        @db.VarChar(7)
  kind            PayrollKind   @default(mensual)
  /// Fecha contable del devengo (normalmente, último día del mes).
  accrualDate     DateTime      @map("accrual_date") @db.Date
  grossSalary     Decimal       @map("gross_salary") @db.Decimal(10, 2)
  /// Cuota obrera: la parte de Seguridad Social que se descuenta al empleado.
  employeeSs      Decimal       @map("employee_ss") @db.Decimal(10, 2)
  /// Cuota patronal: la que paga la comunidad además del bruto.
  employerSs      Decimal       @map("employer_ss") @db.Decimal(10, 2)
  irpfWithholding Decimal       @map("irpf_withholding") @db.Decimal(10, 2)
  /// bruto − cuota obrera − IRPF.
  netPay          Decimal       @map("net_pay") @db.Decimal(10, 2)
  status          PayrollStatus @default(Registrada)
  entryId         String?       @unique @map("entry_id") @db.Uuid
  paidDate        DateTime?     @map("paid_date") @db.Date
  paymentEntryId  String?       @unique @map("payment_entry_id") @db.Uuid
  paymentBankId   String?       @map("payment_bank_id") @db.Uuid
  cancelEntryId   String?       @unique @map("cancel_entry_id") @db.Uuid
  cancelledAt     DateTime?     @map("cancelled_at") @db.Timestamptz
  cancelReason    String?       @map("cancel_reason") @db.VarChar(255)
  notes           String?       @db.VarChar(255)
  createdByUserId String?       @map("created_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz

  estate                  Estate                   @relation(fields: [estateId], references: [id])
  staffMember             StaffMember              @relation(fields: [staffMemberId], references: [id])
  entry                   JournalEntry?            @relation("PayrollEntry", fields: [entryId], references: [id], onDelete: Restrict)
  paymentEntry            JournalEntry?            @relation("PayrollPaymentEntry", fields: [paymentEntryId], references: [id], onDelete: Restrict)
  cancelEntry             JournalEntry?            @relation("PayrollCancelEntry", fields: [cancelEntryId], references: [id], onDelete: Restrict)
  reserveFundApplications ReserveFundApplication[]

  @@index([estateId, period])
  @@index([staffMemberId])
  @@map("payroll_records")
}

/// Ingreso en Hacienda de las retenciones de un trimestre (modelo 111, Debe
/// 4751) o pago de las cuotas de la Seguridad Social de un mes (Debe 476),
/// contra el banco. No se edita: se deshace.
model TaxSettlement {
  id              String            @id @default(uuid()) @db.Uuid
  estateId        String            @map("estate_id") @db.Uuid
  kind            TaxSettlementKind
  /// '2026-T1' para el 111; '2026-03' para la Seguridad Social.
  period          String            @db.VarChar(7)
  date            DateTime          @db.Date
  amount          Decimal           @db.Decimal(12, 2)
  bankAccountId   String?           @map("bank_account_id") @db.Uuid
  /// Número de justificante (NRC) o referencia del pago.
  reference       String?           @db.VarChar(40)
  entryId         String            @unique @map("entry_id") @db.Uuid
  undoneAt        DateTime?         @map("undone_at") @db.Timestamptz
  undoReason      String?           @map("undo_reason") @db.VarChar(255)
  undoEntryId     String?           @unique @map("undo_entry_id") @db.Uuid
  createdByUserId String?           @map("created_by_user_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz

  estate      Estate        @relation(fields: [estateId], references: [id])
  bankAccount BankAccount?  @relation(fields: [bankAccountId], references: [id])
  entry       JournalEntry  @relation("TaxSettlementEntry", fields: [entryId], references: [id], onDelete: Restrict)
  undoEntry   JournalEntry? @relation("TaxSettlementUndoEntry", fields: [undoEntryId], references: [id], onDelete: Restrict)

  @@index([estateId, kind, period])
  @@map("tax_settlements")
}

/// Liberación del fondo de reserva (117 → 746) para una de las finalidades
/// tasadas del art. 9.1.f LPH — nunca para gastos ordinarios, que tienen
/// "una finalidad totalmente independiente" de la del fondo. El motivo y la
/// referencia al acta son obligatorios: es la traza de cumplimiento que la
/// ley exige de hecho, aunque no monte un procedimiento propio para pedirla
/// (la disposición va atada al acuerdo de junta que aprueba la obra o el
/// contrato, no a un trámite aparte). El gasto real de la obra se
/// contabiliza aparte, como cualquier factura o nómina normal en su propia
/// 6xx — esto es solo la reclasificación 117→746 que evita que ese gasto
/// distorsione el resultado del ejercicio (D4 de la ADR). El vínculo a la
/// factura o nómina que motivó la liberación es opcional a propósito: sin
/// vínculo sigue siendo válido (p. ej. un contrato de mantenimiento pagado
/// fuera de Domora), pero cuando existe deja la traza automática entre el
/// gasto real y lo liberado.
model ReserveFundApplication {
  id                       String               @id @default(uuid()) @db.Uuid
  estateId                 String               @map("estate_id") @db.Uuid
  date                     DateTime             @db.Date
  amount                   Decimal              @db.Decimal(12, 2)
  reason                   ReserveFundUseReason
  concept                  String               @db.VarChar(255)
  meetingReference         String               @map("meeting_reference") @db.VarChar(255)
  relatedSupplierInvoiceId String?              @map("related_supplier_invoice_id") @db.Uuid
  relatedPayrollId         String?              @map("related_payroll_id") @db.Uuid
  entryId                  String               @unique @map("entry_id") @db.Uuid
  cancelledAt              DateTime?            @map("cancelled_at") @db.Timestamptz
  cancelReason             String?              @map("cancel_reason") @db.VarChar(255)
  cancelEntryId            String?              @unique @map("cancel_entry_id") @db.Uuid
  createdByUserId          String?              @map("created_by_user_id") @db.Uuid
  createdAt                DateTime             @default(now()) @map("created_at") @db.Timestamptz

  estate                 Estate           @relation(fields: [estateId], references: [id])
  relatedSupplierInvoice SupplierInvoice? @relation(fields: [relatedSupplierInvoiceId], references: [id], onDelete: SetNull)
  relatedPayroll         PayrollRecord?   @relation(fields: [relatedPayrollId], references: [id], onDelete: SetNull)
  entry                  JournalEntry     @relation("ReserveFundApplicationEntry", fields: [entryId], references: [id], onDelete: Restrict)
  cancelEntry            JournalEntry?    @relation("ReserveFundApplicationCancelEntry", fields: [cancelEntryId], references: [id], onDelete: Restrict)

  @@index([estateId, date])
  @@map("reserve_fund_applications")
}

/// Adjuntos de personal (DNI, contrato, certificados) — a diferencia de
/// SupplierInvoice, una persona puede tener varios documentos, así que va
/// en tabla propia en vez de columnas inline.
model StaffDocument {
  id            String   @id @default(uuid()) @db.Uuid
  staffMemberId String   @map("staff_member_id") @db.Uuid
  title         String   @db.VarChar(255)
  fileName      String   @map("file_name") @db.VarChar(255)
  mimeType      String   @map("mime_type") @db.VarChar(100)
  s3Key         String   @map("s3_key") @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@index([staffMemberId])
  @@map("staff_documents")
}

/// Partida de un extracto bancario: lo que dice el banco que pasó en la
/// cuenta. Se concilia con las líneas del diario de esa cuenta (572xxxx).
model BankExtractEntry {
  id                    String   @id @default(uuid()) @db.Uuid
  estateId              String   @map("estate_id") @db.Uuid
  bankAccountId         String   @map("bank_account_id") @db.Uuid
  statementId           String?  @map("statement_id") @db.Uuid
  date                  DateTime @db.Date
  concept               String
  /// Positivo: entra dinero; negativo: sale.
  amount                Decimal  @db.Decimal(12, 2)
  bankRef               String?  @map("bank_ref") @db.VarChar(100)
  importedAt            DateTime @default(now()) @map("imported_at") @db.Timestamptz
  importBatchId         String?  @map("import_batch_id") @db.Uuid
  reconciliationGroupId String?  @map("reconciliation_group_id") @db.Uuid

  estate              Estate               @relation(fields: [estateId], references: [id])
  bankAccount         BankAccount          @relation(fields: [bankAccountId], references: [id])
  statement           BankStatement?       @relation(fields: [statementId], references: [id], onDelete: SetNull)
  reconciliationGroup ReconciliationGroup? @relation(fields: [reconciliationGroupId], references: [id], onDelete: SetNull)

  @@index([estateId, date(sort: Desc)])
  @@index([bankAccountId, date])
  @@index([reconciliationGroupId])
  @@map("bank_extract_entries")
}

/// Fichero de extracto importado (Norma 43 o CSV). El mismo fichero dos
/// veces en la misma cuenta es el mismo extracto (hash).
model BankStatement {
  id               String    @id @default(uuid()) @db.Uuid
  estateId         String    @map("estate_id") @db.Uuid
  bankAccountId    String    @map("bank_account_id") @db.Uuid
  fileName         String    @map("file_name") @db.VarChar(255)
  fileHash         String    @map("file_hash") @db.VarChar(64)
  format           String    @db.VarChar(10)
  periodFrom       DateTime? @map("period_from") @db.Date
  periodTo         DateTime? @map("period_to") @db.Date
  openingBalance   Decimal?  @map("opening_balance") @db.Decimal(12, 2)
  closingBalance   Decimal?  @map("closing_balance") @db.Decimal(12, 2)
  entriesCount     Int       @map("entries_count")
  importedByUserId String?   @map("imported_by_user_id") @db.Uuid
  importedAt       DateTime  @default(now()) @map("imported_at") @db.Timestamptz

  estate      Estate             @relation(fields: [estateId], references: [id])
  bankAccount BankAccount        @relation(fields: [bankAccountId], references: [id])
  entries     BankExtractEntry[]

  @@unique([bankAccountId, fileHash])
  @@index([estateId, importedAt(sort: Desc)])
  @@map("bank_statements")
}

/// Conciliación: unas partidas del extracto y unas líneas del diario de la
/// misma cuenta bancaria que suman lo mismo (n:m; la pantalla hace n:1).
model ReconciliationGroup {
  id              String                    @id @default(uuid()) @db.Uuid
  estateId        String                    @map("estate_id") @db.Uuid
  bankAccountId   String                    @map("bank_account_id") @db.Uuid
  method          ReconciliationMatchMethod
  createdByUserId String?                   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz

  estate      Estate               @relation(fields: [estateId], references: [id])
  bankAccount BankAccount          @relation(fields: [bankAccountId], references: [id])
  entries     BankExtractEntry[]
  lines       ReconciliationLine[]

  @@index([bankAccountId])
  @@map("reconciliation_groups")
}

/// Línea del diario conciliada (la línea es inmutable: el vínculo va aparte).
model ReconciliationLine {
  groupId       String @map("group_id") @db.Uuid
  journalLineId String @unique @map("journal_line_id") @db.Uuid

  group       ReconciliationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  journalLine JournalLine         @relation(fields: [journalLineId], references: [id], onDelete: Restrict)

  @@id([groupId, journalLineId])
  @@map("reconciliation_lines")
}

model BudgetItem {
  id         String  @id @default(uuid()) @db.Uuid
  estateId   String  @map("estate_id") @db.Uuid
  accountId  String  @map("account_id") @db.Uuid
  category   String  @db.VarChar(150)
  fiscalYear Int     @map("fiscal_year")
  budgeted   Decimal @db.Decimal(12, 2)

  estate  Estate       @relation(fields: [estateId], references: [id])
  account ChartAccount @relation(fields: [accountId], references: [id])

  @@unique([estateId, accountId, fiscalYear])
  @@map("budget_items")
}

/// Centro de coste — dimensión transversal por finca (Apéndice H),
/// independiente del plan contable: una zona/amenidad concreta (piscina,
/// ascensor portal A, jardín) que puede cruzar varias cuentas contables. NO
/// sustituye a ChartAccount — es una segunda dimensión ortogonal, mismo
/// esqueleto que Supplier/StaffMember: catálogo por finca, baja lógica
/// (`status`, String libre, nunca hard-delete porque puede haber
/// movimientos ya etiquetados).
model CostCentre {
  id              String   @id @default(uuid()) @db.Uuid
  estateId        String   @map("estate_id") @db.Uuid
  administratorId String   @map("administrator_id") @db.Uuid
  name            String   @db.VarChar(150)
  description     String?
  status          String   @default("Activo") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  estate        Estate        @relation(fields: [estateId], references: [id])
  administrator Administrator @relation(fields: [administratorId], references: [id])

  budgets              CostCentreBudget[]
  journalLines         JournalLine[]
  receiptLines         ReceiptLine[]
  supplierInvoiceLines SupplierInvoiceLine[]

  @@unique([estateId, name])
  @@index([administratorId])
  @@index([estateId])
  @@map("cost_centres")
}

/// Presupuesto por centro de coste — tabla PROPIA, no una columna en
/// BudgetItem. Motivo: el unique de BudgetItem es [estateId, accountId,
/// fiscalYear] con accountId obligatorio; si costCentreId se colgara ahí
/// como columna nullable, Postgres trata cada NULL como distinto dentro de
/// un índice único y dejaría crear filas "sin centro" duplicadas sin
/// límite, rompiendo la invariante de una fila por cuenta/año que ya usa
/// upsertBudgetItem. Con tabla separada y clave 100% no-nula el problema no
/// existe. `executed` se deriva igual que BudgetItem.executed (groupBy en
/// vivo sobre las líneas del diario) — nunca se persiste.
model CostCentreBudget {
  id           String  @id @default(uuid()) @db.Uuid
  estateId     String  @map("estate_id") @db.Uuid
  costCentreId String  @map("cost_centre_id") @db.Uuid
  fiscalYear   Int     @map("fiscal_year")
  budgeted     Decimal @db.Decimal(12, 2)

  estate     Estate     @relation(fields: [estateId], references: [id])
  costCentre CostCentre @relation(fields: [costCentreId], references: [id])

  @@unique([estateId, costCentreId, fiscalYear])
  @@map("cost_centre_budgets")
}

enum FiscalYearStatus {
  Abierto
  Cerrado
}

/// Ejercicio contable — home real para la aprobación en junta y el cierre
/// ("liquidación del ejercicio", LPH). Se crea de forma perezosa SOLO en
/// escritura (mismo criterio que AccountingPeriod.upsert en
/// AccountingService.generateReceipts, nunca en el path de lectura): un año
/// nunca tocado no tiene fila aquí, `FiscalYearsService.getFiscalYear`
/// sintetiza un valor virtual (Abierto, 1 ene-31 dic) para mostrarlo sin
/// escribir nada. `fiscalYear` en BudgetItem/CostCentreBudget
/// sigue siendo un Int suelto (sin FK a este modelo): retrofitear una FK
/// obligatoria exigiría backfillear años históricos que nunca tuvieron un
/// FiscalYear creado.
model FiscalYear {
  id                     String                 @id @default(uuid()) @db.Uuid
  estateId               String                 @map("estate_id") @db.Uuid
  year                   Int
  startDate              DateTime               @map("start_date") @db.Date
  endDate                DateTime               @map("end_date") @db.Date
  status                 FiscalYearStatus       @default(Abierto)
  approvedAt             DateTime?              @map("approved_at") @db.Timestamptz
  approvedNote           String?                @map("approved_note")
  closedAt               DateTime?              @map("closed_at") @db.Timestamptz
  closedByUserId         String?                @map("closed_by_user_id") @db.Uuid
  /// Solo si se reabrió tras haberse cerrado (fase 11) — auditado también en ActivityLog.
  reopenedAt             DateTime?              @map("reopened_at") @db.Timestamptz
  reopenReason           String?                @map("reopen_reason")
  /// Fondo de reserva de este ejercicio (copiado de AccountingSettings al
  /// crearlo). Los recibos ya emitidos no cambian si se modifica.
  reserveMode            ReserveMode            @default(receipt_share) @map("reserve_mode")
  reserveSharePct        Decimal?               @map("reserve_share_pct") @db.Decimal(5, 2)
  /// Dotación al cierre (modo B/both, ADR D3) — copiada de AccountingSettings
  /// al crearse, editable mientras el ejercicio siga abierto.
  reserveAllocationRule  ReserveAllocationRule? @map("reserve_allocation_rule")
  /// Su significado depende de la regla: importe fijo en euros, o % del
  /// resultado. Sin uso en `top_up_to_legal_minimum`.
  reserveAllocationValue Decimal?               @map("reserve_allocation_value") @db.Decimal(12, 2)

  estate       Estate @relation(fields: [estateId], references: [id])
  closedByUser User?  @relation("FiscalYearClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)

  journalEntries JournalEntry[]

  @@unique([estateId, year])
  @@map("fiscal_years")
}

// ── Saldos iniciales (fase 9 de doc/contabilidad/roadmap-partida-doble.md) ──

enum OpeningBalanceSetStatus {
  Borrador
  Contabilizado
  Sustituido
}

/// Qué absorbe la diferencia de cuadre del asiento de apertura (ADR, D17).
enum OpeningDifferenceRole {
  reserve_fund
  retained
}

/// Saldos con los que arranca la contabilidad de la finca en Domora —el
/// asiento de apertura, no un recibo o una factura del día a día. Ciclo:
/// Borrador (las filas hijas se editan libremente) -> Contabilizado (un
/// único asiento con entryType='opening', exactamente en cutoverDate) ->
/// si se rehace (`repost`), el set pasa a Sustituido y uno nuevo ocupa su
/// lugar, encadenado por `supersedesId` — nunca se edita lo contabilizado
/// (ADR, D19: mismo criterio que recibos y facturas).
model OpeningBalanceSet {
  id       String                  @id @default(uuid()) @db.Uuid
  estateId String                  @map("estate_id") @db.Uuid
  status   OpeningBalanceSetStatus @default(Borrador)

  /// Diferencia entre el debe y el haber antes de aplicar el plug — se
  /// recalcula en cada `validate()`/`post()`, nunca se confía en un valor
  /// guardado de una edición anterior del borrador.
  difference                 Decimal?               @db.Decimal(12, 2)
  differenceRole             OpeningDifferenceRole? @map("difference_role")
  differenceAccepted         Boolean                @default(false) @map("difference_accepted")
  differenceAcceptedByUserId String?                @map("difference_accepted_by_user_id") @db.Uuid

  /// El asiento único de apertura, exactamente en accounting_settings.cutover_date.
  entryId String? @unique @map("entry_id") @db.Uuid

  supersedesId   String?   @unique @map("supersedes_id") @db.Uuid
  postedAt       DateTime? @map("posted_at") @db.Timestamptz
  postedByUserId String?   @map("posted_by_user_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  estate                   Estate             @relation(fields: [estateId], references: [id])
  entry                    JournalEntry?      @relation("OpeningEntry", fields: [entryId], references: [id], onDelete: Restrict)
  differenceAcceptedByUser User?              @relation("OpeningDifferenceAcceptedBy", fields: [differenceAcceptedByUserId], references: [id], onDelete: SetNull)
  postedByUser             User?              @relation("OpeningPostedBy", fields: [postedByUserId], references: [id], onDelete: SetNull)
  supersedes               OpeningBalanceSet? @relation("OpeningSetChain", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy             OpeningBalanceSet? @relation("OpeningSetChain")

  bankBalances     OpeningBankBalance[]
  propertyDebts    OpeningPropertyDebt[]
  propertyAdvances OpeningPropertyAdvance[]
  supplierInvoices OpeningSupplierInvoice[]
  otherBalances    OpeningOtherBalance[]

  receipts       AccountingReceipt[]
  postedInvoices SupplierInvoice[]

  @@map("opening_balance_sets")
}

model OpeningBankBalance {
  id               String   @id @default(uuid()) @db.Uuid
  setId            String   @map("set_id") @db.Uuid
  bankAccountId    String   @map("bank_account_id") @db.Uuid
  /// Saldo deudor de la cuenta en cutoverDate, en euros.
  balance          Decimal  @db.Decimal(12, 2)
  /// Para `validate()`: saldo del último extracto importado de esta cuenta,
  /// si lo hay. Solo informativo, nunca se contabiliza.
  statementBalance Decimal? @map("statement_balance") @db.Decimal(12, 2)

  set         OpeningBalanceSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  bankAccount BankAccount       @relation(fields: [bankAccountId], references: [id])

  @@unique([setId, bankAccountId])
  @@map("opening_bank_balances")
}

/// Deuda de una propiedad anterior a cutoverDate, por año de origen (art.
/// 9.1.e LPH). Al contabilizar se convierte en un recibo `saldo_anterior`
/// sin desglose (ver receipts_after_write_check, que ya exceptúa ese kind).
model OpeningPropertyDebt {
  id         String    @id @default(uuid()) @db.Uuid
  setId      String    @map("set_id") @db.Uuid
  propertyId String    @map("property_id") @db.Uuid
  originYear Int       @map("origin_year")
  concept    String    @db.VarChar(255)
  amount     Decimal   @db.Decimal(12, 2)
  dueDate    DateTime? @map("due_date") @db.Date

  set      OpeningBalanceSet  @relation(fields: [setId], references: [id], onDelete: Cascade)
  property Property           @relation(fields: [propertyId], references: [id])
  receipt  AccountingReceipt? @relation("OpeningPropertyDebtReceipt")

  @@map("opening_property_debts")
}

/// Saldo a favor de una propiedad (pagó de más antes de migrar): línea 430
/// acreedora sin recibo, igual que un anticipo corriente.
model OpeningPropertyAdvance {
  id         String  @id @default(uuid()) @db.Uuid
  setId      String  @map("set_id") @db.Uuid
  propertyId String  @map("property_id") @db.Uuid
  concept    String  @db.VarChar(255)
  amount     Decimal @db.Decimal(12, 2)

  set      OpeningBalanceSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  property Property          @relation(fields: [propertyId], references: [id])

  @@map("opening_property_advances")
}

/// Factura de proveedor pendiente de pago anterior a cutoverDate. Al
/// contabilizar se convierte en un SupplierInvoice con openingSetId
/// informado, que exime del desglose de líneas 6xx habitual (no hay gasto
/// nuevo que clasificar: ya ocurrió antes de llevar la contabilidad aquí).
model OpeningSupplierInvoice {
  id          String      @id @default(uuid()) @db.Uuid
  setId       String      @map("set_id") @db.Uuid
  supplierId  String      @map("supplier_id") @db.Uuid
  number      String      @db.VarChar(60)
  concept     String      @db.VarChar(300)
  issueDate   DateTime    @map("issue_date") @db.Date
  dueDate     DateTime?   @map("due_date") @db.Date
  /// Lo que queda por pagar (no hace falta reconstruir base/IVA/retención
  /// de una factura que ya no se puede editar).
  amount      Decimal     @db.Decimal(12, 2)
  payableRole AccountRole @default(suppliers_payable) @map("payable_role")

  set      OpeningBalanceSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  supplier Supplier          @relation(fields: [supplierId], references: [id])
  invoice  SupplierInvoice?  @relation("OpeningSupplierInvoiceInvoice")

  @@map("opening_supplier_invoices")
}

/// El resto de saldos que no encajan en las categorías anteriores: 555
/// pendiente de aplicar, 117 fondo de reserva, 4751 retenciones, 476
/// Seguridad Social, 465 nóminas pendientes, 120/121 resultados de
/// ejercicios anteriores. `role` se valida en el servicio contra una lista
/// corta — no cualquier AccountRole tiene sentido aquí (ver
/// opening-balances.rules.ts).
model OpeningOtherBalance {
  id      String      @id @default(uuid()) @db.Uuid
  setId   String      @map("set_id") @db.Uuid
  role    AccountRole
  concept String      @db.VarChar(255)
  /// Debe (activo/gasto) o haber (pasivo/patrimonio/ingreso) de esta línea.
  side    JournalSide
  amount  Decimal     @db.Decimal(12, 2)

  set OpeningBalanceSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@map("opening_other_balances")
}

enum JournalSide {
  debit
  credit
}

// ═══════════════════════════════════════════════════════════════════════
// ── 8. Recibos y periodos contables ────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════

model AccountingPeriod {
  id          String    @id @default(uuid()) @db.Uuid
  estateId    String    @map("estate_id") @db.Uuid
  periodKey   String    @map("period_key") @db.VarChar(7)
  label       String    @db.VarChar(50)
  monthAbbrev String    @map("month_abbrev") @db.VarChar(5)
  issuedAt    DateTime? @map("issued_at") @db.Date
  closedAt    DateTime? @map("closed_at") @db.Date

  estate   Estate              @relation(fields: [estateId], references: [id])
  receipts AccountingReceipt[]
  remesas  RemesaHistoryItem[]

  @@unique([estateId, periodKey])
  @@map("accounting_periods")
}

/// Entidad canónica única de recibo (Apéndice E — sustituye a `Receipt`
/// simple + `AccountingReceipt` detallado, que representaban el mismo
/// objeto de dominio). Cumple el patrón FK viva + snapshot inmutable: el
/// snapshot se escribe UNA VEZ al emitir y no se recalcula después — es
/// requisito legal, no solo de estilo (Apéndice B).
model AccountingReceipt {
  id                        String        @id @default(uuid()) @db.Uuid
  no                        String        @db.VarChar(30)
  periodId                  String        @map("period_id") @db.Uuid
  propertyId                String        @map("property_id") @db.Uuid
  ownerUserId               String?       @map("owner_user_id") @db.Uuid
  mandateId                 String?       @map("mandate_id") @db.Uuid
  /// Copiada del periodo (lo comprueba la base de datos).
  estateId                  String        @map("estate_id") @db.Uuid
  concept                   String        @db.VarChar(255)
  kind                      ReceiptKind
  amount                    Decimal       @db.Decimal(10, 2)
  /// Lo que queda por cobrar = saldo de la 430 de este recibo. Caché que la
  /// base de datos verifica al confirmar cada transacción.
  outstanding               Decimal       @db.Decimal(10, 2)
  /// Fecha del asiento de emisión: inicio del periodo o fecha de corte.
  accrualDate               DateTime      @map("accrual_date") @db.Date
  /// Año de la deuda, para el certificado del art. 9.1.e LPH.
  originYear                Int           @map("origin_year")
  issueEntryId              String?       @unique @map("issue_entry_id") @db.Uuid
  cancelEntryId             String?       @unique @map("cancel_entry_id") @db.Uuid
  /// Solo en recibos `saldo_anterior`: el set de apertura que lo creó. Su
  /// contrapartida es el asiento compartido del set, no `issueEntryId`
  /// (que se deja sin informar — ver opening-balances.service.ts).
  openingSetId              String?       @map("opening_set_id") @db.Uuid
  openingDebtId             String?       @unique @map("opening_debt_id") @db.Uuid
  cancelledAt               DateTime?     @map("cancelled_at") @db.Timestamptz
  cancelledByUserId         String?       @map("cancelled_by_user_id") @db.Uuid
  cancelReason              String?       @map("cancel_reason") @db.VarChar(255)
  issuedAt                  DateTime?     @map("issued_at") @db.Timestamptz
  dueDate                   DateTime?     @map("due_date") @db.Date
  /// Guardián anti-reenvío-mismo-día del cron de recordatorio de pago
  /// pendiente (receipt-reminder-cron.service.ts) — mismo criterio que
  /// Meeting.actaReminderSentAt.
  reminderSentAt            DateTime?     @map("reminder_sent_at") @db.Timestamptz
  status                    ReceiptStatus
  date                      DateTime      @db.Date
  method                    PayMethod
  manual                    Boolean       @default(false)
  includeInRemesa           Boolean       @default(true) @map("include_in_remesa")
  returnCode                String?       @map("return_code") @db.VarChar(10)
  returnReason              String?       @map("return_reason") @db.VarChar(150)
  // ── Snapshot inmutable al emitirse ──────────────────────────────────
  ownerNameSnapshot         String?       @map("owner_name_snapshot") @db.VarChar(200)
  ownerTaxIdSnapshot        String?       @map("owner_tax_id_snapshot") @db.VarChar(20)
  ownerTaxIdCountrySnapshot TaxIdCountry? @map("owner_tax_id_country_snapshot")
  ibanSnapshot              String?       @map("iban_snapshot") @db.VarChar(34)
  createdAt                 DateTime      @default(now()) @map("created_at") @db.Timestamptz
  // ── Justificante de pago subido por el propietario (rol C) ──────────
  proofFileName             String?       @map("proof_file_name") @db.VarChar(255)
  proofMimeType             String?       @map("proof_mime_type") @db.VarChar(100)
  proofS3Key                String?       @map("proof_s3_key") @db.VarChar(500)

  period          AccountingPeriod     @relation(fields: [periodId], references: [id])
  estate          Estate               @relation(fields: [estateId], references: [id])
  issueEntry      JournalEntry?        @relation("ReceiptIssueEntry", fields: [issueEntryId], references: [id], onDelete: Restrict)
  cancelEntry     JournalEntry?        @relation("ReceiptCancelEntry", fields: [cancelEntryId], references: [id], onDelete: Restrict)
  cancelledByUser User?                @relation("ReceiptCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  lines           ReceiptLine[]
  property        Property             @relation(fields: [propertyId], references: [id])
  mandate         Mandate?             @relation(fields: [mandateId], references: [id], onDelete: SetNull)
  openingSet      OpeningBalanceSet?   @relation(fields: [openingSetId], references: [id], onDelete: SetNull)
  openingDebt     OpeningPropertyDebt? @relation("OpeningPropertyDebtReceipt", fields: [openingDebtId], references: [id], onDelete: SetNull)

  remesaLines                  RemesaLine[]
  paymentAgreementInstallments PaymentAgreementInstallment[]
  journalLines                 JournalLine[]
  agreements                   PaymentAgreementReceipt[]
  /// Tramos de interés liquidados SOBRE esta deuda (fase 10) — este recibo es el que debe.
  interestAccrualsAsDebt       ReceiptInterestAccrual[]      @relation("DebtReceiptAccruals")
  /// Si este recibo ES un recibo de intereses (`kind = intereses_demora`), sus tramos.
  interestAccrualsAsInterest   ReceiptInterestAccrual[]      @relation("InterestReceiptAccruals")

  @@unique([periodId, no])
  @@index([propertyId])
  @@index([periodId, status])
  @@index([ownerUserId, status])
  @@index([estateId, status])
  @@index([openingSetId])
  @@map("receipts")
}

/// Tipo de interés de demora vigente en una finca (fase 10, ADR D7): interés
/// simple, días reales sobre 365 fijo, con días de gracia y referencia al
/// acta que lo aprobó. Las vigencias de una misma finca NUNCA se solapan
/// (EXCLUDE gist en la migración) — un cambio de tipo cierra la anterior con
/// `validTo` y abre una nueva, nunca se edita una vigencia ya usada.
model LatePaymentInterestPolicy {
  id               String    @id @default(uuid()) @db.Uuid
  estateId         String    @map("estate_id") @db.Uuid
  annualRatePct    Decimal   @map("annual_rate_pct") @db.Decimal(5, 2)
  graceDays        Int       @default(0) @map("grace_days")
  /// Inclusivo.
  validFrom        DateTime  @map("valid_from") @db.Date
  /// Exclusivo — null = sigue vigente.
  validTo          DateTime? @map("valid_to") @db.Date
  meetingReference String?   @map("meeting_reference") @db.VarChar(255)
  createdByUserId  String    @map("created_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  estate        Estate @relation(fields: [estateId], references: [id])
  createdByUser User   @relation("LatePaymentInterestPolicyCreatedBy", fields: [createdByUserId], references: [id])

  accruals ReceiptInterestAccrual[]

  @@index([estateId])
  @@map("late_payment_interest_policies")
}

/// Un tramo de interés ya liquidado de una deuda concreta (fase 10) — la
/// garantía de "nunca liquidar dos veces el mismo periodo" (T11) es el
/// EXCLUDE gist de la migración sobre (debtReceiptId, [fromDate, toDate)),
/// no una comprobación de la aplicación. Varios tramos (uno por cambio de
/// tipo) pueden componer un mismo recibo de intereses.
model ReceiptInterestAccrual {
  id                String   @id @default(uuid()) @db.Uuid
  debtReceiptId     String   @map("debt_receipt_id") @db.Uuid
  interestReceiptId String   @map("interest_receipt_id") @db.Uuid
  policyId          String   @map("policy_id") @db.Uuid
  /// Inclusivo.
  fromDate          DateTime @map("from_date") @db.Date
  /// Exclusivo.
  toDate            DateTime @map("to_date") @db.Date
  principalBase     Decimal  @map("principal_base") @db.Decimal(10, 2)
  annualRatePct     Decimal  @map("annual_rate_pct") @db.Decimal(5, 2)
  days              Int
  amount            Decimal  @db.Decimal(10, 2)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  debtReceipt     AccountingReceipt         @relation("DebtReceiptAccruals", fields: [debtReceiptId], references: [id], onDelete: Restrict)
  interestReceipt AccountingReceipt         @relation("InterestReceiptAccruals", fields: [interestReceiptId], references: [id], onDelete: Restrict)
  policy          LatePaymentInterestPolicy @relation(fields: [policyId], references: [id])

  @@index([debtReceiptId])
  @@index([interestReceiptId])
  @@map("receipt_interest_accruals")
}

/// Desglose del abono de la emisión de un recibo: cuota a la 700, parte del
/// fondo de reserva a la 117, derrama a la 701… Inmutable; suma el importe
/// del recibo (salvo "saldo anterior", cuya contrapartida es la apertura).
model ReceiptLine {
  id           String  @id @default(uuid()) @db.Uuid
  receiptId    String  @map("receipt_id") @db.Uuid
  lineNo       Int     @map("line_no")
  accountId    String  @map("account_id") @db.Uuid
  amount       Decimal @db.Decimal(10, 2)
  concept      String? @db.VarChar(255)
  costCentreId String? @map("cost_centre_id") @db.Uuid

  receipt    AccountingReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  account    ChartAccount      @relation(fields: [accountId], references: [id])
  costCentre CostCentre?       @relation(fields: [costCentreId], references: [id], onDelete: Restrict)

  @@unique([receiptId, lineNo])
  @@map("receipt_lines")
}

/// Contador de numeración de recibos por finca y serie (periodo, o
/// periodo + "M" para los manuales). Evita el count+1 con carreras.
model ReceiptSequence {
  estateId String @map("estate_id") @db.Uuid
  series   String @db.VarChar(20)
  last     Int

  @@id([estateId, series])
  @@map("receipt_sequences")
}

/// Cobro: dinero que entra (banco o caja) y se imputa a recibos de una
/// propiedad. Las imputaciones son las líneas de la 430 de su asiento (con
/// recibo); lo que sobra queda como anticipo (430 sin recibo). Un cobro de
/// remesa comparte asiento con el resto de líneas de la remesa. Inmutable:
/// se deshace con contraasiento (`undoEntryId`).
model Collection {
  id              String    @id @default(uuid()) @db.Uuid
  estateId        String    @map("estate_id") @db.Uuid
  propertyId      String    @map("property_id") @db.Uuid
  date            DateTime  @db.Date
  amount          Decimal   @db.Decimal(10, 2)
  method          PayMethod
  /// null = caja (efectivo, pago en oficina).
  bankAccountId   String?   @map("bank_account_id") @db.Uuid
  entryId         String    @map("entry_id") @db.Uuid
  remesaLineId    String?   @unique @map("remesa_line_id") @db.Uuid
  /// Si aplica un ingreso sin identificar (555), cuál.
  suspenseItemId  String?   @map("suspense_item_id") @db.Uuid
  notes           String?   @db.VarChar(255)
  undoneAt        DateTime? @map("undone_at") @db.Timestamptz
  undoneByUserId  String?   @map("undone_by_user_id") @db.Uuid
  undoReason      String?   @map("undo_reason") @db.VarChar(255)
  undoEntryId     String?   @unique @map("undo_entry_id") @db.Uuid
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  estate       Estate        @relation(fields: [estateId], references: [id])
  property     Property      @relation(fields: [propertyId], references: [id])
  bankAccount  BankAccount?  @relation(fields: [bankAccountId], references: [id])
  entry        JournalEntry  @relation("CollectionEntry", fields: [entryId], references: [id], onDelete: Restrict)
  undoEntry    JournalEntry? @relation("CollectionUndoEntry", fields: [undoEntryId], references: [id], onDelete: Restrict)
  remesaLine   RemesaLine?   @relation(fields: [remesaLineId], references: [id], onDelete: Restrict)
  suspenseItem SuspenseItem? @relation(fields: [suspenseItemId], references: [id], onDelete: Restrict)

  returnRecord ReceiptReturn?
  installment  PaymentAgreementInstallment?

  @@index([estateId, date])
  @@index([propertyId])
  @@map("collections")
}

/// Devolución bancaria de un cobro (un recibo domiciliado que el banco
/// devuelve, o una transferencia rechazada). Su asiento reabre la 430 de
/// los recibos y saca el dinero del banco; la comisión va a la 626 y, si
/// los estatutos lo permiten, se repercute con un recibo aparte.
model ReceiptReturn {
  id                    String       @id @default(uuid()) @db.Uuid
  estateId              String       @map("estate_id") @db.Uuid
  collectionId          String       @unique @map("collection_id") @db.Uuid
  remesaLineId          String?      @map("remesa_line_id") @db.Uuid
  date                  DateTime     @db.Date
  amount                Decimal      @db.Decimal(10, 2)
  returnCode            String?      @map("return_code") @db.VarChar(10)
  returnReason          String?      @map("return_reason") @db.VarChar(150)
  feeAmount             Decimal?     @map("fee_amount") @db.Decimal(10, 2)
  feeRechargedReceiptId String?      @unique @map("fee_recharged_receipt_id") @db.Uuid
  entryId               String       @unique @map("entry_id") @db.Uuid
  source                ReturnSource
  createdByUserId       String?      @map("created_by_user_id") @db.Uuid
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz

  estate     Estate       @relation(fields: [estateId], references: [id])
  collection Collection   @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  remesaLine RemesaLine?  @relation(fields: [remesaLineId], references: [id], onDelete: Restrict)
  entry      JournalEntry @relation("ReceiptReturnEntry", fields: [entryId], references: [id], onDelete: Restrict)

  @@index([estateId, date])
  @@map("receipt_returns")
}

/// Ingreso en el banco cuyo pagador no se identifica todavía (555). Se
/// aplica después a los recibos de una propiedad; lo que queda sin aplicar
/// sale de su contabilidad (ver SuspenseService).
model SuspenseItem {
  id              String   @id @default(uuid()) @db.Uuid
  estateId        String   @map("estate_id") @db.Uuid
  date            DateTime @db.Date
  amount          Decimal  @db.Decimal(10, 2)
  concept         String   @db.VarChar(255)
  bankAccountId   String   @map("bank_account_id") @db.Uuid
  entryId         String   @unique @map("entry_id") @db.Uuid
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  estate      Estate       @relation(fields: [estateId], references: [id])
  bankAccount BankAccount  @relation(fields: [bankAccountId], references: [id])
  entry       JournalEntry @relation("SuspenseItemEntry", fields: [entryId], references: [id], onDelete: Restrict)

  applications Collection[]

  @@index([estateId, date])
  @@map("suspense_items")
}

/// Recibos que cubre un plan de pago: sus cuotas se imputan a estos.
model PaymentAgreementReceipt {
  agreementId String @map("agreement_id") @db.Uuid
  receiptId   String @map("receipt_id") @db.Uuid

  agreement PaymentAgreement  @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  receipt   AccountingReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)

  @@id([agreementId, receiptId])
  @@map("payment_agreement_receipts")
}

// ═══════════════════════════════════════════════════════════════════════
// ── 9. SEPA / Remesas ────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════

/// Mandato SEPA formalizado (Apéndice F). Cumple los datos mínimos del
/// Rulebook EPC016-06/EPC131-08. `firstUseAt=null` ⇒ próxima secuencia FRST.
model Mandate {
  id               String             @id @default(uuid()) @db.Uuid
  umr              String             @unique @db.VarChar(35)
  creditorEstateId String             @map("creditor_estate_id") @db.Uuid
  propertyId       String             @map("property_id") @db.Uuid
  titularUserId    String             @map("titular_user_id") @db.Uuid
  scheme           SepaScheme
  paymentType      MandatePaymentType @map("payment_type")
  // VarChar(255): almacena el IBAN cifrado en reposo (AES-256-GCM,
  // prefijo 'enc:v1:', ver backend/src/sepa/crypto.service.ts)
  debtorIban       String             @map("debtor_iban") @db.VarChar(255)
  debtorBic        String?            @map("debtor_bic") @db.VarChar(11)
  signedAt         DateTime           @map("signed_at") @db.Date
  firstUseAt       DateTime?          @map("first_use_at") @db.Date
  lastUseAt        DateTime?          @map("last_use_at") @db.Date
  revokedAt        DateTime?          @map("revoked_at") @db.Timestamptz
  revokedReason    String?            @map("revoked_reason")
  status           MandateStatus

  creditorEstate Estate   @relation("MandateCreditorEstate", fields: [creditorEstateId], references: [id])
  property       Property @relation(fields: [propertyId], references: [id])
  titularUser    User     @relation("MandateTitular", fields: [titularUserId], references: [id])

  amendments  MandateAmendment[]
  receipts    AccountingReceipt[]
  remesaLines RemesaLine[]

  @@index([propertyId])
  @@index([status])
  @@map("mandates")
}

/// Cambios post-firma (IBAN, BIC, nombre...). La siguiente remesa que use
/// este mandato debe llevar `AmdmntInd=true` mientras
/// `pendingInFirstNextRemesa=true`.
model MandateAmendment {
  id                       String                @id @default(uuid()) @db.Uuid
  mandateId                String                @map("mandate_id") @db.Uuid
  field                    MandateAmendmentField
  oldValue                 String                @map("old_value")
  newValue                 String                @map("new_value")
  changedAt                DateTime              @map("changed_at") @db.Timestamptz
  changedByUserId          String                @map("changed_by_user_id") @db.Uuid
  pendingInFirstNextRemesa Boolean               @default(true) @map("pending_in_first_next_remesa")

  mandate       Mandate @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  changedByUser User    @relation("MandateAmendmentChangedBy", fields: [changedByUserId], references: [id])

  @@map("mandate_amendments")
}

model RemesaHistoryItem {
  id                String       @id @default(uuid()) @db.Uuid
  estateId          String       @map("estate_id") @db.Uuid
  periodId          String?      @map("period_id") @db.Uuid
  scheme            SepaScheme
  concept           String       @db.VarChar(255)
  status            RemesaStatus
  linesCount        Int          @default(0) @map("lines_count")
  totalAmount       Decimal      @default(0) @map("total_amount") @db.Decimal(12, 2)
  presentedAt       DateTime?    @map("presented_at") @db.Date
  chargeDate        DateTime?    @map("charge_date") @db.Date
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  createdByUserId   String?      @map("created_by_user_id") @db.Uuid
  // XML pain.008 EXACTO presentado al banco — se persiste al generar y se
  // sirve tal cual en descargas posteriores (nunca se regenera, para
  // preservar el snapshot byte a byte que vio el banco).
  xmlContent        String?      @map("xml_content")
  /// MsgId del pain.008: lo citan los ficheros de devolución (pain.002).
  messageId         String?      @unique @map("message_id") @db.VarChar(35)
  /// Cuenta de la comunidad donde el banco abona la remesa.
  bankAccountId     String?      @map("bank_account_id") @db.Uuid
  collectedAt       DateTime?    @map("collected_at") @db.Date
  collectedByUserId String?      @map("collected_by_user_id") @db.Uuid
  collectionEntryId String?      @unique @map("collection_entry_id") @db.Uuid
  cancelledAt       DateTime?    @map("cancelled_at") @db.Timestamptz

  estate          Estate            @relation(fields: [estateId], references: [id])
  period          AccountingPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)
  bankAccount     BankAccount?      @relation(fields: [bankAccountId], references: [id])
  collectionEntry JournalEntry?     @relation("RemesaCollectionEntry", fields: [collectionEntryId], references: [id], onDelete: Restrict)

  lines RemesaLine[]

  @@index([estateId])
  @@map("remesas")
}

/// Fichero de devoluciones del banco (pain.002 o camt.054). Se guarda al
/// subirlo, con sus partidas ya emparejadas, para revisarlo antes de aplicar.
/// El mismo fichero dos veces es el mismo registro (hash por finca).
model ReturnFile {
  id              String           @id @default(uuid()) @db.Uuid
  estateId        String           @map("estate_id") @db.Uuid
  format          ReturnFileFormat
  fileName        String           @map("file_name") @db.VarChar(255)
  /// SHA-256 del contenido: detecta el mismo fichero subido otra vez.
  fileHash        String           @map("file_hash") @db.VarChar(64)
  /// MsgId del propio fichero (no el de la remesa a la que se refiere).
  messageId       String?          @map("message_id") @db.VarChar(35)
  createdByUserId String?          @map("created_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  lastAppliedAt   DateTime?        @map("last_applied_at") @db.Timestamptz

  estate Estate           @relation(fields: [estateId], references: [id], onDelete: Cascade)
  items  ReturnFileItem[]

  @@unique([estateId, fileHash])
  @@index([estateId, createdAt(sort: Desc)])
  @@map("return_files")
}

/// Una devolución o rechazo dentro de un fichero del banco.
model ReturnFileItem {
  id                String               @id @default(uuid()) @db.Uuid
  fileId            String               @map("file_id") @db.Uuid
  seq               Int
  endToEndId        String?              @map("end_to_end_id") @db.VarChar(35)
  /// MsgId de la remesa original, si el fichero lo cita.
  originalMessageId String?              @map("original_message_id") @db.VarChar(35)
  amount            Decimal?             @db.Decimal(10, 2)
  /// Fecha del cargo de la devolución (o del rechazo).
  date              DateTime?            @db.Date
  returnCode        String?              @map("return_code") @db.VarChar(10)
  returnReason      String?              @map("return_reason") @db.VarChar(150)
  /// Comisión que el banco cobró por esta devolución, si el fichero la indica.
  feeAmount         Decimal?             @map("fee_amount") @db.Decimal(10, 2)
  status            ReturnFileItemStatus
  remesaLineId      String?              @map("remesa_line_id") @db.Uuid
  error             String?              @db.VarChar(255)
  appliedAt         DateTime?            @map("applied_at") @db.Timestamptz

  file       ReturnFile  @relation(fields: [fileId], references: [id], onDelete: Cascade)
  remesaLine RemesaLine? @relation(fields: [remesaLineId], references: [id], onDelete: SetNull)

  @@unique([fileId, seq])
  @@index([remesaLineId])
  @@map("return_file_items")
}

model RemesaLine {
  id                        String           @id @default(uuid()) @db.Uuid
  remesaId                  String           @map("remesa_id") @db.Uuid
  receiptId                 String           @map("receipt_id") @db.Uuid
  propertyId                String           @map("property_id") @db.Uuid
  ownerUserId               String?          @map("owner_user_id") @db.Uuid
  mandateId                 String?          @map("mandate_id") @db.Uuid
  iban                      String           @db.VarChar(34)
  mandateSeq                MandateSeq       @map("mandate_seq")
  amount                    Decimal          @db.Decimal(10, 2)
  status                    RemesaLineStatus
  returnCode                String?          @map("return_code") @db.VarChar(10)
  returnReason              String?          @map("return_reason") @db.VarChar(150)
  // ── Snapshot inmutable (legal/SEPA) — el XML ya enviado al banco no
  // debe alterarse aunque el titular cambie de nombre/IBAN después. ────
  ownerNameSnapshot         String?          @map("owner_name_snapshot") @db.VarChar(200)
  ownerTaxIdSnapshot        String?          @map("owner_tax_id_snapshot") @db.VarChar(20)
  ownerTaxIdCountrySnapshot TaxIdCountry?    @map("owner_tax_id_country_snapshot")
  ibanSnapshot              String?          @map("iban_snapshot") @db.VarChar(34)
  /// EndToEndId del pain.008, único: lo citan los ficheros de devolución.
  endToEndId                String?          @unique @map("end_to_end_id") @db.VarChar(35)

  remesa   RemesaHistoryItem @relation(fields: [remesaId], references: [id], onDelete: Cascade)
  receipt  AccountingReceipt @relation(fields: [receiptId], references: [id])
  property Property          @relation(fields: [propertyId], references: [id])
  mandate  Mandate?          @relation(fields: [mandateId], references: [id], onDelete: SetNull)

  collection      Collection?
  returns         ReceiptReturn[]
  returnFileItems ReturnFileItem[]

  @@unique([remesaId, receiptId])
  @@index([remesaId])
  @@map("remesa_lines")
}

// ═══════════════════════════════════════════════════════════════════════
// ── 10. Morosidad ────────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════

model Debtor {
  id              String    @id @default(uuid()) @db.Uuid
  administratorId String    @map("administrator_id") @db.Uuid
  estateId        String    @map("estate_id") @db.Uuid
  propertyId      String?   @map("property_id") @db.Uuid
  amount          Decimal   @db.Decimal(10, 2)
  interest        Decimal   @default(0) @db.Decimal(10, 2)
  monthsOverdue   Int       @map("months_overdue")
  oldest          String    @db.VarChar(20)
  lastContact     DateTime? @map("last_contact") @db.Timestamptz
  reminderL1      Boolean   @default(false) @map("reminder_l1")
  reminderL2      Boolean   @default(false) @map("reminder_l2")
  reminderBf      Boolean   @default(false) @map("reminder_bf")
  step            String    @db.VarChar(50)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  estate   Estate    @relation(fields: [estateId], references: [id])

  actions           DebtorAction[]
  paymentAgreements PaymentAgreement[]

  @@index([administratorId])
  @@index([estateId])
  @@map("debtors")
}

/// Histórico de gestiones sobre un moroso. Antes embebido en `Debtor.history`
/// — extraído a tabla independiente (Apéndice G).
model DebtorAction {
  id               String      @id @default(uuid()) @db.Uuid
  debtorId         String      @map("debtor_id") @db.Uuid
  type             GestionType
  date             DateTime    @db.Date
  note             String
  result           String?     @db.VarChar(200)
  authorUserId     String?     @map("author_user_id") @db.Uuid
  /// Sin relación Prisma formal — ver nota de cabecera, decisión #5.
  onBehalfOfUserId String?     @map("on_behalf_of_user_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz

  debtor     Debtor @relation(fields: [debtorId], references: [id], onDelete: Cascade)
  authorUser User?  @relation("DebtorActionAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([debtorId, date(sort: Desc)])
  @@map("debtor_actions")
}

/// Antes el acuerdo de pago se calculaba solo en memoria y se descartaba al
/// cerrar el panel — "Confirmar acuerdo" ni lo guardaba (Apéndice H). Ahora
/// persistente, con cuotas individualmente cobrables.
model PaymentAgreement {
  id                String                 @id @default(uuid()) @db.Uuid
  debtorId          String                 @map("debtor_id") @db.Uuid
  totalAmount       Decimal                @map("total_amount") @db.Decimal(10, 2)
  downPaymentAmount Decimal                @default(0) @map("down_payment_amount") @db.Decimal(10, 2)
  installmentsCount Int                    @map("installments_count")
  firstDueDate      DateTime               @map("first_due_date") @db.Date
  status            PaymentAgreementStatus
  signedAt          DateTime               @map("signed_at") @db.Timestamptz
  createdByUserId   String                 @map("created_by_user_id") @db.Uuid
  cancelledAt       DateTime?              @map("cancelled_at") @db.Timestamptz
  cancelledReason   String?                @map("cancelled_reason")

  debtor          Debtor                    @relation(fields: [debtorId], references: [id], onDelete: Cascade)
  coveredReceipts PaymentAgreementReceipt[]
  createdByUser   User                      @relation("PaymentAgreementCreatedBy", fields: [createdByUserId], references: [id])

  installments PaymentAgreementInstallment[]

  @@index([debtorId, status])
  @@map("payment_agreements")
}

model PaymentAgreementInstallment {
  id          String    @id @default(uuid()) @db.Uuid
  agreementId String    @map("agreement_id") @db.Uuid
  seq         Int
  dueDate     DateTime  @map("due_date") @db.Date
  amount      Decimal   @db.Decimal(10, 2)
  paidAt      DateTime? @map("paid_at") @db.Timestamptz
  receiptId   String?   @map("receipt_id") @db.Uuid

  agreement    PaymentAgreement   @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  receipt      AccountingReceipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  /// Cobro contable de la cuota (ver Collection).
  collectionId String?            @unique @map("collection_id") @db.Uuid
  collection   Collection?        @relation(fields: [collectionId], references: [id], onDelete: Restrict)

  @@unique([agreementId, seq])
  @@map("payment_agreement_installments")
}

// ═══════════════════════════════════════════════════════════════════════
// ── 11. Reservas de zonas comunes ────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════

model Amenity {
  id          String   @id @default(uuid()) @db.Uuid
  estateId    String   @map("estate_id") @db.Uuid
  name        String   @db.VarChar(150)
  icon        String?  @db.VarChar(10)
  color       String?  @db.VarChar(50)
  bg          String?  @db.VarChar(50)
  maxHours    Int      @map("max_hours")
  slots       String[]
  rules       String?
  capacity    Int
  seasonal    Boolean  @default(false)
  seasonLabel String?  @map("season_label") @db.VarChar(50)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  estate    Estate            @relation(fields: [estateId], references: [id])
  bookings  Booking[]
  blackouts AmenityBlackout[]

  @@index([estateId])
  @@map("amenities")
}

/// Periodo de indisponibilidad por mantenimiento de una instalación
/// concreta (no de la finca entera) — bloquea reservas nuevas que caigan
/// dentro del rango, tanto en AmenitiesService.createBooking() como en
/// availability().
model AmenityBlackout {
  id        String   @id @default(uuid()) @db.Uuid
  amenityId String   @map("amenity_id") @db.Uuid
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  reason    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  amenity Amenity @relation(fields: [amenityId], references: [id])

  @@index([amenityId, startDate, endDate])
  @@map("amenity_blackouts")
}

model Booking {
  id                 String        @id @default(uuid()) @db.Uuid
  amenityId          String        @map("amenity_id") @db.Uuid
  propertyId         String?       @map("property_id") @db.Uuid
  userId             String        @map("user_id") @db.Uuid
  date               DateTime      @db.Date
  startSlot          String        @map("start_slot") @db.VarChar(5)
  endSlot            String        @map("end_slot") @db.VarChar(5)
  status             BookingStatus
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz
  guests             Int           @default(1)
  notes              String?
  cancelledAt        DateTime?     @map("cancelled_at") @db.Timestamptz
  cancellationReason String?       @map("cancellation_reason")

  amenity  Amenity   @relation(fields: [amenityId], references: [id])
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  user     User      @relation(fields: [userId], references: [id])

  @@index([amenityId, date])
  @@map("bookings")
}

// ═══════════════════════════════════════════════════════════════════════
// ── 12. Actividad ────────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════

/// Feed de actividad híbrido (Apéndice H): la mayoría de "Actividad
/// reciente" se DERIVA en consulta sobre issues/receipts/communications/
/// documents; esta tabla cubre solo eventos sin timeline propio (p.ej.
/// aprobación de una solicitud de adhesión).
model ActivityLogEntry {
  id          String              @id @default(uuid()) @db.Uuid
  actorUserId String?             @map("actor_user_id") @db.Uuid
  subjectType ActivitySubjectType @map("subject_type")
  subjectId   String              @map("subject_id") @db.Uuid
  verb        ActivityVerb
  summary     String              @db.VarChar(255)
  occurredAt  DateTime            @map("occurred_at") @db.Timestamptz
  estateId    String?             @map("estate_id") @db.Uuid
  propertyId  String?             @map("property_id") @db.Uuid

  actorUser User?     @relation("ActivityLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  estate    Estate?   @relation(fields: [estateId], references: [id], onDelete: SetNull)
  property  Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([estateId, occurredAt(sort: Desc)])
  @@index([propertyId, occurredAt(sort: Desc)])
  @@index([subjectType, subjectId])
  @@map("activity_log")
}

/// Registro de accesos a datos personales sensibles (RGPD art. 32,
/// Fase 13). Append-only por política: la aplicación no expone UPDATE ni
/// DELETE. `actorUserId` sin relación formal para que el borrado de
/// usuarios nunca arrastre el registro de auditoría.
model DataAccessLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  resource    String   @db.VarChar(100)
  resourceId  String?  @map("resource_id") @db.Uuid
  action      String   @db.VarChar(30)
  detail      String?  @db.VarChar(255)
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  /// Allowlisted technical reporting facts; never document contents or PII.
  metadata Json?

  @@index([actorUserId, occurredAt(sort: Desc)])
  @@index([resource, resourceId])
  @@map("data_access_log")
}

// ═══════════════════════════════════════════════════════════════════════
// ── 13. Juntas de propietarios y videollamada ────────────────────────────
// ═══════════════════════════════════════════════════════════════════════
//
// Portado desde el equivalente React/Supabase de este mismo producto
// (módulo "juntas" sobre Jitsi Meet público). `agenda` se mantiene como
// Json (no normalizado) porque cada punto puede llevar una plantilla de
// votación (`voteTemplate`) que hoy solo se CAPTURA como dato — la
// ejecución real de una votación (vote_sessions) es una historia aparte,
// fuera de alcance. `attendeeEmails` es un snapshot de texto libre al
// crear la junta (igual que el original), no una relación a `users`: un
// asistente convocado por email no tiene por qué tener cuenta en la
// plataforma.

model Meeting {
  id                  String            @id @default(uuid()) @db.Uuid
  estateId            String            @map("estate_id") @db.Uuid
  title               String            @db.VarChar(200)
  type                MeetingType
  status              MeetingStatus     @default(convocada)
  scheduledAt1        DateTime          @map("scheduled_at_1") @db.Timestamptz
  scheduledAt2        DateTime          @map("scheduled_at_2") @db.Timestamptz
  /// Lista de puntos del orden del día: [{id,title,description,hasVote,voteTemplate?}].
  agenda              Json
  convokedBy          MeetingConvokedBy @map("convoked_by")
  location            String?           @db.VarChar(255)
  /// Convocatoria redactada y editada por la gestora al crear la junta (ver `convocatoria-document.ts`).
  /// Null = se redacta la habitual con los datos de la junta al pedirla.
  convocatoriaDoc     Json?             @map("convocatoria_doc")
  locationPlaceId     String?           @map("location_place_id") @db.VarChar(200)
  locationLat         Float?            @map("location_lat")
  locationLng         Float?            @map("location_lng")
  signerRole          MeetingSignerRole @map("signer_role")
  signerName          String?           @map("signer_name") @db.VarChar(200)
  attendeeEmails      String[]          @map("attendee_emails")
  /// Solo si true se genera jitsiRoomName/jitsiAccessPassword al crear —
  /// a diferencia del original, aquí el toggle se respeta desde el día 1
  /// porque es código nuevo, no un Edge Function heredado con el bug.
  includeJitsi        Boolean           @default(false) @map("include_jitsi")
  jitsiRoomName       String?           @map("jitsi_room_name") @db.VarChar(80)
  jitsiAccessPassword String?           @map("jitsi_access_password") @db.VarChar(20)
  createdByUserId     String            @map("created_by_user_id") @db.Uuid
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  /// Constancia explícita de la gestora al convocar con videollamada: la
  /// finca tiene respaldo estatutario (art. 17.6 LPH) para asistencia
  /// telemática, o asume el riesgo de impugnación — la reforma de la LPH
  /// que lo autorizaría sin unanimidad estatutaria todavía no es ley (solo
  /// "toma en consideración" en el Congreso a fecha de este diseño). Sin
  /// motor legal: solo registro + aviso, nunca bloquea la creación.
  telematicBackingConfirmedAt       DateTime? @map("telematic_backing_confirmed_at") @db.Timestamptz
  telematicBackingConfirmedByUserId String?   @map("telematic_backing_confirmed_by_user_id") @db.Uuid

  /// Fijado explícito dentro de `updateStatus()` al pasar a 'celebrada' —
  /// NO derivado de `updatedAt` (frágil: cualquier edición no relacionada
  /// lo desplazaría). Referencia estable para los plazos de acta (10 días
  /// naturales, art. 19 LPH) y de impugnación (3 meses, art. 18 LPH).
  celebratedAt DateTime? @map("celebrated_at") @db.Timestamptz

  /// Acta digital (Fase 2.2). A diferencia de la convocatoria, SÍ se
  /// persiste — su contenido (quórum, asistencia, delegaciones, resultados
  /// de voto) es un snapshot legal del momento de la firma; una delegación
  /// revocada después no debe alterar un acta ya firmada.
  actaS3Key                    String?    @map("acta_s3_key")
  /// Solo se rellena cuando AMBAS firmas (presidente + secretario) están
  /// puestas — es el momento en que se genera y persiste el .docx.
  actaSignedAt                 DateTime?  @map("acta_signed_at") @db.Timestamptz
  actaSignedByPresidenteUserId String?    @map("acta_signed_by_presidente_user_id") @db.Uuid
  actaSignedBySecretarioUserId String?    @map("acta_signed_by_secretario_user_id") @db.Uuid
  /// Ancla del plazo de impugnación de 3 meses (art. 18 LPH).
  actaDistributedAt            DateTime?  @map("acta_distributed_at") @db.Timestamptz
  /// Texto libre de la gestora para el acta: comentarios generales de la junta
  /// y comentarios / próximos pasos. Editables hasta que el acta se firma.
  actaGeneralComments          String?    @map("acta_general_comments") @db.Text
  actaNextSteps                String?    @map("acta_next_steps") @db.Text
  /// Origen del acta. `uploaded`: la gestora subió un archivo (campos acta_upload_*); el borrador generado
  /// y sus versiones se conservan, pero la firma se hace sobre el archivo subido.
  actaOrigin                   ActaOrigin @default(generated) @map("acta_origin")
  actaUploadS3Key              String?    @map("acta_upload_s3_key") @db.VarChar(500)
  actaUploadFileName           String?    @map("acta_upload_file_name") @db.VarChar(255)
  actaUploadMimeType           String?    @map("acta_upload_mime_type") @db.VarChar(100)
  actaUploadSizeBytes          Int?       @map("acta_upload_size_bytes")
  /// SHA-256 (hex) del archivo subido: es lo que firman presidente y secretario.
  actaUploadSha256             String?    @map("acta_upload_sha256") @db.VarChar(64)
  actaUploadedAt               DateTime?  @map("acta_uploaded_at") @db.Timestamptz

  /// Datos reales de la reunión que Domora NO puede deducir: los confirma la gestora al
  /// preparar el acta. `celebratedAt` (el instante de pulsar «celebrada») es solo una
  /// sugerencia, no sustituye a `actualEndAt`.
  actualStartAt        DateTime?           @map("actual_start_at") @db.Timestamptz
  actualEndAt          DateTime?           @map("actual_end_at") @db.Timestamptz
  /// Convocatoria en la que se constituyó la junta, confirmada por la gestora. Es lo que
  /// usa el quórum de una junta ya celebrada: nunca la hora actual.
  effectiveConvocation MeetingConvocation? @map("effective_convocation")

  /// Fase 2.3 — la gestora puede exigir 2FA para votar en ESTA junta
  /// (nunca obligatorio globalmente). Solo editable antes de que exista
  /// ninguna VoteSession, para no invalidar votos ya emitidos bajo otra regla.
  require2faForVoting Boolean @default(false) @map("require_2fa_for_voting")

  /// Fase 2.4 — guarda contra reenviar el recordatorio de acta pendiente
  /// de firma más de una vez el mismo día (cron diario, réplicas múltiples
  /// posibles) — mismo criterio que RegulatoryInspection.lastReminderSentAt.
  actaReminderSentAt DateTime? @map("acta_reminder_sent_at") @db.Timestamptz

  estate                          Estate                  @relation(fields: [estateId], references: [id])
  createdBy                       User                    @relation("MeetingCreatedBy", fields: [createdByUserId], references: [id])
  telematicBackingConfirmedByUser User?                   @relation("MeetingTelematicBackingConfirmedBy", fields: [telematicBackingConfirmedByUserId], references: [id], onDelete: SetNull)
  actaSignedByPresidenteUser      User?                   @relation("MeetingActaSignedByPresidente", fields: [actaSignedByPresidenteUserId], references: [id], onDelete: SetNull)
  actaSignedBySecretarioUser      User?                   @relation("MeetingActaSignedBySecretario", fields: [actaSignedBySecretarioUserId], references: [id], onDelete: SetNull)
  state                           MeetingState?
  attendances                     MeetingAttendance[]
  chatMessages                    MeetingChatMessage[]
  presences                       MeetingPresence[]
  attachments                     MeetingAttachment[]
  actaVersions                    MeetingActaVersion[]
  voteDelegations                 MeetingVoteDelegation[]
  voteSessions                    VoteSession[]

  @@index([estateId])
  @@map("meetings")
}

/// 1:1 con Meeting — estado mutable de la videollamada, separado de los
/// datos de convocatoria porque cambia con una cadencia muy distinta
/// (se lee por polling cada pocos segundos mientras la sala de espera
/// está abierta). `redirectRequestedAt` sustituye el broadcast puntual
/// 'redirect_now' del original: el cliente compara esta marca de tiempo
/// contra la última que vio para disparar el auto-redirect sin necesitar
/// un canal persistente.
model MeetingState {
  meetingId           String    @id @map("meeting_id") @db.Uuid
  adminReady          Boolean   @default(false) @map("admin_ready")
  adminLastSeenAt     DateTime? @map("admin_last_seen_at") @db.Timestamptz
  scheduledStartAt    DateTime? @map("scheduled_start_at") @db.Timestamptz
  announcement        String?   @db.VarChar(255)
  announcementSetAt   DateTime? @map("announcement_set_at") @db.Timestamptz
  redirectRequestedAt DateTime? @map("redirect_requested_at") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("meeting_state")
}

/// Quién entró efectivamente a la sala de Jitsi (no quién estaba
/// convocado). Se registra una vez por usuario y reunión.
model MeetingAttendance {
  id             String                  @id @default(uuid()) @db.Uuid
  meetingId      String                  @map("meeting_id") @db.Uuid
  propertyId     String                  @map("property_id") @db.Uuid
  userId         String                  @map("user_id") @db.Uuid
  displayName    String                  @map("display_name") @db.VarChar(200)
  role           MeetingAttendanceRole   @default(attendee)
  /// jitsi = autodeclarada al entrar a la videollamada; manual = pase de
  /// lista de la gestora — necesario porque una junta puede no tener
  /// videollamada (`includeJitsi: false`) y el quórum debe poder calcularse
  /// igual.
  source         MeetingAttendanceSource @default(jitsi)
  /// Quién la marcó en el pase de lista — null = autodeclarada por el
  /// propio asistente.
  markedByUserId String?                 @map("marked_by_user_id") @db.Uuid
  joinedAt       DateTime                @default(now()) @map("joined_at") @db.Timestamptz

  meeting      Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id])
  markedByUser User?    @relation("MeetingAttendanceMarkedBy", fields: [markedByUserId], references: [id], onDelete: SetNull)

  /// El quórum se calcula por vivienda (art. 16 LPH), no por persona: dos
  /// cotitulares del mismo piso generan dos filas (mismo propertyId,
  /// distinto userId), y `MeetingQuorumService` las colapsa con
  /// `distinct: ['propertyId']` para contar una sola propiedad presente.
  @@unique([meetingId, propertyId, userId])
  @@index([meetingId])
  @@index([meetingId, propertyId])
  @@map("meeting_attendance")
}

enum MeetingAttendanceSource {
  jitsi
  manual
}

/// Chat de la sala de espera / panel de anfitrión.
model MeetingChatMessage {
  id         String   @id @default(uuid()) @db.Uuid
  meetingId  String   @map("meeting_id") @db.Uuid
  senderId   String   @map("sender_id") @db.Uuid
  senderName String   @map("sender_name") @db.VarChar(200)
  text       String   @db.VarChar(1000)
  sentAt     DateTime @default(now()) @map("sent_at") @db.Timestamptz

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [senderId], references: [id])

  @@index([meetingId, sentAt])
  @@map("meeting_chat_messages")
}

/// Sustituye el `presence.track()`/`presence.sync()` de un canal realtime:
/// cada cliente conectado a la sala de espera hace upsert de su propia fila
/// cada ~10s (heartbeat); "presentes ahora" = filas con lastSeenAt dentro
/// de una ventana reciente (ver MeetingsService.listPresence).
model MeetingPresence {
  meetingId  String   @map("meeting_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  username   String   @db.VarChar(150)
  building   String?  @db.VarChar(150)
  unit       String?  @db.VarChar(50)
  floor      String?  @db.VarChar(20)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@id([meetingId, userId])
  @@map("meeting_presence")
}

/// Documentos adjuntos a la convocatoria (mismo patrón que IssuePhoto).
model MeetingAttachment {
  id         String   @id @default(uuid()) @db.Uuid
  meetingId  String   @map("meeting_id") @db.Uuid
  title      String   @db.VarChar(255)
  s3Key      String   @map("s3_key") @db.VarChar(500)
  /// Tipo MIME y tamaño del fichero al subirlo (null en adjuntos anteriores a estos campos).
  mimeType   String?  @map("mime_type") @db.VarChar(100)
  sizeBytes  Int?     @map("size_bytes")
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("meeting_attachments")
}

/// Versión del acta de una junta. Hay dos tipos de fila, en la misma numeración:
///  - de textos (histórico del botón «Guardar» de la pestaña Acta): solo `generalComments`,
///    `nextSteps` y `pointComments`; `generatedAt` es null.
///  - de documento (acta canónica): además `sourceSnapshot` (los datos congelados de la
///    junta), `documentModel` (lo que se muestra y se renderiza a PDF), `narrative`,
///    `versionHash` (SHA-256 del contenido canónico) y `pdfS3Key` cuando existe.
///    `generatedAt` no es null. Una versión de documento es reproducible: nada se
///    recalcula contra el censo actual.
model MeetingActaVersion {
  id              String   @id @default(uuid()) @db.Uuid
  meetingId       String   @map("meeting_id") @db.Uuid
  /// 1, 2, 3… dentro de cada junta.
  versionNumber   Int      @map("version_number")
  generalComments String?  @map("general_comments") @db.Text
  nextSteps       String?  @map("next_steps") @db.Text
  /// [{ id, title, comments }] — un elemento por punto del orden del día en ese momento.
  pointComments   Json     @map("point_comments")
  /// Quién guardó la versión (en las de documento, quien la generó o editó).
  savedByUserId   String?  @map("saved_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  status         ActaVersionStatus @default(draft)
  /// Solo en versiones de documento.
  generatedAt    DateTime?         @map("generated_at") @db.Timestamptz
  /// Datos de la junta tal y como eran al generar el acta (ver ActaSourceSnapshot).
  sourceSnapshot Json?             @map("source_snapshot")
  /// Documento ya preparado para renderizar (ver ActaDocumentModel); NO es un modelo Prisma.
  documentModel  Json?             @map("document_model")
  /// Cómo se redactó: { mode: 'llm' | 'fallback', model?, reason?, items: [...] }.
  narrative      Json?
  /// SHA-256 (hex) de la serialización canónica de `documentModel`. Integridad, no firma.
  versionHash    String?           @map("version_hash") @db.VarChar(64)
  /// PDF de esta versión, cuando se ha guardado (al preparar para firma).
  pdfS3Key       String?           @map("pdf_s3_key")
  preparedAt     DateTime?         @map("prepared_at") @db.Timestamptz

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  savedBy User?   @relation("MeetingActaVersionSavedBy", fields: [savedByUserId], references: [id], onDelete: SetNull)

  @@unique([meetingId, versionNumber])
  @@index([meetingId, status])
  @@map("meeting_acta_versions")
}

/// Delegación de voto para UNA junta y UNA propiedad concretas — art. 15.1
/// LPH: basta un escrito firmado simple, sin notario, y el representante no
/// tiene por qué ser propietario ni residente. Deliberadamente separada de
/// `UserRepresentation` (representación legal pesada e indefinida — tutela,
/// poder notarial — sin relación con esto).
model MeetingVoteDelegation {
  id                   String    @id @default(uuid()) @db.Uuid
  meetingId            String    @map("meeting_id") @db.Uuid
  propertyId           String    @map("property_id") @db.Uuid
  /// Titular que delega su voto.
  delegatorUserId      String    @map("delegator_user_id") @db.Uuid
  /// En quien delega, si tiene cuenta en Domora (propietario de la comunidad
  /// o usuario existente) — no tiene por qué tener membresía en la finca.
  /// null = representante externo sin cuenta, identificado por
  /// `representativeName` + `representativeDni`.
  representativeUserId String?   @map("representative_user_id") @db.Uuid
  representativeName   String?   @map("representative_name") @db.VarChar(200)
  representativeDni    String?   @map("representative_dni") @db.VarChar(20)
  /// Escrito firmado, opcional — mismo patrón que `MeetingAttachment.s3Key`.
  documentS3Key        String?   @map("document_s3_key")
  notes                String?   @db.VarChar(500)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdByUserId      String    @map("created_by_user_id") @db.Uuid
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz
  revokedByUserId      String?   @map("revoked_by_user_id") @db.Uuid
  revocationReason     String?   @map("revocation_reason")

  meeting            Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  property           Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  delegatorUser      User     @relation("VoteDelegationDelegator", fields: [delegatorUserId], references: [id])
  representativeUser User?    @relation("VoteDelegationRepresentative", fields: [representativeUserId], references: [id])
  createdByUser      User     @relation("VoteDelegationCreatedBy", fields: [createdByUserId], references: [id])
  revokedByUser      User?    @relation("VoteDelegationRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  /// Sin `@@unique([meetingId, propertyId])` a propósito: Prisma no expresa
  /// índices únicos parciales (`WHERE revoked_at IS NULL`) de forma
  /// declarativa. `MeetingVoteDelegationsService.create()` auto-revoca
  /// cualquier delegación activa previa de la misma junta+propiedad dentro
  /// de una transacción antes de insertar la nueva.
  @@index([meetingId, propertyId])
  @@index([representativeUserId])
  @@map("meeting_vote_delegations")
}

/// Votación real de un punto del orden del día (Fase 2.1). `agendaItemId`
/// referencia el `id` del AgendaItem dentro del Json `Meeting.agenda` — sin
/// FK real, el orden del día sigue siendo Json (decisión ya tomada en
/// Fase 1: cada punto puede tener plantilla de votación, pero antes solo
/// se capturaba como dato).
model VoteSession {
  id             String            @id @default(uuid()) @db.Uuid
  meetingId      String            @map("meeting_id") @db.Uuid
  agendaItemId   String            @map("agenda_item_id") @db.VarChar(100)
  questionIndex  Int               @map("question_index")
  /// Elegido a mano por quien abre la sesión — no hay clasificador legal
  /// automático (art. 17 LPH: demasiados casos límite para automatizar
  /// con seguridad). Ver VoteTallyService para el denominador exacto de
  /// cada tipo — NO es el mismo para los tres.
  majorityType   VoteMajorityType  @map("majority_type")
  status         VoteSessionStatus @default(abierta)
  openedAt       DateTime          @default(now()) @map("opened_at") @db.Timestamptz
  openedByUserId String            @map("opened_by_user_id") @db.Uuid
  closedAt       DateTime?         @map("closed_at") @db.Timestamptz
  closedByUserId String?           @map("closed_by_user_id") @db.Uuid
  /// Snapshot al abrir (Meeting.require2faForVoting) — Fase 2.3. No se
  /// relee en caliente: cambiar el requisito global no debe alterar una
  /// sesión ya abierta con otra regla.
  require2fa     Boolean           @default(false) @map("require_2fa")
  /// Inmutable al cerrar: {ownersPct, quotaPct, passed, denominatorBasis, optionTally}.
  resultSummary  Json?             @map("result_summary")

  meeting      Meeting        @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  openedByUser User           @relation("VoteSessionOpenedBy", fields: [openedByUserId], references: [id])
  closedByUser User?          @relation("VoteSessionClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  responses    VoteResponse[]

  @@unique([meetingId, agendaItemId, questionIndex])
  @@index([meetingId])
  @@map("vote_sessions")
}

model VoteResponse {
  id                 String   @id @default(uuid()) @db.Uuid
  voteSessionId      String   @map("vote_session_id") @db.Uuid
  propertyId         String   @map("property_id") @db.Uuid
  /// Quién emitió el voto — puede ser un delegado (MeetingVoteDelegation), no necesariamente el titular.
  /// null = lo emitió un representante externo sin cuenta (ver `voterName`), registrado por la gestora.
  userId             String?  @map("user_id") @db.Uuid
  /// Nombre del representante externo que votó (solo si `userId` es null).
  voterName          String?  @map("voter_name") @db.VarChar(200)
  /// Gestora que registró el voto en nombre de quien estaba presente — null = lo emitió el propio votante.
  registeredByUserId String?  @map("registered_by_user_id") @db.Uuid
  /// single_choice.
  optionIndex        Int?     @map("option_index")
  /// multiple_choice.
  optionIndexes      Int[]    @map("option_indexes")
  castAt             DateTime @default(now()) @map("cast_at") @db.Timestamptz

  voteSession      VoteSession @relation(fields: [voteSessionId], references: [id], onDelete: Cascade)
  property         Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user             User?       @relation(fields: [userId], references: [id])
  registeredByUser User?       @relation("VoteResponseRegisteredBy", fields: [registeredByUserId], references: [id], onDelete: SetNull)

  /// Una propiedad, un voto por sesión — reemplazable (upsert) hasta el
  /// cierre, igual criterio que MeetingAttendance (escaneado por
  /// propiedad, no por usuario).
  @@unique([voteSessionId, propertyId])
  @@index([voteSessionId])
  @@map("vote_responses")
}

enum VoteMajorityType {
  unanimidad
  tresQuintos
  mayoriaSimple
}

enum VoteSessionStatus {
  abierta
  cerrada
}

enum MeetingType {
  ordinaria
  extraordinaria
}

/// convocada -> celebrada -> firmada (acta firmada por presidente y secretario); cancelada
/// es la salida alternativa desde convocada. `firmada` y `cancelada` son terminales.
enum MeetingStatus {
  convocada
  celebrada
  cancelada
  firmada
}

/// Convocatoria en la que se constituyó la junta.
enum MeetingConvocation {
  primera
  segunda
}

/// Ciclo de una versión de acta: draft -> readyForSignature -> signed; superseded cuando
/// una versión posterior la sustituye. Las versiones de solo textos quedan en `draft`.
enum ActaVersionStatus {
  draft
  readyForSignature
  signed
  superseded
}

enum MeetingConvokedBy {
  presidente
  cuotas25
  propietarios25
  mandatoJudicial
}

enum MeetingSignerRole {
  administrador
  presidente
  secretario
}

enum MeetingAttendanceRole {
  attendee
  admin
}

// ═══════════════════════════════════════════════════════════════════════
// ── 14. Inspecciones normativas de elementos comunes ────────────────────
// ═══════════════════════════════════════════════════════════════════════

/// Elemento común de la finca sujeto a inspección periódica (ascensor,
/// grupo de presión contraincendios, cuadro eléctrico...). Se crea una vez
/// y se reutiliza en sucesivas inspecciones — a diferencia del origen
/// portado (domora-es crea un `activos` nuevo en cada alta de inspección,
/// dejando activos huérfanos y sin histórico por elemento).
model Asset {
  id                String                 @id @default(uuid()) @db.Uuid
  estateId          String                 @map("estate_id") @db.Uuid
  name              String                 @db.VarChar(200)
  category          String                 @db.VarChar(100)
  location          String?                @db.VarChar(200)
  manufacturer      String?                @db.VarChar(150)
  serialNumber      String?                @map("serial_number") @db.VarChar(100)
  notes             String?
  /// Lo que el gestor declara a mano. "Revisión próxima/vencida" NO se guarda:
  /// se deriva de las inspecciones (ver `AssetsService.listInstallations`).
  operationalStatus AssetOperationalStatus @default(operativa) @map("operational_status")
  /// Empresa responsable del mantenimiento de la instalación (opcional).
  supplierId        String?                @map("supplier_id") @db.Uuid
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  estate         Estate                 @relation(fields: [estateId], references: [id], onDelete: Restrict)
  supplier       Supplier?              @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  inspections    RegulatoryInspection[]
  issues         Issue[]
  supplierVisits SupplierVisit[]

  @@index([estateId])
  @@index([supplierId])
  @@map("assets")
}

enum AssetOperationalStatus {
  operativa
  en_mantenimiento
  fuera_de_servicio
}

/// Catálogo de tipos de inspección legalmente exigidos (ascensores, PCI,
/// eléctrica BT, RITE, legionela, gas, ITE/IEE...) — ver seed. `estateId`
/// NULL = catálogo global sembrado; no NULL = tipo personalizado dado de
/// alta por una gestora (mismo patrón que `community_id` nullable en el
/// origen portado).
///
/// `code` NO lleva `@unique` aquí a propósito: tiene que ser único DENTRO
/// de su ámbito (una vez en el catálogo global, una vez por cada finca que
/// lo personalice), no globalmente — dos fincas distintas deben poder
/// llamar "CUSTOM_01" cada una a su propio tipo. Postgres trata cada NULL
/// como distinto en un índice único normal, así que un `@@unique([code,
/// estateId])` declarativo NO protegería el catálogo global (varias filas
/// con el mismo code y estateId NULL no chocarían entre sí). La migración
/// SQL define en su lugar dos índices únicos PARCIALES (uno con `WHERE
/// estate_id IS NULL`, otro con `WHERE estate_id IS NOT NULL`) — Prisma no
/// tiene sintaxis declarativa para índices parciales, así que viven solo
/// en la migración a mano.
model InspectionType {
  id          String   @id @default(uuid()) @db.Uuid
  estateId    String?  @map("estate_id") @db.Uuid
  code        String   @db.VarChar(60)
  name        String   @db.VarChar(200)
  legalBasis  String?  @map("legal_basis") @db.VarChar(255)
  requiresOca Boolean  @default(false) @map("requires_oca")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  estate      Estate?                @relation(fields: [estateId], references: [id], onDelete: Cascade)
  inspections RegulatoryInspection[]

  @@index([estateId])
  @@map("inspection_types")
}

/// Inspección normativa de un elemento común — un registro por ciclo real.
/// Sin recurrencia automática (Apéndice de diseño): la gestora programa el
/// siguiente ciclo a mano cuando el anterior se completa. `appointmentDate`
/// es la cita concreta que dispara el aviso a inquilinos/propietarios al
/// pasar a `citada` (InspectionsService.updateStatus) — `nextDueDate` es
/// solo la fecha límite legal que alimenta el recordatorio interno de la
/// gestora (InspectionsCronService).
model RegulatoryInspection {
  id                 String                     @id @default(uuid()) @db.Uuid
  estateId           String                     @map("estate_id") @db.Uuid
  assetId            String                     @map("asset_id") @db.Uuid
  inspectionTypeId   String                     @map("inspection_type_id") @db.Uuid
  status             RegulatoryInspectionStatus @default(planificada)
  nextDueDate        DateTime?                  @map("next_due_date") @db.Date
  appointmentDate    DateTime?                  @map("appointment_date") @db.Date
  lastDoneDate       DateTime?                  @map("last_done_date") @db.Date
  reminderDaysBefore Int                        @default(30) @map("reminder_days_before")
  /// Marca el último recordatorio de vencimiento enviado por
  /// InspectionsCronService — evita reenviar el mismo día si el cron corre
  /// más de una vez o hay varias réplicas del proceso.
  lastReminderSentAt DateTime?                  @map("last_reminder_sent_at") @db.Timestamptz
  notes              String?
  createdByUserId    String                     @map("created_by_user_id") @db.Uuid
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz

  estate         Estate         @relation(fields: [estateId], references: [id], onDelete: Restrict)
  asset          Asset          @relation(fields: [assetId], references: [id], onDelete: Restrict)
  inspectionType InspectionType @relation(fields: [inspectionTypeId], references: [id], onDelete: Restrict)
  createdBy      User           @relation("RegulatoryInspectionCreatedBy", fields: [createdByUserId], references: [id])

  results           InspectionResult[]
  correctiveActions CorrectiveAction[]

  @@index([estateId, nextDueDate])
  @@index([status])
  @@map("regulatory_inspections")
}

/// Resultado registrado de una inspección (puede haber varios si una
/// desfavorable se repite tras subsanar defectos). Certificado/informe vía
/// StorageService — mismo patrón de clave opaca que `IssuePhoto.s3Key`.
model InspectionResult {
  id              String            @id @default(uuid()) @db.Uuid
  inspectionId    String            @map("inspection_id") @db.Uuid
  date            DateTime          @db.Date
  outcome         InspectionOutcome
  defects         String?
  certificateKey  String?           @map("certificate_key") @db.VarChar(500)
  reportKey       String?           @map("report_key") @db.VarChar(500)
  cost            Decimal?          @db.Decimal(10, 2)
  notes           String?
  createdByUserId String            @map("created_by_user_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz

  inspection RegulatoryInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  createdBy  User                 @relation("InspectionResultCreatedBy", fields: [createdByUserId], references: [id])

  @@index([inspectionId])
  @@map("inspection_results")
}

/// Acción correctiva abierta a raíz de un defecto detectado en una
/// inspección (p.ej. "sustituir extintor caducado"). `priority`/rango 1-3
/// validado en el DTO (class-validator), no con un CHECK — mismo criterio
/// que el resto del schema (p.ej. `discountPct` en Administrator).
model CorrectiveAction {
  id             String                 @id @default(uuid()) @db.Uuid
  inspectionId   String                 @map("inspection_id") @db.Uuid
  title          String                 @db.VarChar(255)
  description    String?
  priority       Int                    @default(2)
  dueDate        DateTime?              @map("due_date") @db.Date
  status         CorrectiveActionStatus @default(abierta)
  assigneeUserId String?                @map("assignee_user_id") @db.Uuid
  supplierId     String?                @map("supplier_id") @db.Uuid
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  inspection RegulatoryInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  assignee   User?                @relation("CorrectiveActionAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  supplier   Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([status, dueDate])
  @@index([inspectionId])
  @@map("corrective_actions")
}

enum RegulatoryInspectionStatus {
  planificada
  citada
  realizada
  desfavorable
  vencida
  exenta
}

enum InspectionOutcome {
  favorable
  desfavorable
}

enum CorrectiveActionStatus {
  abierta
  en_progreso
  cerrada
  vencida
}

// ═══════════════════════════════════════════════════════════════════════
// ── 15. Importación de datos (migración desde Gesfincas/Fynkus/genérico) ─
// ═══════════════════════════════════════════════════════════════════════

enum ImportSourcePlatform {
  GESFINCAS_NET
  GENERIC
}

enum ImportScope {
  current_state
  historical_accounting
}

enum ImportBatchStatus {
  uploading
  validating
  ready
  importing
  completed
  failed
  rolled_back
}

/// Un intento de importación (autoservicio, rol B) — subir/parsear/mapear/
/// validar/confirmar/deshacer para Property/ExternalOwner (sub-fase A del
/// plan de importación); el histórico contable (sub-fase B) llega después.
model ImportBatch {
  id              String               @id @default(uuid()) @db.Uuid
  estateId        String               @map("estate_id") @db.Uuid
  administratorId String               @map("administrator_id") @db.Uuid
  sourcePlatform  ImportSourcePlatform @map("source_platform")
  scope           ImportScope
  status          ImportBatchStatus
  /// Clave de `StorageService` del fichero original subido — se conserva
  /// íntegro aunque el commit todavía no lo use, es la red de seguridad
  /// para poder reprocesar más adelante lo que hoy no se importa (ver plan).
  rawFileKey      String?              @map("raw_file_key") @db.VarChar(500)
  /// Mapeo columna-origen → campo-destino confirmado por el usuario.
  mapping         Json?
  /// Contadores/errores/avisos de la última validación (okRows, errorRows, warningRows...).
  summary         Json?
  createdByUserId String               @map("created_by_user_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz
  completedAt     DateTime?            @map("completed_at") @db.Timestamptz

  estate        Estate           @relation(fields: [estateId], references: [id])
  administrator Administrator    @relation(fields: [administratorId], references: [id])
  createdByUser User             @relation(fields: [createdByUserId], references: [id])
  records       ImportedRecord[]

  @@index([estateId])
  @@map("import_batches")
}

/// Traza genérica "esta fila de dominio vino de este batch" — mismo idioma
/// que `ResourceRead` (una tabla discriminadora en vez de una columna por
/// tabla importable), pensada para poder deshacer una importación completa
/// sin haber tocado el esquema de cada tabla de dominio.
model ImportedRecord {
  id            String   @id @default(uuid()) @db.Uuid
  importBatchId String   @map("import_batch_id") @db.Uuid
  entityType    String   @db.VarChar(60)
  entityId      String   @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  batch ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@unique([importBatchId, entityType, entityId])
  @@index([importBatchId])
  @@map("imported_records")
}

// ═══════════════════════════════════════════════════════════════════════
// ── Asistente IA (Domo/RAG, facturas, conciliación, juntas y resumen semanal) ──
// ═══════════════════════════════════════════════════════════════════════

model AiJob {
  id          String    @id @default(uuid()) @db.Uuid
  estateId    String    @map("estate_id") @db.Uuid
  kind        String    @db.VarChar(40)
  entityId    String    @map("entity_id") @db.Uuid
  dedupeKey   String    @unique @map("dedupe_key") @db.VarChar(240)
  status      String    @default("pending") @db.VarChar(20)
  attempts    Int       @default(0)
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz
  leaseUntil  DateTime? @map("lease_until") @db.Timestamptz
  leaseToken  String?   @map("lease_token") @db.Uuid
  lastError   String?   @map("last_error") @db.VarChar(100)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  estate Estate @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "ai_jobs_estate_fk")

  @@index([status, availableAt])
  @@map("ai_jobs")
}

/// Latido de cada proceso que ejecuta el worker de IA: permite saber si hay alguien que atienda la cola (y qué tipos de
/// job). Es un dato operativo: no guarda nada del expediente.
model AiWorkerHeartbeat {
  instanceId String   @id @map("instance_id") @db.VarChar(120)
  /// Tipos de job que atiende; vacío = todos.
  kinds      String[] @default([])
  startedAt  DateTime @default(now()) @map("started_at") @db.Timestamptz
  beatAt     DateTime @default(now()) @map("beat_at") @db.Timestamptz

  @@index([beatAt])
  @@map("ai_worker_heartbeats")
}

model AiAudit {
  id        String   @id @default(uuid()) @db.Uuid
  estateId  String   @map("estate_id") @db.Uuid
  workflow  String   @db.VarChar(40)
  entityId  String   @map("entity_id") @db.Uuid
  action    String   @db.VarChar(100)
  status    String   @db.VarChar(30)
  details   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "ai_audit_estate_fk")

  @@index([estateId, entityId, createdAt])
  @@map("ai_audit")
}

model AiBatch {
  id                   String    @id @default(uuid()) @db.Uuid
  model                String    @db.VarChar(100)
  status               String    @default("preparing") @db.VarChar(30)
  remoteId             String?   @unique @map("remote_id") @db.VarChar(100)
  inputFileId          String?   @map("input_file_id") @db.VarChar(100)
  outputFileId         String?   @map("output_file_id") @db.VarChar(100)
  errorFileId          String?   @map("error_file_id") @db.VarChar(100)
  /// Cuándo se borraron de OpenAI los ficheros de entrada y salida (ya no hacen falta tras aplicar los resultados).
  remoteFilesDeletedAt DateTime? @map("remote_files_deleted_at") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  requests AiRequest[]

  @@index([status])
  @@map("ai_batches")
}

model AiRequest {
  id              String    @id @default(uuid()) @db.Uuid
  estateId        String    @map("estate_id") @db.Uuid
  kind            String    @db.VarChar(40)
  entityId        String    @map("entity_id") @db.Uuid
  dedupeKey       String    @unique @map("dedupe_key") @db.VarChar(240)
  batchId         String?   @map("batch_id") @db.Uuid
  status          String    @default("pending") @db.VarChar(20)
  attempts        Int       @default(0)
  model           String    @db.VarChar(100)
  payload         Json
  context         Json
  result          Json?
  usage           Json?
  lastError       String?   @map("last_error") @db.VarChar(100)
  nextAttemptAt   DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  completedAt     DateTime? @map("completed_at") @db.Timestamptz
  /// Cuándo se vació `payload` (prompt y adjuntos en base64) por haber terminado la petición.
  payloadPurgedAt DateTime? @map("payload_purged_at") @db.Timestamptz
  /// Cuándo se vació `result` (la salida del modelo) por estar ya materializada en su entidad (factura, resumen, conciliación…).
  resultPurgedAt  DateTime? @map("result_purged_at") @db.Timestamptz

  estate Estate   @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "ai_requests_estate_fk")
  batch  AiBatch? @relation(fields: [batchId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "ai_request_batch_fk")

  @@index([status, nextAttemptAt])
  @@index([batchId])
  @@map("ai_requests")
}

model AiInvoiceDocument {
  id               String   @id @default(uuid()) @db.Uuid
  estateId         String   @map("estate_id") @db.Uuid
  fileName         String   @map("file_name") @db.VarChar(255)
  mimeType         String   @map("mime_type") @db.VarChar(100)
  storageKey       String   @map("storage_key") @db.VarChar(500)
  fileHash         String   @map("file_hash") @db.VarChar(64)
  status           String   @default("pending") @db.VarChar(30)
  extraction       Json?
  invoiceId        String?  @map("invoice_id") @db.Uuid
  uploadedByUserId String   @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "ai_invoice_documents_estate_fk")

  @@unique([estateId, fileHash])
  @@map("ai_invoice_documents")
}

model AiReconciliationSuggestion {
  id               String   @id @default(uuid()) @db.Uuid
  estateId         String   @map("estate_id") @db.Uuid
  bankAccountId    String   @map("bank_account_id") @db.Uuid
  candidateKey     String   @unique @map("candidate_key") @db.VarChar(100)
  entryIds         String[] @map("entry_ids") @db.Uuid
  lineIds          String[] @map("line_ids") @db.Uuid
  invoiceIds       String[] @map("invoice_ids") @db.Uuid
