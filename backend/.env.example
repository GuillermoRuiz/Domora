# Copy this file to .env and adjust values for your environment.

# Used by the "postgres" service in docker-compose.yml.
POSTGRES_USER="domora"
POSTGRES_PASSWORD="domora"
POSTGRES_DB="domora"

# PostgreSQL connection string used by Prisma (the Nest app).
# - Running the app directly on the host (no Docker): host is "127.0.0.1" (on Windows "localhost" resolves to ::1 first and
#   every new connection waits ~2 s before falling back to IPv4).
# - Running via docker-compose: host is the service name "postgres"
#   (already wired that way for the "api" service in docker-compose.yml).
DATABASE_URL="postgresql://domora:domora@127.0.0.1:5432/domora?schema=public"

# Secret used to sign JWT access tokens. MUST be overridden in any
# non-local environment.
JWT_SECRET="dev-secret-change-me"

# Access token lifetime (jsonwebtoken / @nestjs/jwt "expiresIn" format).
JWT_ACCESS_EXPIRES="15m"

# HTTP port the Nest application listens on.
PORT=3000

# Clave de cifrado de IBAN en reposo (AES-256-GCM, Fase 6): 64 caracteres
# hex (32 bytes). Generar con: openssl rand -hex 32
# Si falta, en desarrollo se deriva de JWT_SECRET (NUNCA aceptable en
# producción — la app lo avisa por log).
SEPA_ENC_KEY=""

# Orígenes permitidos por CORS, separados por comas. Default:
# http://localhost:4200 (ng serve). En producción, el dominio del frontend.
CORS_ORIGIN="http://localhost:4200"

# Directorio raíz del almacenamiento de ficheros (documentos, fotos de
# incidencia — Fase 12). Default: ./storage. En Azure Container Apps debe
# apuntar al mount de Azure Files.
STORAGE_DIR=""

# Facturación de la suscripción SaaS (Domora → gestoras) vía Stripe.
# STRIPE_SECRET_KEY: clave secreta de la cuenta de Stripe (sk_test_... en
#   desarrollo, sk_live_... en producción). Developers > API keys.
# STRIPE_WEBHOOK_SECRET: firma del endpoint de webhook (whsec_...).
#   Developers > Webhooks, o `stripe listen` en local.
# STRIPE_PRICE_BASE/STANDARD/PREMIUM: id de Price (price_...) de cada plan,
#   recurrente mensual, per-unit — Products > (plan) > Pricing.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_BASE=""
STRIPE_PRICE_STANDARD=""
STRIPE_PRICE_PREMIUM=""

# Catastro (servicios web libres de la Dirección General del Catastro): alta
# masiva de las unidades de una finca. Sin clave ni registro. Encendido por
# defecto; CATASTRO_ENABLED=false lo desactiva (la app sigue funcionando y
# el alta manual no se ve afectada). CATASTRO_BASE_URL solo hace falta si el
# host cambia (por defecto el histórico ovc.catastro.meh.es).
CATASTRO_ENABLED="true"
CATASTRO_BASE_URL=""

# Ubicación de las fincas para el mapa de «Datos generales». Primero se usa el
# Catastro (CATASTRO_ENABLED); si no hay referencia catastral o falla, se
# geocodifica la dirección con Nominatim (OpenStreetMap): máximo 1 petición
# por segundo y siempre con un User-Agent que identifique la aplicación.
# GEOCODING_ENABLED=false lo desactiva (DEMO_MODE lo fuerza).
GEOCODING_ENABLED="true"
NOMINATIM_USER_AGENT="Domora/1.0 (gestion de comunidades de propietarios)"
# RAG v3 privado: valores secretos resueltos por Key Vault en producción.
RAG_API_URL=
RAG_INTERNAL_KEY=
RAG_INGESTION_API_URL=
RAG_INGESTION_INTERNAL_KEY=
