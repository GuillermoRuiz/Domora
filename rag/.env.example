# ===========================================================================
# Domora RAG - configuracion unica
# Plantilla sin secretos. .env solo development, nunca producción/frontend.
# v3 usa PostgreSQL directo con roles distintos; Supabase solo legacy opt-in.
# ===========================================================================

# --- Credenciales -----------------------------------------------------------
OPENAI_API_KEY=
SUPABASE_URL=
# Supabase > Project Settings > API Keys > secret key (solo backend)
SUPABASE_SERVICE_ROLE_KEY=

# Contrasena de Postgres de Supabase. El RAG NO la usa (va por la API con la
# clave anterior); solo sirve para ejecutar supabase_setup.sql a mano.
# SUPABASE_DB_PASSWORD=

# --- Modelos OpenAI ---------------------------------------------------------
DOMORA_CHAT_MODEL=
DOMORA_RERANK_MODEL=
# Esfuerzo de razonamiento del reranking: none | low | medium | high
DOMORA_RERANK_EFFORT=

# --- Embeddings (si cambias las dimensiones, ajusta vector(512) en el SQL) ---
DOMORA_EMBED_MODEL=
DOMORA_EMBED_DIMENSIONS=

# --- Busqueda y coste -------------------------------------------------------
# Fragmentos candidatos que se recuperan y pasan al reranking
DOMORA_SEARCH_MATCH_COUNT=
# Fragmentos que se envian al modelo en la respuesta final
DOMORA_FINAL_CONTEXT_CHUNKS=
# Caracteres de cada candidato que ve el reranker
DOMORA_RERANK_CHARS=
# Por debajo de esta similitud la pregunta se rechaza sin llamar al modelo
DOMORA_OFF_TOPIC_MIN_SIMILARITY=
DOMORA_MIN_TOP_SEMANTIC_SIMILARITY=
DOMORA_MIN_RERANK_RELEVANCE=

# --- Chat -------------------------------------------------------------------
# Mensajes previos de la conversacion que se usan como contexto
DOMORA_HISTORY_MESSAGES=

# --- Seguridad --------------------------------------------------------------
# Obligatoria >=32 chars, distinta por workload; backend firma contexto request-bound.
DOMORA_RAG_INTERNAL_KEY=

# --- RAG v3: elegir query O ingestion; procesos/identidades separados ---------
DOMORA_ENVIRONMENT=development
DOMORA_RAG_WORKLOAD=query
DOMORA_LLM_PROVIDER=openai
DOMORA_QUERY_DATABASE_URL=
DOMORA_INGESTION_DATABASE_URL=
# Producción: DefaultAzureCredential + Key Vault; los *_SECRET_NAME son referencias, no valores.
AZURE_CLIENT_ID=
DOMORA_KEY_VAULT_URL=
DOMORA_RAG_INTERNAL_KEY_SECRET_NAME=
OPENAI_API_KEY_SECRET_NAME=
DOMORA_QUERY_DATABASE_URL_SECRET_NAME=
DOMORA_INGESTION_DATABASE_URL_SECRET_NAME=
# Entra PostgreSQL (preferido; no password/connection string permanente)
DOMORA_PG_HOST=
DOMORA_PG_DATABASE=
DOMORA_QUERY_PG_USER=
DOMORA_INGESTION_PG_USER=
DOMORA_PG_SSLROOTCERT=
# Solo ingestion
DOMORA_BLOB_ACCOUNT_URL=
DOMORA_CLAMAV_HOST=
DOMORA_CLAMAV_PORT=3310
DOMORA_CLAMAV_CA_FILE=
# Dev local explícito; vacío exige Azure
DOMORA_LOCAL_STORAGE_DIR=
# Azure OpenAI opcional: deployment names en variables DOMORA_*_MODEL
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
DOMORA_MAX_OUTPUT_TOKENS=4000
# Legacy solo operador local consciente; nunca production/test
DOMORA_ALLOW_LEGACY=0
