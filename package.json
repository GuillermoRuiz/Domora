{
  "name": "domora-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "build:demo": "ng build --configuration demo --output-path dist/demo",
    "check:bundle:prod": "node scripts/check-demo-bundle.mjs prod dist/domora-app/browser",
    "check:bundle:demo": "node scripts/check-demo-bundle.mjs demo dist/demo/browser",
    "test:bundle-check": "node --test scripts/check-demo-bundle.test.mjs",
    "test:select-coverage": "node --test scripts/check-select-dropdown.test.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.7",
  "dependencies": {
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@angular/service-worker": "^21.2.25",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.25",
    "@playwright/test": "^1.63.0",
    "@types/leaflet": "^1.9.12",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.1.10"
  }
}
